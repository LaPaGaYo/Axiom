targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts$|src/main/runtime/rpc/methods/axiom/|src/cli/|docs/reference/control-plane\.md$|docs/reference/orca-mapping\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0; ! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)'; git diff --quiet main -- docs/decisions docs/plans docs/ARCHITECTURE.md; git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/rate-limits src/main/startup src/main/daemon src/main/git src/shared/rate-limit-types.ts src/shared/agent-session-usage-limit.ts src/shared/agent-session-failure.ts; test "$(git diff --name-only main -- src/main/runtime | grep -v -E '^src/main/runtime/rpc/methods/axiom/' | wc -l)" -eq 0; git diff --quiet main -- src/main/axiom/execution/attempt-submission.ts src/main/axiom/execution/planner-launcher.ts src/main/axiom/verification src/main/axiom/outbox/effect-outbox.ts src/main/axiom/db/effects-store.ts; grep -q "dispatch:" src/main/axiom/messaging/message-router.ts; grep -q "fixture work failed" tests/e2e/helpers/axiom-test-provider.ts; grep -q "Fixture Worker crashed" tests/e2e/helpers/axiom-test-provider.ts; grep -q "retry_budget_exhausted" src/main/axiom/execution/attempt-settlement.ts; grep -q "runtime_budget_exceeded" src/main/axiom/recovery/attempt-reconciliation.ts; test "$(git grep -n -E "rateLimitType|rate_limit_info" -- src/main/axiom ':(exclude)*.test.ts' ':(exclude)*test-support*' | wc -l)" -eq 0; ! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts src/main/rate-limits; ! git diff main -- src/main/axiom src/shared/axiom-contract | grep -E '^\+.*(DecisionEngine|decision-engine)'; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; grep -rq "attempt.continue" src/shared/axiom-contract; grep -rq "attempt.continue" src/main/axiom/outbox src/main/axiom/control-plane.ts; grep -rq "usage_limit" src/shared/axiom-contract; grep -rq "permission_error" src/shared/axiom-contract; grep -rq "validation_error" src/shared/axiom-contract; grep -rq "transport_error" src/shared/axiom-contract; test "$(git grep -l "ClaudeUsageLimits" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -ge 1; grep -rq "retry_after_interruption" src/main/axiom; grep -rq "superseded_by_task_adjust" src/main/axiom; grep -rq "runtime_restarted" src/main/axiom; grep -rq "backoff" src/main/axiom/scheduler; grep -rq AXIOM_E2E_INTERRUPTION_BACKOFF_MS src/main/axiom; grep -rq AXIOM_E2E_INTERRUPTION_BACKOFF_MS tests/e2e/helpers; test -f tests/e2e/mission-interrupted-continuation.spec.ts; grep -q "usage_limit" tests/e2e/mission-interrupted-continuation.spec.ts; grep -q "blocked.resolved" tests/e2e/mission-interrupted-continuation.spec.ts; grep -q "attempt.continue" tests/e2e/mission-interrupted-continuation.spec.ts; grep -q "rate_limit_event" tests/e2e/helpers/axiom-test-claude-provider.ts; grep -rq "classifies a Claude usage limit from structured events" src/main/axiom; grep -rq "keeps a failed turn without a recognised cause as failed" src/main/axiom; grep -rq "does not consume the retry budget when an Attempt is interrupted" src/main/axiom; grep -rq "waits until the reported reset before admitting the next Attempt" src/main/axiom; grep -rq "blocks the Task for the environment after three consecutive interruptions" src/main/axiom; grep -rq "blocks at once when the interruption cannot be retried" src/main/axiom; grep -rq "settles a headless Attempt lost to a runtime restart as interrupted" src/main/axiom; grep -rq "walks the baseline across an interrupted Attempt" src/main/axiom; grep -rq "retires a pending continuation when a person adjusts the Task" src/main/axiom; grep -rq "ignores a continuation whose Task has moved on" src/main/axiom; grep -q "attempt.continue" docs/reference/control-plane.md; grep -q "usage_limit" docs/reference/control-plane.md; grep -q "attempt.continue" docs/GLOSSARY.md; grep -q "usage_limit" docs/GLOSSARY.md; grep -q "ClaudeUsageLimits" docs/reference/orca-mapping.md; ls .axiom-work/reports/M3-06-2a-*.md
