targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/main/runtime/rpc/dispatcher-axiom-caller-authority.test.ts src/main/runtime/rpc/dispatcher-axiom-session-coverage.test.ts src/main/runtime/rpc/dispatcher-axiom-terminal-authority.test.ts
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/verification/verification-worktree\.ts|src/main/axiom/verification/verification-prepare\.ts|src/main/axiom/verification/verification-checks\.ts|src/main/axiom/verification/verification-recovery\.ts|tests/e2e/mission-verification\.spec\.ts|docs/reference/control-plane\.md|src/main/axiom/[A-Za-z0-9/_-]+\.test(-support)?\.ts|\.axiom-work/reports/M4-1c-[0-9]+\.md)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=MD main | grep -v -E '^(src/main/axiom/verification/verification-worktree\.ts|src/main/axiom/verification/verification-prepare\.ts|src/main/axiom/verification/verification-checks\.ts|src/main/axiom/verification/verification-recovery\.ts|tests/e2e/mission-verification\.spec\.ts|docs/reference/control-plane\.md|src/main/axiom/[A-Za-z0-9/_-]+\.test(-support)?\.ts)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=MD main -- src ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | grep -v -E '^(src/main/axiom/verification/verification-worktree\.ts|src/main/axiom/verification/verification-prepare\.ts|src/main/axiom/verification/verification-checks\.ts|src/main/axiom/verification/verification-recovery\.ts)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=A main -- src ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | wc -l | tr -d ' ')" -eq 0; git diff --quiet main -- src/renderer src/cli src/preload src/main/git src/main/runtime src/shared package.json pnpm-lock.yaml pnpm-workspace.yaml config .github mobile; git diff --quiet main -- tests ':(exclude)tests/e2e/mission-verification.spec.ts'; git diff --quiet main -- AGENTS.md docs/decisions docs/plans docs/ARCHITECTURE.md docs/GLOSSARY.md docs/PROJECT_CONSTITUTION.md docs/STYLEGUIDE.md docs/reference/orca-mapping.md .oxlintrc.json .axiom-work/briefs .axiom-work/scripts .axiom-work/sidecar-union.list; test "$(git diff -w --numstat main -- src/main/axiom/verification/verification-worktree.ts | awk '{s+=$1+$2} END {print s+0}')" -le 56; test "$(git diff -w --numstat main -- src/main/axiom/verification/verification-prepare.ts | awk '{s+=$1+$2} END {print s+0}')" -le 18; test "$(git diff -w --numstat main -- src/main/axiom/verification/verification-checks.ts | awk '{s+=$1+$2} END {print s+0}')" -le 10; test "$(git diff -w --numstat main -- src/main/axiom/verification/verification-recovery.ts | awk '{s+=$1+$2} END {print s+0}')" -le 26; test "$(git diff -w main -- src/main/axiom/verification/verification-worktree.ts | grep -c -E '^-[^-]')" -le 6; test "$(git diff -w main -- src/main/axiom/verification/verification-prepare.ts | grep -c -E '^-[^-]')" -le 8; test "$(git diff -w main -- src/main/axiom/verification/verification-checks.ts | grep -c -E '^-[^-]')" -le 3; test "$(git diff -w main -- src/main/axiom/verification/verification-recovery.ts | grep -c -E '^-[^-]')" -le 10; test "$(git diff -w main -- tests/e2e/mission-verification.spec.ts | grep -c -E '^-[^-]')" -le 2; test "$(git diff -w main -- docs/reference/control-plane.md | grep -c -E '^-[^-]')" -le 8; test "$(git diff main -- tests/e2e/mission-verification.spec.ts | grep -c -E '^\+[^+]')" -le 12; test "$(git diff main -- src/main/axiom/verification/verification-worktree.ts src/main/axiom/verification/verification-prepare.ts src/main/axiom/verification/verification-checks.ts src/main/axiom/verification/verification-recovery.ts | grep -c -E '^\+export ')" -eq 0; test "$(git diff main -- docs/reference/control-plane.md | grep -c -E '^-#')" -eq 0; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src tests | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git diff main -- src | grep -c -E '^\+.*(useFakeTimers|setSystemTime)')" -eq 0; ! git grep -q -E "'branch', *'-[dD]'" -- src/main/axiom ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; ! git grep -q "waitForBackgroundRemoval" -- src/main/axiom/verification ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; ! git grep -q -E "from '\.\./integration/" -- src/main/axiom/verification ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; test "$(grep -c "checkout" src/main/axiom/verification/verification-worktree.ts)" -le 2; git grep -q "export async function pinVerificationCandidate" -- src/main/axiom/verification/verification-worktree.ts; git grep -q "export async function removeVerificationWorktree" -- src/main/axiom/verification/verification-worktree.ts; git grep -q "selector_not_found" -- src/main/axiom/verification/verification-worktree.ts; git grep -q "branchNameOverride" -- src/main/axiom/verification/verification-prepare.ts; git grep -q "verification.requeued" -- src/main/axiom/verification/verification-recovery.ts; git grep -q "axiom/verify/" -- src/main/axiom/verification/verification-recovery.ts; grep -q "M3-02: independent checks reject both broken fixture candidates and verify the unpatched one" tests/e2e/mission-verification.spec.ts; git grep -q "addWorktree" -- src/main/axiom/integration/integration-fixture.test-support.ts; git grep -q "removeWorktree" -- src/main/axiom/integration/integration-fixture.test-support.ts; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -rq "deletes the verification branch with its worktree after a verdict" src/main/axiom; grep -rq "deletes the verification branch when preparation fails after the worktree was made" src/main/axiom; grep -rq "deletes the branch of an interrupted run before it is queued again" src/main/axiom; grep -rq "sweeps an unrecorded verification worktree that the listing names by its full ref" src/main/axiom; grep -rq "removes the worktree even when its branch cannot be put back" src/main/axiom; grep -rq "does not touch the repository above a verification directory that has none of its own" src/main/axiom; git grep -q "GIT_CEILING_DIRECTORIES" -- src/main/axiom/verification/verification-worktree.ts; git grep -q -F "'refs/heads/'" -- src/main/axiom/verification/verification-recovery.ts; git grep -q "integration-fixture.test-support" -- src/main/axiom/verification; git grep -q "refs/heads/axiom/verify" -- src/main/axiom/verification; git grep -q "refs/heads/axiom/verify" -- tests/e2e/mission-verification.spec.ts; grep -q "M4-1c" docs/reference/control-plane.md; ls .axiom-work/reports/M4-1c-*.md
