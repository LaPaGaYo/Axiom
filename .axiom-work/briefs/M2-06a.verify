targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli/specs src/cli/handlers/axiom src/main/startup src/cli/handler-group-manifest.test.ts src/cli/cli-command-name-parity.test.ts src/main/runtime/rpc/errors.test.ts src/main/runtime/rpc/methods/orchestration/messaging src/main/runtime/rpc/methods/orchestration/worker
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/shared/axiom-contract/(message-params|attempt-params|mutations)(\.test)?\.ts|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts|src/main/runtime/rpc/methods/axiom/(attempt|message)\.ts|src/main/runtime/rpc/methods/axiom\.ts|src/main/runtime/rpc/errors\.ts|src/main/runtime/rpc/methods/orchestration/worker/(worker-stop|worker-control|worker-release)\.ts|src/main/runtime/rpc/methods/orchestration/messaging/(ask-methods|message-methods|send-methods)\.ts|src/main/runtime/orchestration/lifecycle-reconciliation\.ts|src/cli/specs/axiom-attempt\.ts|src/cli/handlers/axiom/|src/cli/handler-group-manifest\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/axiom/execution/attempt-authority.ts; test -f src/main/axiom/messaging/message-router.ts; test -f src/shared/axiom-contract/message-params.ts; test "$(git diff --numstat main -- src/main/runtime/rpc/methods/orchestration/worker/worker-stop.ts src/main/runtime/rpc/methods/orchestration/worker/worker-control.ts src/main/runtime/rpc/methods/orchestration/worker/worker-release.ts src/main/runtime/rpc/methods/orchestration/messaging/ask-methods.ts src/main/runtime/rpc/methods/orchestration/messaging/message-methods.ts src/main/runtime/rpc/methods/orchestration/messaging/send-methods.ts | awk "{t+=\$1+\$2} END {print t+0}")" -le 48; test "$(git diff --numstat main -- src/main/runtime/orchestration/lifecycle-reconciliation.ts | awk "{t+=\$1+\$2} END {print t+0}")" -le 4; git diff --quiet main -- src/main/runtime/orchestration/db src/main/runtime/orca-runtime.ts src/renderer src/main/startup; grep -q "assertNotMissionManaged" src/main/runtime/rpc/methods/orchestration/worker/worker-stop.ts && grep -q "assertNotMissionManaged" src/main/runtime/rpc/methods/orchestration/worker/worker-control.ts && grep -q "assertNotMissionManaged" src/main/runtime/rpc/methods/orchestration/worker/worker-release.ts; grep -q "assertNotMissionManaged" src/main/runtime/rpc/methods/orchestration/messaging/ask-methods.ts && grep -q "assertNotMissionManaged" src/main/runtime/rpc/methods/orchestration/messaging/message-methods.ts && grep -q "assertNotMissionManaged" src/main/runtime/rpc/methods/orchestration/messaging/send-methods.ts; grep -q "axiom.attempt.inform" src/shared/axiom-contract/mutations.ts; grep -q "axiom.attempt.request-subtask\|axiom.attempt.requestSubtask" src/shared/axiom-contract/mutations.ts; test "$(grep -c "axiom.attempt.check\|axiom.message.list" src/shared/axiom-contract/mutations.ts)" -eq 0; grep -q "'stale_dispatch'" src/main/runtime/rpc/errors.ts; grep -q "'sender_not_assignee'" src/main/runtime/rpc/errors.ts; grep -q "'unknown_dispatch'" src/main/runtime/rpc/errors.ts; grep -q "'inactive_dispatch'" src/main/runtime/rpc/errors.ts; test "$(git grep -n -E "'(worker_done|merge_ready|dispatch|decision_gate|heartbeat)'" -- src/main/axiom/messaging | grep -v "\.test\.ts" | wc -l)" -eq 0; grep -q "attempt inform" src/cli/handler-group-manifest.ts; grep -q "attempt check" src/cli/handler-group-manifest.ts; pnpm run verify:rpc-params-catalog; test "$(git grep -l "@ts-nocheck" -- src/main/axiom src/shared/axiom-contract | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
