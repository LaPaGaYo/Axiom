 reason and a Mission in another status does not" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "mission.deliver is a desktop only durable mutation" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "mission.deliver fast forwards the target branch and consumes the approval and completes the Mission" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "mission.deliver records mission.delivery_started before the branch write and one approval.consumed event after it" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "a delivered Mission shows its CONSUMED approval with outcome and execution time and lists nothing pending" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "mission.deliver refuses an unknown approval and an approval of another Mission" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "mission.deliver refuses an approval that is not GRANTED and moves no branch" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "mission.deliver refuses while the Mission is paused and delivers after the resume" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "mission.deliver refuses a granted approval that is not the latest one of its Mission" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "mission.deliver on an expired approval requests a new one and then refuses and moves no branch" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "mission.deliver returns the Mission to FINALIZING when the target branch moved or is gone and moves no branch" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "a branch found at the integration head without a write of this call returns the Mission to FINALIZING" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "a return to FINALIZING requests finalization again and the old approval is refused afterwards" -- src/main/axiom src/shared/axiom-contract; git grep -q -F "mission.deliver stops when the target branch is che