targets: src/main/computer src/cli config/scripts src/main/global-fetch-call-site-audit
extra: test "$(git grep -n "Orca Computer Use" -- src config native ':!*.test.*' | wc -l)" -eq 0; test "$(git grep -n -E "Orca allows|ask Orca" -- config/electron-builder.config.cjs config/scripts/build-computer-macos.mjs | wc -l)" -eq 0; git grep -q "com.lapagayo.axiom.computer-use" -- config/scripts/build-computer-macos.mjs; test -d native/computer-use-macos/Sources/OrcaComputerUseMacOS; git grep -q -- "--build-system" -- config/scripts; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
