targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers src/shared/e2e-config src/main/e2e-config src/main/runtime/orchestration/db src/main/automations/precheck-runner
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/main/runtime/rpc/methods/axiom/|src/cli/(specs|handlers)/axiom[A-Za-z0-9/._-]*|src/cli/axiom[A-Za-z0-9._-]*\.ts|src/cli/[A-Za-z0-9/._-]*\.test\.ts|tests/e2e/helpers/|tests/e2e/mission-[A-Za-z0-9._-]+\.spec\.ts|src/shared/e2e-config(\.test)?\.ts|src/main/e2e-config(\.test)?\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|docs/GLOSSARY\.md|\.axiom-work/reports/M3-02-[0-9]+\.md|src/main/automations/precheck-runner(\.test)?\.ts|\.axiom-work/briefs/M3-02\.(md|verify)|\.axiom-work/verifications/M3-02-[0-9]+\.md)' | wc -l)" -eq 0; git diff --quiet main -- src/main/runtime/orchestration src/main/runtime/rpc/methods/orchestration src/main/daemon src/renderer config mobile package.json pnpm-lock.yaml pnpm-workspace.yaml docs/decisions src/main/automations ':(exclude)src/main/automations/precheck-runner.ts' ':(exclude)src/main/automations/precheck-runner.test.ts'; test -f src/shared/axiom-contract/verification-rules.ts; grep -q "retryOnce" src/shared/axiom-contract/verification-rules.ts; grep -q "knownFlaky" src/shared/axiom-contract/verification-rules.ts; grep -q "setupCommands" src/shared/axiom-contract/verification-rules.ts; grep -q "resolveVerificationPlan" src/main/axiom/context-builder/render.ts; test "$(grep -c "verificationRules.commands" src/main/axiom/context-builder/render.ts)" -eq 0; grep -q "VERIFICATION_RUN_TRANSITIONS" src/shared/axiom-contract/lifecycle.ts; grep -q "settleVerificationFailure" src/main/axiom/execution/attempt-settlement.ts; grep -q "candidate_unchanged" src/main/axiom/execution/attempt-submission.ts; git grep -q "candidate_unchanged" -- 'src/main/axiom/execution/*.test.ts'; git grep -q "killLocalPrecheckProcessTree" -- src/main/axiom/verification; git grep -q "redactContext" -- src/main/axiom/verification; git grep -q "environmental" -- src/main/axiom/verification; git grep -q "known_flaky" -- src/main/axiom/verification; git grep -q "verification.passed" -- src/main/axiom/verification; git grep -q "AXIOM_E2E_HOLD_VERIFICATION" -- src/main/axiom tests/e2e/helpers; grep -q "verificationRules" src/shared/axiom-contract/policy-params.ts; git grep -q "verification-rules-file" -- src/cli/specs; grep -q "environmental" docs/GLOSSARY.md; grep -q "candidate_unchanged" docs/reference/control-plane.md; grep -q "known_flaky" docs/reference/control-plane.md; test "$(git grep -l "@ts-nocheck" -- src/main/axiom | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 226; ! grep -n -E "\.connectionId" src/main/axiom/verification/verification-checks.ts src/main/axiom/verification/verification-prepare.ts; git grep -q "isRepoOnCatalogHost" -- src/main/axiom/verification; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l)" -eq 0; grep -q "export function spawnLocalShellCommand" src/main/automations/precheck-runner.ts; git grep -q "spawnLocalShellCommand" -- src/main/axiom/verification; grep -q "safeParse" src/main/axiom/context-builder/render.ts; grep -q "policy_invalid" src/main/axiom/context-builder/render.ts; grep -q "interval and clamped monthly dates: " src/main/axiom/verification/verification-failures.test.ts; grep -q "inclusive and optional boundaries: " src/main/axiom/verification/verification-failures.test.ts; test -f .axiom-work/reports/M3-02-3.md
