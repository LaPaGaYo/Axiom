targets: src/main/axiom src/shared/axiom-contract src/main/codex src/main/claude src/main/runtime/rpc/methods/orchestration/worker src/main/runtime/session-tabs tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/main/codex/codex-mission-session-pins(\.test)?\.ts$|src/main/codex/codex-structured-launch-resolution(\.test)?\.ts$|src/main/codex/codex-structured-child-environment\.test\.ts$|src/main/runtime/|docs/reference/control-plane\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/)';git diff --quiet main -- docs/decisions docs/plans;git diff --quiet main -- src/main/claude src/main/claude-accounts tests/e2e/fixtures/structured-claude-stub.cjs;test -f src/main/axiom/execution/harness-egress-env.ts;grep -q "http://127.0.0.1:9" src/main/axiom/execution/harness-egress-env.ts;grep -q "api.anthropic.com" src/main/axiom/execution/harness-egress-env.ts;grep -q "platform.claude.com" src/main/axiom/execution/harness-egress-env.ts;grep -q "chatgpt.com" src/main/axiom/execution/harness-egress-env.ts;grep -q "inherited-proxy" src/main/axiom/execution/harness-egress-env.ts;grep -q AXIOM_EGRESS_BLACKHOLE_URL src/main/axiom/execution/harness-egress-env.ts;grep -q AXIOM_EGRESS_NO_PROXY src/main/axiom/execution/harness-egress-env.ts;grep -rq harnessEgressEnv src/main/axiom/execution/headless-worker-command.ts src/main/axiom/execution/headless-worker-launch.ts;grep -q resolveHostAgentBaseEnvironment src/main/axiom/execution/headless-worker-launch.ts || grep -q resolveHostAgentBaseEnvironment src/main/axiom/execution/attempt-launcher.ts;grep -rq 'egress' src/main/axiom/execution/worker-launch-combination.ts;grep -rq 'egress' src/main/axiom/execution/claude-worker-combination.ts;grep -q harnessEgressEnv src/main/axiom/execution/planner-claude-launch.ts;grep -rq 'attempt.egress_pinned' src/main/axiom/execution;test -f src/main/codex/codex-mission-session-pins.ts;grep -q codexMissionSessionPins src/main/codex/codex-structured-launch-resolution.ts;test -f src/main/axiom/execution/planner-codex-launch.ts;grep -q codexPlannerLaunchPolicy src/main/axiom/execution/attempt-launcher.ts;grep -q unpinned-terminal src/main/axiom/execution/planner-codex-launch.ts;! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;git diff --quiet main -- src/main/startup;! grep -rn -E "dangerously-skip-permissions|bypassPermissions|--bare|safe-mode" src/main/axiom;! grep -rn -E "setup-token|CLAUDE_CODE_OAUTH_TOKEN|credentials\.json" src/main/axiom;grep -q NO_PROXY tests/e2e/helpers/axiom-test-claude-provider.ts;grep -q NO_PROXY tests/e2e/helpers/axiom-test-provider.ts;grep -q NO_PROXY tests/e2e/mission-headless-worker.spec.ts;grep -q egress_pinned tests/e2e/mission-plan.spec.ts;grep -q -i 'egress' docs/reference/control-plane.md;grep -q AXIOM_EGRESS_BLACKHOLE_URL docs/reference/control-plane.md;grep -q AXIOM_EGRESS_BLACKHOLE_URL docs/GLOSSARY.md;ls .axiom-work/reports/M3-08g-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
