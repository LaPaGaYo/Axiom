targets: src/main/axiom src/shared/axiom-contract src/main/runtime/orchestration/db/runs src/main/runtime/orchestration/db/schema src/main/runtime/orchestration/db.test.ts src/main/runtime/orchestration/orchestration-all-start-versions-migration.test.ts
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/main/runtime/orchestration/db/runs/run-create\.ts|src/main/runtime/orchestration/db/schema/create-axiom-tables-sql\.ts|src/main/runtime/orchestration/db/schema/axiom-tables-migration\.test\.ts|src/shared/axiom-contract/|docs/GLOSSARY.md|docs/reference/orca-mapping.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/axiom/mission-controller/mission-controller.ts; test "$(git grep -nE "\bas (unknown|any)\b" -- src/main/axiom/mission-controller | wc -l)" -eq 0; test "$(git grep -nE "Date\.now\(\)|new Date\(\)" -- src/main/axiom/mission-controller | grep -v -E "\.test\.ts|now\?\?|deps\.now|defaultNow" | wc -l)" -eq 0; test "$(git grep -c -E "^[[:space:]]*//[[:space:]]*@ts-nocheck|^[[:space:]]*(test|it|describe)\.skip\(" -- src/main/axiom | wc -l)" -eq 0; git grep -q "runLifecycleWriteTransaction" -- src/main/runtime/orchestration/db/runs/run-create.ts; test "$(git grep -n "BEGIN IMMEDIATE" -- src/main/runtime/orchestration/db/runs/run-create.ts | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
