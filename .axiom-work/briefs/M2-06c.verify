targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli/specs src/cli/handlers/axiom tests/e2e/helpers/fixture-plan-proposal.unit.test.ts src/renderer/src/components/missions src/renderer/src/lib/axiom-client.test.ts src/renderer/src/lib/missions-view.test.ts
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/agent-factory/|src/main/axiom/.*\.test\.ts|src/main/axiom/.*test-support\.ts|src/shared/axiom-contract/agent-spec(\.test)?\.ts|src/shared/axiom-contract/contract-fixtures\.test-support\.ts|docs/reference/control-plane\.md|docs/GLOSSARY\.md|docs/ARCHITECTURE\.md|docs/PROJECT_CHARTER\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test "$(git diff --name-only main -- src/main/axiom | grep -v -E "\.test\.ts$|test-support\.ts$|^src/main/axiom/agent-factory/" | wc -l)" -eq 0; git diff --quiet main -- src/shared/tui-agent-config.ts src/main/runtime src/renderer src/cli src/shared/rpc-contract; grep -q "'not_certified'" src/shared/axiom-contract/agent-spec.ts; test "$(grep -c "'retired'" src/shared/axiom-contract/agent-spec.ts)" -eq 0; grep -q "endpointProfile" src/shared/axiom-contract/agent-spec.ts; test -f src/main/axiom/agent-factory/certified-providers.ts; grep -q "CERTIFIED_PROVIDER_COMBOS" src/main/axiom/agent-factory/certified-providers.ts; test "$(grep -c "provider: '" src/main/axiom/agent-factory/certified-providers.ts)" -eq 4; grep -q "provider: 'antigravity'" src/main/axiom/agent-factory/certified-providers.ts; grep -q "provider: 'opencode'" src/main/axiom/agent-factory/certified-providers.ts; test "$(grep -c "provider: 'gemini'" src/main/axiom/agent-factory/certified-providers.ts)" -eq 0; grep -q "D57" src/main/axiom/agent-factory/certified-providers.ts; grep -q "not_certified" src/main/axiom/agent-factory/provider-selection.ts; grep -q "endpointProfile: 'subscription'" src/main/axiom/agent-factory/agent-factory.ts; grep -q "not_certified" docs/reference/control-plane.md; grep -q "not_certified" docs/GLOSSARY.md; grep -q "endpointProfile" docs/GLOSSARY.md; grep -q "Antigravity" docs/PROJECT_CHARTER.md; grep -q "Antigravity" docs/ARCHITECTURE.md; test "$(git grep -n "'not_certified'" -- src/main/axiom/agent-factory/agent-factory.test.ts src/main/axiom/agent-factory/provider-selection.test.ts 2>/dev/null | wc -l)" -ge 1; pnpm run verify:rpc-params-catalog; test "$(git grep -l -E "^[[:space:]]*//[[:space:]]*@ts-nocheck" -- src/main/axiom src/shared/axiom-contract | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
