targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli/specs src/cli/handlers/axiom tests/e2e/helpers/fixture-plan-proposal.unit.test.ts
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/agent-factory/|src/main/axiom/.*\.test\.ts|src/main/axiom/.*test-support\.ts|src/shared/axiom-contract/agent-spec(\.test)?\.ts|src/shared/axiom-contract/contract-fixtures\.test-support\.ts|docs/reference/control-plane\.md|docs/GLOSSARY\.md|docs/ARCHITECTURE\.md|docs/PROJECT_CHARTER\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test "$(git diff --name-only main -- src/main/axiom | grep -v -E "\.test\.ts$|test-support\.ts$|^src/main/axiom/agent-factory/" | wc -l)" -eq 0; git diff --quiet main -- src/shared/tui-agent-config.ts src/main/runtime src/renderer src/cli src/shared/rpc-contract; grep -q "'retired'" src/shared/axiom-contract/agent-spec.ts; grep -q "RETIRED_PROVIDERS" src/main/axiom/agent-factory/provider-selection.ts; grep -q "gemini" src/main/axiom/agent-factory/provider-selection.ts; grep -q "2026-06-18" src/main/axiom/agent-factory/provider-selection.ts; grep -q "D53" src/main/axiom/agent-factory/provider-selection.ts; grep -q "retired" docs/reference/control-plane.md; grep -q "retired" docs/GLOSSARY.md; grep -q "Antigravity" docs/PROJECT_CHARTER.md; grep -q "Antigravity" docs/ARCHITECTURE.md; test "$(git grep -n "'retired'" -- src/main/axiom/agent-factory/agent-factory.test.ts src/main/axiom/agent-factory/provider-selection.test.ts 2>/dev/null | wc -l)" -ge 1; pnpm run verify:rpc-params-catalog; test "$(git grep -l "@ts-nocheck" -- src/main/axiom src/shared/axiom-contract | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
