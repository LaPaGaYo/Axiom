targets: src/main/runtime/orchestration/db src/main/daemon/daemon-pid-file-parse.test.ts src/main/daemon/daemon-health.test.ts src/main/codex/codex-usage-limits.test.ts src/main/axiom/execution/codex-rollout-limit.test.ts src/main/axiom/db src/shared/git-remote-error.test.ts src/main/git
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/runtime/orchestration/db/(orchestration-db|lifecycle-transition)\.ts$|src/main/runtime/orchestration/db/lifecycle-transition\.test\.ts$|src/main/daemon/(daemon-pid-file-parse|daemon-stale-kill)(\.test)?\.ts$|src/main/daemon/daemon-health\.test\.ts$|src/main/daemon/daemon-host-relocation\.ts$|src/main/codex/codex-usage-limits(\.test)?\.ts$|src/main/axiom/execution/codex-rollout-limit\.test\.ts$|src/main/axiom/db/[a-z0-9-]+\.test\.ts$|src/shared/git-remote-error(\.test)?\.ts$|docs/decisions/UPSTREAM_SYNC\.md$|\.axiom-work/reports/UPSTREAM-4-[0-9]+\.md$)' | wc -l)" -eq 0; ! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/|mobile/|src/renderer/)'; git diff --quiet main -- src/main/axiom ':(exclude)*.test.ts'; ! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts src/main/rate-limits; ! grep -rn -E "from '(\.\./)+axiom/" src/main/daemon src/main/runtime/orchestration/db src/shared/git-remote-error.ts; test "$(git grep -n -E "getAccountsSnapshot|rateLimitService|refreshRateLimits|providerActivations" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "rateLimitType|rate_limit_info" -- src/main/axiom ':(exclude)*.test.ts' ':(exclude)*test-support*' | wc -l)" -eq 0; grep -rq "reports the failure when SQLite already ended the transaction" src/main/runtime/orchestration/db; grep -rq "reports the failure when SQLite ended the transaction inside a savepoint" src/main/runtime/orchestration/db; grep -rq "keeps temp storage in memory" src/main/runtime/orchestration/db; grep -rq "an Axiom write transaction reports the SQLite error that ended it" src/main/axiom/db; grep -rq "parses a legacy record only as a positive integer" src/main/daemon; grep -rq "removes a malformed pid record %j" src/main/daemon; grep -rq "keeps an empty pid record while its endpoint probe is %s" src/main/daemon; grep -rq "takes the reset from a nearly spent window when the rejection outruns the last report" src/main/codex; grep -rq "takes the reset of a nearly spent window from the last rollout report" src/main/axiom/execution; grep -rq "gives no reset when the last rollout report is below the nearly spent mark" src/main/axiom/execution; grep -rq "redacts credentials that an ANSI escape sequence splits" src/shared; grep -rq "preserves URL structure when redacting %s" src/shared; grep -rq "bounds redaction time when ANSI stripping joins a long scheme-like word" src/shared; grep -q "已应用（UPSTREAM-4）" docs/decisions/UPSTREAM_SYNC.md; pnpm exec vitest run --config config/vitest.config.ts src/main/runtime/orchestration/db/lifecycle-transition.test.ts src/main/daemon/daemon-pid-file-parse.test.ts src/main/codex/codex-usage-limits.test.ts src/shared/git-remote-error.test.ts; ls .axiom-work/reports/UPSTREAM-4-*.md
