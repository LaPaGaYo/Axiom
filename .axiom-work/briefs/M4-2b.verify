targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/main/runtime/rpc/dispatcher-axiom-caller-authority.test.ts src/main/runtime/rpc/dispatcher-axiom-session-coverage.test.ts src/main/runtime/rpc/dispatcher-axiom-terminal-authority.test.ts src/cli/handlers/axiom src/cli/axiom-verification.test.ts
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/scheduler/scheduler\.ts|src/main/axiom/([a-z0-9-]+/)*[a-z0-9-]+\.test(-support)?\.ts|tests/e2e/helpers/axiom-fixture-mission\.ts|docs/reference/control-plane\.md|src/main/axiom/integration/[a-z0-9-]+\.ts|tests/e2e/mission-integration\.spec\.ts|\.axiom-work/reports/M4-2b-[0-9]+\.md)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=MD main | grep -v -E '^(src/main/axiom/scheduler/scheduler\.ts|src/main/axiom/([a-z0-9-]+/)*[a-z0-9-]+\.test(-support)?\.ts|tests/e2e/helpers/axiom-fixture-mission\.ts|docs/reference/control-plane\.md)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only main -- src ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | grep -v -E '^(src/main/axiom/scheduler/scheduler\.ts|src/main/axiom/integration/[a-z0-9-]+\.ts)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=MD main -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=D main -- src tests | wc -l | tr -d ' ')" -eq 0; git diff --quiet main -- src/renderer src/cli src/preload src/main/git src/main/runtime src/shared package.json pnpm-lock.yaml pnpm-workspace.yaml config .github mobile; git diff --quiet main -- tests ':(exclude)tests/e2e/mission-integration.spec.ts' ':(exclude)tests/e2e/helpers/axiom-fixture-mission.ts'; git diff --quiet main -- AGENTS.md docs/decisions docs/plans docs/ARCHITECTURE.md docs/GLOSSARY.md docs/PROJECT_CONSTITUTION.md docs/STYLEGUIDE.md docs/reference/orca-mapping.md .oxlintrc.json .axiom-work/briefs .axiom-work/scripts .axiom-work/sidecar-union.list; git diff --quiet main -- src/main/axiom/control-plane.ts src/main/axiom/control-plane-boot.ts; git grep -q "SCHEMA_VERSION = 46" -- src/main/runtime/orchestration/db/contract-constants.ts; test "$(git diff main -- src/main/axiom/scheduler/scheduler.ts | grep -c -E '^\+[^+]')" -le 2; test "$(git diff -w main -- src/main/axiom/scheduler/scheduler.ts | grep -c -E '^-[^-]')" -le 0; git grep -q "this.missions.recomputeReadiness(missionId)" -- src/main/axiom/scheduler/scheduler.ts; git grep -q "kind: .attempt.dispatch." -- src/main/axiom/scheduler/scheduler.ts; test "$(git diff main -- tests/e2e/helpers/axiom-fixture-mission.ts | grep -c -E '^\+[^+]')" -le 4; test "$(git diff -w main -- tests/e2e/helpers/axiom-fixture-mission.ts | grep -c -E '^-[^-]')" -le 0; grep -q "AXIOM_E2E_HOLD_VERIFICATION" tests/e2e/helpers/axiom-fixture-mission.ts; test "$(git diff -w main -- src/main/axiom ':(exclude)src/main/axiom/integration' | grep -c -E '^-[^-]')" -le 30; test "$(git diff main -- docs/reference/control-plane.md | grep -c -E '^-#')" -eq 0; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src tests | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git diff main -- src tests | grep -c -E '^\+.*(useFakeTimers|setSystemTime)')" -eq 0; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l | tr -d ' ')" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean|branch -D|update-ref -d" -- src/main/axiom/integration src/main/axiom/scheduler | grep -v "\.test\.ts" | wc -l | tr -d ' ')" -eq 0; ! git grep -q "update-ref" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; ! git grep -q "DecisionEngine" -- src/main/axiom/integration src/main/axiom/scheduler; ! git grep -q "setInterval" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; ! git grep -q -F "'verification." -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; ! git grep -q "canBecomeReady" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; test "$(grep -c "VERIFIED" src/main/axiom/mission-controller/task-readiness.ts)" -eq 0; git grep -q "registerIntegrationApply" -- src/main/axiom/integration/integration-apply.ts; git grep -q "abandonIntegration" -- src/main/axiom/integration/integration-request.ts; git grep -q "export function activeCandidateVerification" -- src/main/axiom/verification/verification-candidate.ts; git grep -q "export function shouldHoldVerification" -- src/main/axiom/verification/verification-service.ts; grep -q "### Integration regression" docs/reference/control-plane.md; grep -q "### Integration apply" docs/reference/control-plane.md; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -rq "requests integration once a verified Task has a passing run" src/main/axiom/integration; grep -rq "leaves a verified Task alone without a passing run of its active candidate" src/main/axiom/integration; grep -rq "waits until every upstream Task is integrated" src/main/axiom/integration; grep -rq "requests Tasks in the order they were verified" src/main/axiom/integration; grep -rq "does nothing while the Mission is not executing or integration is held" src/main/axiom/integration; grep -rq "asks again once the earlier request has ended and the Task is back in the queue" src/main/axiom/integration; grep -rq "a Scheduler round requests integration before it admits work" src/main/axiom/integration; grep -rq "one failed request stops neither the other requests nor the round" src/main/axiom/integration; git grep -q "export function requestIntegrations" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q "export function shouldHoldIntegration" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q -F "'integration.requested'" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q -F "'integration_requested'" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q "AXIOM_E2E_HOLD_INTEGRATION" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q "getMainE2EConfig" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q "activeCandidateVerification" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q "getLatestReadModelAudit" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q "listUpstreamEdges" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q "requestIntegrations(this.store" -- src/main/axiom/scheduler/scheduler.ts; test "$(grep -c "requestIntegrations" src/main/axiom/scheduler/scheduler.ts)" -eq 2; grep -q "AXIOM_E2E_HOLD_INTEGRATION" tests/e2e/helpers/axiom-fixture-mission.ts; grep -q "runIntegration" tests/e2e/helpers/axiom-fixture-mission.ts; grep -q "M4-2b: a verified Task is integrated and its dependent Task runs from the new head" tests/e2e/mission-integration.spec.ts; grep -q "runIntegration: true" tests/e2e/mission-integration.spec.ts; grep -q "deterministic-failure" tests/e2e/mission-integration.spec.ts; grep -q "refs/heads/axiom/integrating" tests/e2e/mission-integration.spec.ts; grep -q "refs/axiom/batches/" tests/e2e/mission-integration.spec.ts; grep -q "inspectFixtureMission" tests/e2e/mission-integration.spec.ts; grep -q "expect.poll" tests/e2e/mission-integration.spec.ts; grep -q "### Integration requests" docs/reference/control-plane.md; grep -q "integration.requested" docs/reference/control-plane.md; grep -q "integration_requested" docs/reference/control-plane.md; grep -q "AXIOM_E2E_HOLD_INTEGRATION" docs/reference/control-plane.md; grep -q "runIntegration" docs/reference/control-plane.md; ls .axiom-work/reports/M4-2b-*.md
