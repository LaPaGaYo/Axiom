ry.ts | awk '{s+=$2} END {print s+0}')" -le 3; test "$(git diff --numstat main -- src/main/axiom/mission-controller/mission-controller.ts | awk '{s+=$1} END {print s+0}')" -le 16; test "$(git diff --numstat main -- src/main/axiom/mission-controller/policy-update.ts | awk '{s+=$1} END {print s+0}')" -le 80; test "$(git diff --numstat main -- src/main/axiom/mission-controller ':(exclude)src/main/axiom/mission-controller/mission-controller.ts' ':(exclude)src/main/axiom/mission-controller/policy-update.ts' ':(exclude)src/main/axiom/mission-controller/*.test.ts' ':(exclude)src/main/axiom/mission-controller/*.test-support.ts' | awk '{s+=$1} END {print s+0}')" -le 30; test "$(git diff --numstat main -- src/main/axiom/mission-controller ':(exclude)src/main/axiom/mission-controller/mission-controller.ts' ':(exclude)src/main/axiom/mission-controller/policy-update.ts' ':(exclude)src/main/axiom/mission-controller/*.test.ts' ':(exclude)src/main/axiom/mission-controller/*.test-support.ts' | awk '{s+=$2} END {print s+0}')" -le 0; test "$(git diff --numstat main -- tests/e2e/mission-policy-admission.spec.ts | awk '{s+=$1} END {print s+0}')" -le 50; test "$(git diff --numstat main -- tests/e2e/mission-policy-admission.spec.ts | awk '{s+=$2} END {print s+0}')" -le 0; test "$(grep -c . src/main/axiom/mission-controller/mission-controller.ts)" -le 290; test "$(git grep -c -F "'not_certified'" -- src/main/axiom/agent-factory ':!*.test.ts' | awk -F: '{s+=$2} END {print s+0}')" -eq 1; test "$(git grep -c -F "'disallowed'" -- src/main/axiom/agent-factory ':!*.test.ts' | awk -F: '{s+=$2} END {print s+0}')" -eq 1; test "$(git grep -c -F "'tier_too_low'" -- src/main/axiom/agent-factory ':!*.test.ts' | awk -F: '{s+=$2} END {print s+0}')" -eq 1; ! git grep -q -E "'(not_certified|disallowed|tier_too_low)'" -- src/main/runtime/rpc/methods/axiom src/main/axiom/mission-controller; ! git grep -q -E "from 'node:|Buffer" -- src/shared/axiom-contract/policy-params.ts; test "$(git diff --name-only --dif