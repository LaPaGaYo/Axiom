/axiom/mission-controller/policy-update.ts; git grep -q -F -e "appendAuditEvent" -- src/main/axiom/mission-controller/policy-update.ts; git grep -q -F -e "updatePolicy(" -- src/main/axiom/mission-controller/mission-controller.ts; ! git grep -q -F -e "policyUpdated" -- src; git grep -q -F -e "updatePolicy" -- src/main/runtime/rpc/methods/axiom/policy.ts; git grep -q -F -e "providerEligibility" -- src/main/runtime/rpc/methods/axiom/policy.ts; ! git grep -q -E "upsertPolicy|appendAuditEvent|approval_required|store[.]transaction" -- src/main/runtime/rpc/methods/axiom/policy.ts; test "$(grep -c . src/main/runtime/rpc/methods/axiom/policy.ts)" -le 60; test -f src/main/axiom/mission-controller/policy-update.test.ts; test "$(grep -c -E "^ *(it|test)\(" src/main/axiom/mission-controller/policy-update.test.ts)" -ge 4; git grep -q -F "updates the policy and records the old and the new one in the same write" -- src/main/axiom/mission-controller/policy-update.test.ts; git grep -q -F "refuses a budget key and an unsupported threshold and writes nothing" -- src/main/axiom/mission-controller/policy-update.test.ts; git grep -q -F "refuses a write to a Mission that does not exist" -- src/main/axiom/mission-controller/policy-update.test.ts; git grep -q -F "asks one round with the policy trigger after the write and none after a refusal" -- src/main/axiom/mission-controller/policy-update.test.ts; test -f src/main/axiom/agent-factory/provider-eligibility.test.ts; test "$(grep -c -E "^ *(it|test)\(" src/main/axiom/agent-factory/provider-eligibility.test.ts)" -ge 4; git grep -q -F "answers each provider and slot with what selection filters" -- src/main/axiom/agent-factory/provider-eligibility.test.ts; git grep -q -F "leaves a provider outside a slot not eligible and without a reason" -- src/main/axiom/agent-factory/provider-eligibility.test.ts; git grep -q -F "asks the Planner slot the way the factory selects a Planner" -- src/main/axiom/agent-factory/provider-eligibility.test.ts; git grep