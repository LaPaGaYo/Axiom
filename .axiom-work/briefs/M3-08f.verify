targets: src/main/axiom src/shared/axiom-contract src/main/claude src/main/claude-accounts src/main/runtime/session-tabs src/main/runtime/rpc/methods/orchestration/worker src/cli/handlers/axiom tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/main/claude/|src/main/claude-accounts/|src/main/runtime/|docs/reference/control-plane\.md$|docs/reference/agent-account-homes\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/)';git diff --quiet main -- docs/decisions docs/plans;git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/codex-cli tests/e2e/fixtures/structured-claude-stub.cjs;grep -q -- '--managed-settings' src/main/axiom/execution/headless-worker-command.ts;! grep -rn -E 'claude-managed\.json|managed-settings\.json' src/main/axiom;grep -q strictPluginOnlyCustomization src/main/axiom/execution/claude-launch-policy.ts;grep -q disableAllHooks src/main/axiom/execution/claude-launch-policy.ts;grep -q disableBypassPermissionsMode src/main/axiom/execution/claude-launch-policy.ts;grep -q managedSettings src/main/claude/claude-mission-session-pins.ts;grep -q managedSettings src/main/claude/claude-structured-launch-resolution.ts;grep -q 'refresh: false' src/main/claude/claude-structured-launch-resolution.ts;grep -q 'refresh?:' src/main/claude-accounts/claude-profile-router.ts;grep -q "'builtin'" src/main/axiom/execution/claude-worker-combination.ts;grep -q harness_baseline_stale src/main/axiom/execution/claude-worker-combination.ts;grep -q launchBaseline src/main/axiom/agent-factory/certified-providers.ts;grep -A12 "provider: 'claude'" src/main/axiom/agent-factory/certified-providers.ts | grep -q "status: 'provisional'";! grep -rn -E 'skill_missing|skill_unreadable' src/main/axiom/execution/claude-worker-combination.ts;grep -q surfaces src/main/axiom/execution/claude-worker-combination.ts;! grep -q readCodexAccountHomeAllowlist src/main/axiom/execution/planner-claude-launch.ts;! grep -rn -E "dangerously-skip-permissions|bypassPermissions|--bare|safe-mode" src/main/axiom;! grep -rn -E "setup-token|CLAUDE_CODE_OAUTH_TOKEN|credentials\.json" src/main/axiom;! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;grep -q -- '--managed-settings' tests/e2e/helpers/axiom-test-claude-provider.ts;grep -q -- '--managed-settings' tests/e2e/fixtures/axiom-claude-planner-stub.cjs;grep -q builtin tests/e2e/helpers/axiom-test-claude-provider.ts;grep -q cc-plugin-agents-md tests/e2e/helpers/axiom-test-claude-provider.ts;grep -q managed tests/e2e/mission-plan.spec.ts;grep -q -- 'managed-settings' docs/reference/agent-account-homes.md;grep -q launchBaseline docs/reference/control-plane.md;grep -q launchBaseline docs/GLOSSARY.md;ls .axiom-work/reports/M3-08f-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
