targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli/specs src/cli/handlers/axiom src/main/startup src/cli/handler-group-manifest.test.ts src/cli/cli-command-name-parity.test.ts tests/e2e/helpers/fixture-plan-proposal.unit.test.ts src/main/runtime/rpc/methods/orchestration/worker
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/shared/axiom-contract/(plan-params|mission-params|mutations|mission-objects|plan-proposal|namespace)(\.test)?\.ts|src/shared/axiom-contract/contract-fixtures\.test-support\.ts|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts|src/main/runtime/rpc/methods/axiom/(mission|plan)\.ts|src/main/runtime/rpc/methods/axiom\.ts|src/cli/specs/axiom-(mission|plan)\.ts|src/cli/handlers/axiom/|src/cli/axiom-handler-groups\.ts|tests/e2e/helpers/axiom-test-provider\.ts|tests/e2e/helpers/fixture-plan-proposal(\.unit\.test)?\.ts|tests/e2e/mission-plan\.spec\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|docs/GLOSSARY\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; grep -q "axiom.mission.plan" src/shared/axiom-contract/mutations.ts; grep -q "mission plan" src/cli/axiom-handler-groups.ts; grep -rq "role: 'planner'" src/main/axiom/context-builder; grep -rq "axiom/planner/" src/main/axiom/execution; grep -rq "resolveAttemptSender" src/main/runtime/rpc/methods/axiom/plan.ts; grep -rq "planner_worktree_dirty" src/main/runtime/rpc/methods/axiom src/main/axiom; grep -rq "kind: 'planner'" src/main/runtime/rpc/methods/axiom src/main/axiom; grep -rq "stopLocalWorker" src/main/runtime/rpc/methods/axiom/plan.ts src/main/axiom/execution; grep -q "role: Text.optional()" src/shared/axiom-contract/mission-objects.ts; grep -q "axiom plan propose" tests/e2e/helpers/axiom-test-provider.ts; test -f tests/e2e/mission-plan.spec.ts; grep -q "planner" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "M2-09" docs/reference/control-plane.md; grep -q "planner.proposed" docs/reference/control-plane.md; grep -q "role" docs/GLOSSARY.md; git diff --quiet main -- src/main/runtime/orchestration src/main/runtime/rpc/methods/orchestration src/renderer src/shared/tui-agent-config.ts package.json pnpm-lock.yaml src/shared/axiom-contract/lifecycle.ts src/main/runtime/orchestration/db/schema; test "$(git grep -n -E "insertTaskStage" -- src/main/axiom/execution src/main/runtime/rpc/methods/axiom/mission.ts | grep -v "\.test\.ts" | wc -l)" -eq 0; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c -E "mission-plan\.spec\.ts|axiom-test-provider\.ts|fixture-plan-proposal")" -eq 0; test "$(git grep -l "@ts-nocheck" -- src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
