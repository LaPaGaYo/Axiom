targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/recovery/attempt-reconciliation\.ts|src/main/axiom/recovery/attempt-daemon-loss\.ts|src/main/axiom/(recovery|execution)/[A-Za-z0-9_-]+\.test\.ts|tests/e2e/mission-daemon-lost-continuation\.spec\.ts|tests/e2e/helpers/axiom-fixture-restart(\.unit\.test)?\.ts|tests/e2e/helpers/axiom-fixture-mission\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|docs/GLOSSARY\.md|\.axiom-work/reports/M3-06-2b-4-[0-9]+\.md)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=MD main | grep -v -E '^(src/main/axiom/recovery/attempt-reconciliation\.ts|src/main/axiom/recovery/attempt-daemon-loss\.ts|src/main/axiom/recovery/daemon-loss\.test\.ts|tests/e2e/mission-daemon-lost-continuation\.spec\.ts|tests/e2e/helpers/axiom-fixture-restart(\.unit\.test)?\.ts|tests/e2e/helpers/axiom-fixture-mission\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|docs/GLOSSARY\.md)$' | wc -l | tr -d ' ')" -eq 0; git diff --quiet main -- src/renderer src/shared src/cli src/preload src/main/runtime src/main/startup src/main/daemon src/main/orcad package.json pnpm-lock.yaml pnpm-workspace.yaml config .github mobile; git diff --quiet main -- src/main/axiom/recovery ':(exclude)src/main/axiom/recovery/attempt-reconciliation.ts' ':(exclude)src/main/axiom/recovery/attempt-daemon-loss.ts' ':(exclude)src/main/axiom/recovery/*.test.ts'; git diff --quiet main -- src/main/axiom ':(exclude)src/main/axiom/recovery' ':(exclude)src/main/axiom/execution/*.test.ts'; git diff --quiet main -- tests ':(exclude)tests/e2e/mission-daemon-lost-continuation.spec.ts' ':(exclude)tests/e2e/helpers/axiom-fixture-restart.ts' ':(exclude)tests/e2e/helpers/axiom-fixture-restart.unit.test.ts' ':(exclude)tests/e2e/helpers/axiom-fixture-mission.ts'; git grep -q "AXIOM_E2E_HOLD_EXIT_SUBMISSION" -- tests/e2e/helpers/axiom-fixture-mission.ts; grep -q "keeps the profile daemons .or a default fixture restart" tests/e2e/helpers/axiom-fixture-restart.unit.test.ts; git diff --quiet main -- AGENTS.md docs/decisions docs/plans docs/ARCHITECTURE.md docs/PROJECT_CONSTITUTION.md docs/STYLEGUIDE.md .axiom-work/briefs .axiom-work/scripts .axiom-work/sidecar-union.list; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src tests | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git diff main -- src tests | grep -c -E '^\+.*(useFakeTimers|setSystemTime)')" -eq 0; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; git grep -q "export function isRestartTerminalMissing" -- src/main/axiom/recovery/attempt-daemon-loss.ts; git grep -q "export function settleRecoveryDaemonLoss" -- src/main/axiom/recovery/attempt-daemon-loss.ts; grep -q "retries an uncertain .* marker read without capture or settlement" src/main/axiom/recovery/daemon-loss.test.ts; grep -q "settles a headless Attempt lost with its daemon on restart as an interruption" src/main/axiom/recovery/daemon-loss.test.ts; grep -q "M3-06-2b-3: an Attempt lost with its daemon continues from preserved work after restart" tests/e2e/mission-daemon-lost-continuation.spec.ts; test "$(grep -c . src/main/axiom/recovery/attempt-reconciliation.ts)" -le 295; test "$(grep -c . tests/e2e/mission-daemon-lost-continuation.spec.ts)" -le 780; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -rq "settles an Attempt lost with its daemon as an interruption even when it left a marker of its ending" src/main/axiom/recovery src/main/axiom/execution; grep -rq "keeps the marker of a finished Attempt lost with its daemon as evidence only" src/main/axiom/recovery src/main/axiom/execution; grep -rq "writes the lost-daemon audit unchanged when the marker holds no integer" src/main/axiom/recovery src/main/axiom/execution; grep -rq "continues with a fresh session after an Attempt lost with its daemon left a marker" src/main/axiom/recovery src/main/axiom/execution; grep -q "M3-06-2b-4: an Attempt lost with its daemon that left a marker continues from preserved work" tests/e2e/mission-daemon-lost-continuation.spec.ts; grep -q "exitMarker" tests/e2e/mission-daemon-lost-continuation.spec.ts; ! grep -rq "does not treat an Attempt that left an .* marker as lost with its daemon" src/main/axiom; grep -q "exitMarker" docs/reference/control-plane.md; grep -q "exitMarker" docs/GLOSSARY.md; ! grep -q "b 保持计数且不保全" docs/reference/control-plane.md; ! grep -q "无可接受整数 exit-code" docs/reference/control-plane.md; ! grep -q "且 Attempt 目录没有退出路径接受的整数 exit-code" docs/reference/control-plane.md; ! grep -q "且无可接受 e.it marker" docs/reference/control-plane.md; ! grep -q "terminal_missing 无 e.it marker 情形保全" docs/reference/control-plane.md; ! grep -q "退出路径拒绝的整数 e.it marker" docs/reference/control-plane.md; ! grep -q "有整数 e.it marker 的 abandoned" docs/reference/control-plane.md; ! grep -q "且没有可接受整数 exit-code" docs/reference/orca-mapping.md; ! grep -q "且其 exit-code 没有退出路径接受的整数时" docs/GLOSSARY.md; ! grep -q "已有整数 e.it marker" docs/GLOSSARY.md; ls .axiom-work/reports/M3-06-2b-4-*.md
