targets: src/main/axiom src/shared/axiom-contract src/main/claude src/cli tests/e2e/helpers tests/e2e/fixtures
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/main/claude/|src/cli/|docs/reference/control-plane\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/)';git diff --quiet main -- docs/decisions docs/plans;git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/claude-accounts src/main/runtime src/main/startup;grep -q "'attempt', 'mcp'" src/cli/specs/axiom-attempt.ts;grep -q "attempt mcp" src/cli/axiom-handler-groups.ts;test -f src/cli/handlers/axiom/attempt-mcp.ts;grep -q StdioServerTransport src/cli/handlers/axiom/attempt-mcp.ts;grep -q plan_propose src/cli/handlers/axiom/attempt-mcp.ts;grep -q "axiom.plan.propose" src/cli/handlers/axiom/attempt-mcp.ts;! grep -q printResult src/cli/handlers/axiom/attempt-mcp.ts;grep -q mcp__axiom__plan_propose src/main/axiom/execution/planner-claude-launch.ts;! grep -q "axiom plan propose" src/main/axiom/execution/planner-claude-launch.ts;grep -q strictMcpConfig src/main/axiom/execution/planner-claude-launch.ts;grep -q cli_launcher_unavailable src/main/axiom/execution/planner-claude-launch.ts;grep -q mcpServers src/main/claude/claude-mission-session-pins.ts;grep -q onTurnSettled src/main/claude/claude-mission-session-pins.ts;grep -q input src/main/claude/claude-mission-session-pins.ts;grep -q strictMcpConfig src/main/claude/claude-structured-launch-resolution.ts;grep -q "'mcpServers'" src/main/claude/claude-structured-launch-resolution.ts;grep -E -q 'denyPermission\(registration\.toolName, ' src/main/claude/claude-prompt-registry.ts;grep -q plan_propose src/main/axiom/context-builder/planner-render.ts;! grep -rn AXIOM_PLAN_JSON src/main/axiom tests/e2e/fixtures/axiom-claude-planner-stub.cjs;grep -q "axiom plan propose" src/main/axiom/context-builder/planner-render.ts;grep -q onTurnSettled src/main/axiom/execution/planner-claude-launch.ts;grep -rq turn_settled src/main/axiom/execution;grep -q PLANNER_RUNTIME_BUDGET_MINUTES src/main/axiom/recovery/planner-reconciliation.ts;grep -q AXIOM_E2E_PLANNER_NO_PROPOSAL tests/e2e/fixtures/axiom-claude-planner-stub.cjs;grep -q "tools/call" tests/e2e/fixtures/axiom-claude-planner-stub.cjs;grep -q "tools/list" tests/e2e/fixtures/axiom-claude-planner-stub.cjs;! grep -q "/bin/sh" tests/e2e/fixtures/axiom-claude-planner-stub.cjs;grep -q mcp__axiom__plan_propose tests/e2e/mission-plan.spec.ts;grep -q no_proposal tests/e2e/mission-plan.spec.ts;grep -q strictMcpConfig tests/e2e/mission-plan.spec.ts;grep -q turn_settled docs/reference/control-plane.md;grep -q "attempt mcp" docs/reference/control-plane.md;grep -q plan_propose docs/GLOSSARY.md;! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;ls .axiom-work/reports/M3-08h-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
