targets: src/main/axiom src/shared/axiom-contract src/main/claude tests/e2e/helpers tests/e2e/fixtures
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/main/claude/|docs/reference/control-plane\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/)';git diff --quiet main -- docs/decisions docs/plans;git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/claude-accounts src/main/runtime src/main/startup;grep -q 'proposal.json' src/main/axiom/context-builder/planner-render.ts;grep -q attemptDir src/main/axiom/context-builder/planner-render.ts;grep -q plannerProposalFilePath src/main/axiom/context-builder/planner-render.ts;! grep -rn AXIOM_PLAN_JSON src/main/axiom tests/e2e/fixtures/axiom-claude-planner-stub.cjs;grep -q 'Edit(//' src/main/axiom/execution/planner-claude-launch.ts;! grep -E "'(Write|Edit)'" src/main/axiom/execution/planner-claude-launch.ts;! grep -q -- '--add-dir' src/main/axiom/execution/planner-claude-launch.ts;grep -q onTurnSettled src/main/claude/claude-mission-session-pins.ts;grep -q onTurnSettled src/main/axiom/execution/planner-claude-launch.ts;grep -rq turn_settled src/main/axiom/execution;grep -rq no_proposal src/main/axiom/execution/planner-claude-launch.ts;grep -E -q 'denyPermission\(registration\.toolName, ' src/main/claude/claude-prompt-registry.ts;grep -q 'input' src/main/claude/claude-mission-session-pins.ts;grep -q AXIOM_E2E_PLANNER_NO_PROPOSAL tests/e2e/fixtures/axiom-claude-planner-stub.cjs;grep -q 'proposal.json' tests/e2e/fixtures/axiom-claude-planner-stub.cjs;grep -q no_proposal tests/e2e/mission-plan.spec.ts;grep -q 'proposal.json' tests/e2e/mission-plan.spec.ts;grep -q turn_settled docs/reference/control-plane.md;grep -q 'proposal.json' docs/GLOSSARY.md;! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;ls .axiom-work/reports/M3-08h-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
