targets: src/main/axiom src/shared/axiom-contract src/main/runtime/orchestration/db/schema
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/db/|src/shared/axiom-contract/mission-objects(\.test)?\.ts|docs/reference/orca-mapping.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/axiom/db/axiom-store.ts; test "$(git grep -nE "\bas (unknown|any|[A-Z][A-Za-z]*(Row|Record)\b)" -- src/main/axiom/db | wc -l)" -eq 0; test "$(git grep -n "SELECT \*" -- src/main/axiom/db | wc -l)" -eq 0; test "$(git grep -c -E "^[[:space:]]*//[[:space:]]*@ts-nocheck|^[[:space:]]*(test|it|describe)\.skip\(" -- src/main/axiom | wc -l)" -eq 0; git diff --quiet main -- src/main/runtime; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
