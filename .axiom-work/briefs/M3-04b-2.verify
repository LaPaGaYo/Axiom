targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli src/renderer/src/components/missions tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts$|src/main/runtime/rpc/methods/axiom/|src/cli/|src/renderer/src/components/missions/PlanReviewPanel(\.test)?\.tsx$|docs/reference/control-plane\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/src/i18n/)';git diff --quiet main -- docs/decisions docs/plans;git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/startup src/main/daemon src/main/git src/main/runtime/orchestration;test "$(git diff --name-only main -- src/main/runtime | grep -v '^src/main/runtime/rpc/methods/axiom/' | wc -l)" -eq 0;test "$(git diff --name-only main -- src/renderer | grep -v -E '^src/renderer/src/components/missions/PlanReviewPanel(\.test)?\.tsx$' | wc -l)" -eq 0;test -f src/shared/axiom-contract/acceptance.ts;grep -q resolveAcceptance src/shared/axiom-contract/acceptance.ts;grep -q acceptanceCommands src/shared/axiom-contract/acceptance.ts;grep -q "'artifact'" src/shared/axiom-contract/mission-objects.ts;grep -q "'human'" src/shared/axiom-contract/mission-objects.ts;grep -q "'command'" src/shared/axiom-contract/mission-objects.ts;grep -q required_evidence_retired src/shared/axiom-contract/plan-proposal.ts;grep -q criterion_shape src/shared/axiom-contract/plan-proposal.ts;grep -q resolveAcceptance src/main/axiom/mission-controller/plan-materialization.ts;grep -q resolveAcceptance src/main/axiom/messaging/subtask-checks.ts;! grep -q requiredEvidence src/shared/axiom-contract/message-params.ts;grep -q criteria src/shared/axiom-contract/verification-rules.ts;test -f src/shared/axiom-contract/verification-acceptance.ts;grep -q acceptance_human src/main/axiom/verification/verification-verdict.ts;grep -rq acceptance_human src/main/axiom/verification;grep -rq "persisting since" src/main/axiom/context-builder;! grep -q "Not yet demonstrated" src/main/axiom/context-builder/previous-attempt.ts;! grep -q "requiredEvidence entries are exact shell commands" src/main/axiom/context-builder/planner-render.ts;grep -qi retired src/main/axiom/context-builder/planner-render.ts;! grep -q "requiredEvidence: \[" src/main/axiom/context-builder/planner-render.ts;! grep -q "{criterion}</li>" src/renderer/src/components/missions/PlanReviewPanel.tsx;grep -q "acceptance-artifact" src/cli/specs/axiom-attempt.ts;grep -q "acceptance-artifact" src/cli/handlers/axiom/attempt.ts;! grep -q requiredEvidence tests/e2e/helpers/fixture-plan-proposal.ts;! grep -q requiredEvidence tests/e2e/helpers/axiom-fixture-mission.ts;grep -q AXIOM_E2E_PLANNER_LEGACY_EVIDENCE tests/e2e/fixtures/axiom-claude-planner-stub.cjs;grep -q required_evidence_retired tests/e2e/mission-plan.spec.ts;grep -q acceptance_human tests/e2e/mission-verification.spec.ts;grep -q "persisting since" tests/e2e/mission-fix-loop.spec.ts;grep -q acceptance_human docs/reference/control-plane.md;grep -q resolveAcceptance docs/reference/control-plane.md;grep -q "persisting since" docs/reference/control-plane.md;grep -q required_evidence_retired docs/reference/control-plane.md;grep -q acceptance_human docs/GLOSSARY.md;grep -q AcceptanceCriterion docs/GLOSSARY.md;pnpm run verify:rpc-params-catalog;! git diff main -- src/main/axiom | grep -E '^\+.*(DecisionEngine|decision-engine)';! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;ls .axiom-work/reports/M3-04b-2-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
