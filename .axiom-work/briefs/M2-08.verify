targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/main/runtime/rpc/methods/orchestration src/main/runtime/orchestration src/cli/handlers/axiom src/cli/specs src/main/startup src/cli/handler-group-manifest.test.ts src/cli/cli-command-name-parity.test.ts
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/main/runtime/rpc/methods/orchestration/worker/(worker-stop|worker-release|local-worker-stop|local-worker-release)(\.test)?\.ts|src/main/runtime/orchestration/db/schema/create-axiom-tables-sql\.ts|src/shared/axiom-contract/mission-params(\.test)?\.ts|src/main/runtime/rpc/methods/axiom/mission\.ts|src/cli/handlers/axiom/mission(\.test)?\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|docs/ARCHITECTURE\.md|docs/GLOSSARY\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/runtime/rpc/methods/orchestration/worker/local-worker-stop.ts; test -f src/main/axiom/execution/attempt-settlement.ts; grep -q "stopLocalWorker" src/main/runtime/rpc/methods/orchestration/worker/worker-stop.ts; grep -q "assertNotMissionManaged" src/main/runtime/rpc/methods/orchestration/worker/worker-stop.ts; grep -q "assertNotMissionManaged" src/main/runtime/rpc/methods/orchestration/worker/worker-release.ts; test "$(grep -c "no_attempts_in_m1" src/main/axiom/recovery/recovery-service.ts)" -eq 0; grep -q "reconcileAttempts" src/main/axiom/recovery/recovery-service.ts; grep -rq "abandonWorkerDispatch" src/main/axiom/recovery; grep -rq "'liveness'" src/main/axiom/recovery; grep -rq "unverifiableToleranceMinutes" src/main/axiom/recovery; grep -rq "settleAttemptWithoutSubmission" src/main/axiom/execution/attempt-launcher.ts; grep -q "retryOf" src/main/axiom/execution/attempt-launcher.ts; grep -q "idx_audit_events_object" src/main/runtime/orchestration/db/schema/create-axiom-tables-sql.ts; grep -q "hasMessageAudit" src/main/axiom/mission-controller/run-mailbox-consumer.ts; grep -q "MAX_CONSECUTIVE_BATCH_FAILURES" src/main/axiom/mission-controller/run-mailbox-consumer.ts; grep -q "retry_exhausted" src/main/axiom/mission-controller/run-mailbox-consumer.ts; grep -q "onEscalation" src/main/axiom/mission-controller/run-mailbox-consumer.ts; grep -q "MissionCancelResponseSchema" src/shared/axiom-contract/mission-params.ts; grep -q "reconcileAttempts" src/main/runtime/rpc/methods/axiom/mission.ts; grep -q "reconcileAttempts" src/main/axiom/control-plane-boot.ts; grep -q "ATTEMPT_RECONCILE_INTERVAL_MS" src/main/axiom/recovery/recovery-service.ts; git diff --quiet main -- src/shared/axiom-contract/lifecycle.ts src/shared/rpc-contract src/renderer src/shared/tui-agent-config.ts package.json pnpm-lock.yaml src/main/runtime/orchestration/db/worker-dispatch src/main/runtime/orchestration/db/worker-terminal src/main/runtime/orchestration/db/dispatch-context; git diff --quiet main -- src/main/runtime/rpc/methods/orchestration/worker/worker-stop-capability.test.ts src/main/runtime/rpc/methods/orchestration/worker/worker-stop-exit-race.test.ts src/main/runtime/rpc/methods/orchestration/worker/worker-stop-liveness-verdict.test.ts; grep -q "M2-08" docs/reference/control-plane.md; grep -q "attempt.abandoned" docs/reference/control-plane.md; test "$(grep -c "no_attempts_in_m1" docs/reference/control-plane.md)" -eq 0; grep -q "M2-08" docs/ARCHITECTURE.md; grep -q "local-worker-stop" docs/reference/orca-mapping.md; test "$(git grep -n -E "reset --hard|checkout --|git clean" -- src/main/axiom | grep -v "\.test\.ts" | wc -l)" -eq 0; pnpm run verify:rpc-params-catalog; test "$(git grep -l -E "^[[:space:]]*//[[:space:]]*@ts-nocheck" -- src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/orchestration/worker | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
