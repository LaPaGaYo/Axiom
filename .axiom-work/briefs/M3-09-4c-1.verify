targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/main/runtime/rpc/dispatcher-axiom-caller-authority.test.ts src/main/runtime/rpc/dispatcher-axiom-session-coverage.test.ts src/main/runtime/rpc/dispatcher-axiom-terminal-authority.test.ts
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/runtime/rpc/methods/axiom/policy\.ts|src/main/axiom/mission-controller/mission-controller\.ts|src/main/axiom/scheduler/scheduler\.ts|src/main/axiom/[A-Za-z0-9/_-]+\.test(-support)?\.ts|tests/e2e/mission-policy-admission\.spec\.ts|docs/reference/control-plane\.md|\.axiom-work/reports/M3-09-4c-1-[0-9]+\.md)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=MD main | grep -v -E '^(src/main/runtime/rpc/methods/axiom/policy\.ts|src/main/axiom/mission-controller/mission-controller\.ts|src/main/axiom/scheduler/scheduler\.ts|src/main/axiom/scheduler/scheduler\.test\.ts|docs/reference/control-plane\.md)$' | wc -l | tr -d ' ')" -eq 0; git diff --quiet main -- src/renderer src/shared src/cli src/preload package.json pnpm-lock.yaml pnpm-workspace.yaml config .github mobile; git diff --quiet main -- src/main/runtime ':(exclude)src/main/runtime/rpc/methods/axiom/policy.ts'; git diff --quiet main -- tests ':(exclude)tests/e2e/mission-policy-admission.spec.ts'; git diff --quiet main -- AGENTS.md docs/decisions docs/plans docs/ARCHITECTURE.md docs/GLOSSARY.md docs/PROJECT_CONSTITUTION.md docs/STYLEGUIDE.md .axiom-work/briefs .axiom-work/scripts .axiom-work/sidecar-union.list; test "$(git diff -w --numstat main -- src/main/axiom/scheduler/scheduler.ts | awk '{s+=$1+$2} END {print s+0}')" -le 12; test "$(git diff -w --numstat main -- src/main/axiom/mission-controller/mission-controller.ts | awk '{s+=$1+$2} END {print s+0}')" -le 8; test "$(git diff -w --numstat main -- src/main/runtime/rpc/methods/axiom/policy.ts | awk '{s+=$1+$2} END {print s+0}')" -le 10; test "$(git diff main -- src/main/axiom/scheduler/scheduler.ts src/main/axiom/mission-controller/mission-controller.ts src/main/runtime/rpc/methods/axiom/policy.ts | grep -E '^\+export ' | grep -c -v 'export type ScheduleTrigger = ')" -eq 0; test "$(git diff main -- src/main/axiom/scheduler/scheduler.ts src/main/axiom/mission-controller/mission-controller.ts src/main/runtime/rpc/methods/axiom/policy.ts | grep -c -E '^\+import ')" -eq 0; ! git grep -q "scheduleRound" -- src/main/runtime/rpc/methods/axiom/policy.ts; test "$(git diff --numstat main -- src/main/axiom/scheduler/scheduler.test.ts | awk '{s+=$2} END {print s+0}')" -eq 0; grep -q "orders the 12-Task fixture by longest downstream chain then id and launches after commit" src/main/axiom/scheduler/scheduler.test.ts; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git diff main -- tests | grep -c -E '^\+.*(@ts-nocheck|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git diff main -- tests | grep -c -E '^\+.*\.skip\(')" -le 1; test "$(git diff main -- src tests | grep -c -E '^\+.*(useFakeTimers|setSystemTime|waitForTimeout)')" -eq 0; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; git grep -q "private scheduleAfterWrite" -- src/main/axiom/mission-controller/mission-controller.ts; git grep -q "approval_required" -- src/main/runtime/rpc/methods/axiom/policy.ts; git grep -q "policy.updated" -- src/main/runtime/rpc/methods/axiom/policy.ts; git grep -q "Worker provider changed during admission" -- src/main/axiom/agent-factory/agent-factory.ts; grep -q "rolls back policy changes if the audit cannot be written" src/main/axiom/rpc-policy.test.ts; grep -q "wakes admission after answering even when the Task already is READY" src/main/axiom/rpc-report-items.test.ts; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -rq "requests one admission round after a policy update commits" src/main/axiom; grep -rq "requests no admission round when a policy update is refused or rolled back" src/main/axiom; grep -rq "looks at a waiting Task again in the round a policy update requests" src/main/axiom; grep -rq "runs the round of a trigger that arrived while a round was failing" src/main/axiom; grep -rq "still rejects a failing round when no trigger arrived meanwhile" src/main/axiom; grep -rq "admits under the new routing when it changes while a round builds the contracts" src/main/axiom; grep -q "M3-09-4c-1: a policy update admits the Task it unblocks without another event" tests/e2e/mission-policy-admission.spec.ts; grep -q "task.admission_refused" tests/e2e/mission-policy-admission.spec.ts; grep -q "scheduler.round" tests/e2e/mission-policy-admission.spec.ts; git grep -q "'policy'" -- src/main/axiom/scheduler/scheduler.ts; git grep -q "'policy')" -- src/main/axiom/mission-controller/mission-controller.ts; git grep -q "missions\." -- src/main/runtime/rpc/methods/axiom/policy.ts; grep -q "M3-09-4c-1" docs/reference/control-plane.md; ls .axiom-work/reports/M3-09-4c-1-*.md
