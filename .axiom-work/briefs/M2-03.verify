targets: src/main/axiom src/shared/axiom-contract src/main/runtime/orchestration/db/schema src/main/runtime/orchestration/orchestration-version-skew-migration.test.ts src/main/runtime/rpc/methods/axiom src/cli/specs src/cli/handlers/axiom src/main/startup src/cli/handler-group-manifest.test.ts src/cli/cli-command-name-parity.test.ts src/main/runtime/rpc/errors.test.ts
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/shared/axiom-contract/(agent-spec|policy-params|mission-objects|mutations|contract-fixtures\.test-support)(\.test)?\.ts|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts|src/main/runtime/orchestration/db/schema/(create-axiom-tables-sql|migrate-v44|migrate|axiom-tables-migration\.test)\.ts|src/main/runtime/orchestration/db/contract-constants\.ts|src/main/runtime/orchestration/orchestration-schema-version-skew\.ts|src/main/runtime/orchestration/orchestration-version-skew-migration\.test\.ts|src/main/runtime/rpc/errors\.ts|src/main/runtime/rpc/methods/axiom/policy\.ts|src/main/runtime/rpc/methods/axiom\.ts|src/cli/specs/axiom-mission\.ts|src/cli/handlers/axiom/|src/cli/handler-group-manifest\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/axiom/agent-factory/agent-factory.ts; test -f src/main/axiom/decision-engine/rules-engine.ts; test -f src/main/axiom/decision-engine/decision-engine.ts; test -f src/shared/axiom-contract/agent-spec.ts; test -f src/shared/axiom-contract/policy-params.ts; test -f src/main/runtime/orchestration/db/schema/migrate-v44.ts; grep -q "SCHEMA_VERSION = 44" src/main/runtime/orchestration/db/contract-constants.ts; grep -q "routing TEXT NOT NULL DEFAULT" src/main/runtime/orchestration/db/schema/create-axiom-tables-sql.ts; grep -q "spec TEXT NOT NULL DEFAULT" src/main/runtime/orchestration/db/schema/create-axiom-tables-sql.ts; test "$(grep -c "version: 44" src/main/runtime/orchestration/orchestration-schema-version-skew.ts)" -eq 2; test "$(git diff main -- src/main/runtime/orchestration/db/schema/create-axiom-tables-sql.ts | grep -E "^[-+].*CHECK" | wc -l)" -eq 0; git diff --quiet main -- src/main/runtime/orchestration/orchestration-db.ts src/main/runtime/rpc/methods/orchestration src/main/runtime/orchestration/db/schema/migrate-v42.ts src/main/runtime/orchestration/db/schema/migrate-v43.ts; grep -q "axiom.policy.update" src/shared/axiom-contract/mutations.ts; grep -q "'approval_required'" src/main/runtime/rpc/errors.ts; grep -q "'no_eligible_provider'" src/main/runtime/rpc/errors.ts; test "$(git diff --numstat main -- src/main/runtime/rpc/errors.ts src/cli/handler-group-manifest.ts | awk "{t+=\$1+\$2} END {print t+0}")" -le 12; grep -rq "claude-agent-teams" src/main/axiom/agent-factory; grep -q "mission policy show" src/cli/axiom-handler-groups.ts; pnpm run verify:rpc-params-catalog; test "$(git grep -l "@ts-nocheck" -- src/main/axiom src/shared/axiom-contract | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
