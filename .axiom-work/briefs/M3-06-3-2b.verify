p -n -i -E "update supervision_settings|replace into supervision_settings|delete from supervision_settings" -- src/main ':(exclude)*.test.ts' ':(exclude)src/main/runtime/orchestration/db/schema/create-axiom-supervision-sql.ts' | wc -l)" -eq 0; test "$(git diff main -- src/main/axiom ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | grep -E '^\+' | grep -c -E 'setInterval|setTimeout')" -eq 0; test "$(git grep -n -E "DecisionEngine|decision-engine" -- src/main/axiom/recovery src/main/axiom/supervision ':(exclude)*.test.ts' | wc -l)" -eq 0; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; grep -q "supervision_proposals" src/main/runtime/orchestration/db/schema/create-axiom-supervision-sql.ts; grep -q "supervision_proposals" src/main/runtime/orchestration/db/schema/axiom-tables-migration.test.ts; grep -q "adds the supervision proposals table to an existing v46 database" src/main/runtime/orchestration/db/schema/axiom-tables-migration.test.ts; grep -q "'supervision_proposals'" src/shared/wsl-move/wsl-move-storage-dispositions.ts; grep -q "'axiom.supervision.resolve': 'desktop_only'" src/main/axiom/authority/caller-authority.ts; grep -q "axiom.supervision.resolve" src/shared/axiom-contract/mutations.ts; grep -q "axiom.supervision.resolve" src/shared/rpc-contract/rpc-params-catalog.generated.ts; grep -q "axiom.supervision.resolve" src/main/runtime/rpc/methods/axiom/supervision.ts; git grep -q "attempt.supervision_reconciled" -- src/main/axiom/recovery ':(exclude)*.test.ts'; grep -q "attempt.supervision_reconciled" tests/e2e/mission-budget-stop-continuation.spec.ts; grep -q "observationSequence" tests/e2e/mission-budget-stop-continuation.spec.ts; grep -rq "reconciles an observation as a hit when the timeout rule stops the Attempt" src/main/axiom; grep -rq "reconciles an observation as a false positive when the candidate passes verification" src/main/axiom; grep -rq "reconciles an observation as a hit when verification fails" src/main/axiom; grep -rq "reconciles a failed ending as a hit and an interrupted ending as inconclusive" src/main/axiom; grep -rq "reconciles declared and canceled endings as inconclusive" src/main/axiom; grep -rq "keeps an observation pending while its Attempt is current" src/main/axiom; grep -rq "keeps an observation pending while verification is under way" src/main/axiom; grep -rq "reconciles each observation once" src/main/axiom; grep -rq "proposes the next tier after twenty known outcomes with at least ninety percent hits" src/main/axiom; grep -rq "does not propose below the bar or when the global mode is stop" src/main/axiom; grep -rq "counts evidence only after the latest global decision" src/main/axiom; grep -rq "keeps at most one open proposal" src/main/axiom; grep -rq "accepts a proposal into a new global revision" src/main/axiom; grep -rq "dismisses a proposal and restarts the count" src/main/axiom; grep -rq "supersedes an open proposal when a person changes the global mode" src/main/axiom; grep -rq "refuses to accept a proposal whose starting mode changed" src/main/axiom; grep -rq "refuses proposal answers from outside the desktop app" src/main/axiom; grep -rq "lists the evidence and the proposals in the show view" src/main/axiom; grep -q "attempt.supervision_reconciled" docs/reference/control-plane.md; grep -q "axiom.supervision.resolve" docs/reference/control-plane.md; grep -q "attempt.supervision_reconciled" docs/GLOSSARY.md; grep -q "supervision_proposals" docs/reference/orca-mapping.md; ls .axiom-work/reports/M3-06-3-2b-*.md
