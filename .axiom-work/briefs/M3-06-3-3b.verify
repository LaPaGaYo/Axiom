targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers src/main/runtime/orchestration/db/schema src/shared/wsl-move src/main/runtime/rpc/dispatcher-axiom-session-coverage.test.ts src/main/runtime/rpc/dispatcher-axiom-terminal-authority.test.ts
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts$|docs/reference/control-plane\.md$|docs/reference/orca-mapping\.md$|docs/GLOSSARY\.md$|tests/e2e/mission-token-budget-stop\.spec\.ts$|tests/e2e/helpers/(axiom-test-provider|axiom-fixture-task-options|axiom-codex-rollout|axiom-[a-z-]*(usage|budget)[a-z-]*)(\.unit\.test)?\.ts$|\.axiom-work/reports/)' | wc -l)" -eq 0; ! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)'; git diff --quiet main -- docs/decisions docs/plans docs/ARCHITECTURE.md; git diff --quiet main -- src/cli src/main/git src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/rate-limits src/main/startup src/main/daemon src/main/orcad src/main/codex-usage src/main/claude-usage src/main/usage; git diff --quiet main -- src/main/runtime src/shared/wsl-move; test "$(git diff --name-only --diff-filter=MD main -- src/main/axiom src/shared/axiom-contract tests/e2e/helpers | grep -v -E '(\.test\.ts|\.test-support\.ts)$' | grep -v -E '^(src/main/axiom/(recovery/(attempt-supervision|attempt-supervision-stop|supervision-stop-settlement|attempt-reconciliation|attempt-token-metering)|execution/(codex-attempt-usage|attempt-settlement|planner-launcher|headless-worker-launch|in-place-continuation)|db/attempt-token-usage-store|scheduler/(scheduler|admission-budget)|mission-controller/task-adjustment|context-builder/(render|continuation-prompt))|src/shared/axiom-contract/(task-params|token-usage)|tests/e2e/helpers/(axiom-fixture-task-options|axiom-codex-rollout|axiom-test-provider))\.ts$' | wc -l)" -eq 0; test "$(git diff --name-only --diff-filter=MD main | grep -E '(\.test\.ts|\.test-support\.ts|\.spec\.ts)$' | grep -v -E '^(src/main/axiom/recovery/attempt-token-usage\.test\.ts|src/main/axiom/recovery/(token-usage|supervision)-fixture\.test-support\.ts|tests/e2e/helpers/(axiom-fixture-task-options|axiom-codex-rollout|axiom-token-usage|axiom-test-provider)\.unit\.test\.ts)$' | wc -l)" -eq 0; git diff --quiet main -- src/main/axiom/recovery/recovery-service.ts; test "$(git diff --numstat main -- src/main/axiom/scheduler/scheduler.ts | awk '{s+=$1} END {print s+0}')" -le 12; test "$(git diff --numstat main -- src/main/axiom/scheduler/scheduler.ts | awk '{s+=$1-$2} END {print s+0}')" -le 8; test "$(git diff --numstat main -- src/main/axiom/recovery/attempt-reconciliation.ts | awk '{s+=$1+$2} END {print s+0}')" -le 4; test "$(git diff --numstat main -- src/main/axiom/execution/in-place-continuation.ts | awk '{s+=$1+$2} END {print s+0}')" -le 4; test "$(git diff --numstat main -- src/main/axiom/execution/headless-worker-launch.ts | awk '{s+=$1+$2} END {print s+0}')" -le 10; test "$(git diff --numstat main -- tests/e2e/helpers/axiom-test-provider.ts | awk '{s+=$1-$2} END {print s+0}')" -le 2; test "$(git grep -n "SELECT \*" -- src/main/axiom/db | wc -l)" -eq 0; ! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts src/main/rate-limits; test "$(git grep -n -E "getAccountsSnapshot|rateLimitService|refreshRateLimits|providerActivations" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "plan_type|planType|creator_account_id|creator_user_id|has_credits" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "codex-usage/(scanner|store|codex-usage-provider|codex-session-file-discovery)|claude-usage/(scanner|store)" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean|branch -D|update-ref -d" -- src/main/axiom/execution src/main/axiom/context-builder src/main/axiom/recovery | grep -v "\.test\.ts" | wc -l)" -eq 0; grep -q "reconcileAttempts" src/main/axiom/recovery/recovery-service.ts; grep -q "ATTEMPT_RECONCILE_INTERVAL_MS" src/main/axiom/recovery/recovery-service.ts; test "$(grep -c "no_attempts_in_m1" src/main/axiom/recovery/recovery-service.ts)" -eq 0; grep -q "flushAttemptCadences" src/main/axiom/recovery/recovery-service.ts; grep -q "reconcileStallObservations" src/main/axiom/recovery/recovery-service.ts; grep -q "meterAttemptTokens" src/main/axiom/recovery/recovery-service.ts; grep -q "recovery_runtime_budget" src/main/axiom/recovery/attempt-recovery-endings.ts; git grep -q "recovery_stall_stop" -- src/main/axiom/recovery ':(exclude)*.test.ts'; grep -q "SCHEMA_VERSION = 46" src/main/runtime/orchestration/db/contract-constants.ts; test "$(git grep -n -i -E "update supervision_settings|replace into supervision_settings|delete from supervision_settings" -- src/main ':(exclude)*.test.ts' ':(exclude)src/main/runtime/orchestration/db/schema/create-axiom-supervision-sql.ts' | wc -l)" -eq 0; test "$(git grep -n -i "delete from attempt_token_usage" -- src/main ':(exclude)*.test.ts' ':(exclude)src/main/runtime/orchestration/db/schema/create-axiom-supervision-sql.ts' | wc -l)" -eq 0; test "$(git diff main -- src/main/axiom ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | grep -E '^\+' | grep -c -E 'setInterval|setTimeout')" -eq 0; test "$(git grep -n -E "DecisionEngine|decision-engine" -- src/main/axiom/recovery src/main/axiom/supervision src/main/axiom/execution ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | wc -l)" -eq 0; test "$(git grep -n -E "DecisionEngine|decision-engine" -- src/main/axiom/scheduler src/main/axiom/context-builder src/main/axiom/mission-controller ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | wc -l)" -eq 0; test "$(git diff --name-only --diff-filter=A main -- src | grep -c -E '(utils|helpers)[^/]*$')" -eq 0; ! grep -q "axiom.mission.usage" src/shared/axiom-contract/mutations.ts; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; git grep -q "recovery_token_stop" -- src/main/axiom ':(exclude)*.test.ts'; git grep -q "token_budget_exhausted" -- src/main/axiom ':(exclude)*.test.ts'; git grep -q -E "[^_a-z]budget_exhausted" -- src/main/axiom/recovery ':(exclude)*.test.ts'; git grep -q "task_tokens" -- src/main/axiom/scheduler ':(exclude)*.test.ts'; grep -q "maxTokens" src/main/axiom/scheduler/admission-budget.ts; grep -q "maxTokens" src/shared/axiom-contract/task-params.ts; grep -q "maxTokens" src/main/axiom/mission-controller/task-adjustment.ts; git grep -q "Token budget" -- src/main/axiom ':(exclude)*.test.ts'; grep -q "taskMaxTokens" tests/e2e/helpers/axiom-fixture-task-options.ts; grep -q "axiom.task.adjust" tests/e2e/mission-token-budget-stop.spec.ts; grep -q "axiom.mission.usage" tests/e2e/mission-token-budget-stop.spec.ts; grep -q "desktopCall" tests/e2e/mission-token-budget-stop.spec.ts; grep -q "budget_exhausted" tests/e2e/mission-token-budget-stop.spec.ts; grep -rq "stops an Attempt when its Task reaches the token budget" src/main/axiom; grep -rq "counts the earlier Attempts of the Task toward its token budget" src/main/axiom; grep -rq "leaves an Attempt running below the token budget or without one" src/main/axiom; grep -rq "records the token stop once when the stop is unconfirmed" src/main/axiom; grep -rq "blocks a ready Task at admission once its usage reached the token budget" src/main/axiom; grep -rq "blocks the Mission at admission once its usage reached the Mission token budget" src/main/axiom; grep -rq "refuses a Planner start once the Mission token budget is exhausted" src/main/axiom; grep -rq "raises the token budget of a blocked Task and makes it ready" src/main/axiom; grep -rq "refuses a token budget at or below the usage of the Task" src/main/axiom; grep -rq "states the remaining token budget in the launch and continuation prompts" src/main/axiom; grep -rq "keeps resuming in place when only the token usage changed" src/main/axiom; grep -rq "skips rate-limit-only rollout records without marking the reading partial" src/main/axiom; grep -rq "never lowers recorded token usage" src/main/axiom; grep -q "token_budget_exhausted" docs/reference/control-plane.md; grep -q "recovery_token_stop" docs/reference/control-plane.md; grep -q "token_budget_exhausted" docs/GLOSSARY.md; grep -q "task_tokens" docs/GLOSSARY.md; grep -q -E "task\.adjust.*maxTokens|maxTokens.*task\.adjust" docs/reference/orca-mapping.md; ls .axiom-work/reports/M3-06-3-3b-*.md
