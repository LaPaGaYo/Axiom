targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers config/scripts/orcad-entry-build
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|tests/e2e/helpers/|tests/e2e/mission-[A-Za-z0-9._-]+\.spec\.ts|docs/reference/control-plane\.md|docs/GLOSSARY\.md|\.axiom-work/reports/M3-03b-[0-9]+\.md|\.axiom-work/briefs/M3-03b\.(md|verify)|\.axiom-work/verifications/M3-03b-[0-9]+\.md)' | wc -l)" -eq 0; git diff --quiet main -- src/main/runtime src/main/daemon src/main/git src/cli src/renderer config mobile package.json pnpm-lock.yaml pnpm-workspace.yaml docs/decisions; test -f src/main/axiom/verification/test-tampering.ts; test -f src/main/axiom/verification/worker-artifacts.ts; grep -q "detectTestTampering" src/main/axiom/verification/test-tampering.ts; grep -q "detectTestTampering" src/main/axiom/verification/diff-gate.ts; grep -q "removedText" src/main/axiom/verification/candidate-diff.ts; grep -q "test_file_deleted" src/main/axiom/verification/test-tampering.ts; grep -q "test_skip_added" src/main/axiom/verification/test-tampering.ts; grep -q "assertions_reduced" src/main/axiom/verification/test-tampering.ts; grep -q "suppression_added" src/main/axiom/verification/test-tampering.ts; grep -q "test_tampering" src/main/axiom/verification/verification-verdict.ts; grep -q "non_code" src/main/axiom/verification/verification-verdict.ts; grep -q "artifact_missing" src/main/axiom/verification/verification-verdict.ts; grep -q "artifact_invalid" src/main/axiom/verification/verification-verdict.ts; test "$(git grep -n "no_checks" -- src/main/axiom src/shared/axiom-contract | grep -v "\.test\.ts" | wc -l)" -eq 0; grep -q "testPathPatterns" src/shared/axiom-contract/verification-rules.ts; grep -q "tampering" src/main/axiom/verification/verification-settlement.ts; grep -q "tampering" src/main/axiom/context-builder/previous-attempt.ts; grep -q "test_tampering" src/main/axiom/context-builder/render.ts; grep -q "allowedPaths when a Task must delete it" src/main/axiom/context-builder/planner-render.ts; grep -q "test-skip" tests/e2e/helpers/axiom-test-provider.ts; grep -q "assertion-drop" tests/e2e/helpers/axiom-test-provider.ts; grep -q "suppression" tests/e2e/helpers/axiom-test-provider.ts; test -f tests/e2e/mission-tamper-gate.spec.ts; grep -q "test_tampering" tests/e2e/mission-tamper-gate.spec.ts; grep -q "assertions_reduced" tests/e2e/mission-tamper-gate.spec.ts; grep -q "test_tampering" docs/reference/control-plane.md; grep -q "testPathPatterns" docs/reference/control-plane.md; grep -q "non_code" docs/GLOSSARY.md; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 226; test "$(pnpm run typecheck:e2e 2>&1 | grep -c -E "mission-tamper-gate\.spec\.ts|axiom-test-provider\.ts")" -eq 0; test -f .axiom-work/reports/M3-03b-1.md; ! grep -q -i "work in progress" .axiom-work/reports/M3-03b-1.md
