targets: src/renderer/src/components/sidebar/SidebarNav src/renderer/src/components/settings src/renderer/src/hooks/useSettingsNavigationMetadata src/renderer/src/hooks/settings-navigation src/renderer/src/components/WorktreeJumpPalette src/renderer/src/store/slices/ui src/renderer/src/components/mobile src/main/menu src/shared/serve-option-validation src/cli src/main/orcad/orcad-launch-contract src/main/orcad/orcad-command-arguments src/main/startup/serve src/main/runtime/runtime-pairing-desktop-control-grant
extra: test "$(git diff --name-only main | grep -v -E '^(src/shared/mobile-pairing-availability\.ts|src/shared/serve-option-validation(\.test)?\.ts|src/renderer/src/components/sidebar/SidebarNav(\.[a-z-]+)?(\.test)?\.tsx|src/renderer/src/components/settings/(AppearanceWindowSidebarSection\.tsx|appearance-sidebar-search\.ts|settings-setup-workflow-section-renderers\.tsx|[A-Za-z0-9.-]+\.test\.tsx?)|src/renderer/src/hooks/(settings-navigation-capability-sections\.ts|[A-Za-z0-9.-]+\.test\.tsx?)|src/renderer/src/store/slices/(ui/ui-slice-hydration-sanitizers\.ts|[A-Za-z0-9./-]+\.test\.tsx?)|src/renderer/src/components/WorktreeJumpPalette[A-Za-z0-9.-]*\.test\.tsx|src/renderer/src/components/mobile/MobilePage\.test\.tsx|src/main/menu/register-app-menu(\.[a-z-]+)?(\.test)?\.ts|src/cli/specs/serve\.ts|src/cli/root-help-text-secondary\.ts|src/cli/[A-Za-z0-9./-]+\.test\.ts|src/main/orcad/orcad-command-arguments\.ts|src/main/orcad/[A-Za-z0-9.-]+\.test\.ts|docs/site/content/docs/remote-servers\.mdx|docs/reference/orca-mapping\.md|\.axiom-work/reports/D75-HYG-[0-9]+\.md)$' | wc -l)" -eq 0; git diff --quiet main -- mobile config package.json pnpm-lock.yaml pnpm-workspace.yaml src/main/runtime src/main/ipc src/main/daemon src/shared/orcad-artifacts.ts src/main/startup/serve-mode-argv.ts src/main/startup/serve-options.ts src/cli/handlers/core.ts src/renderer/src/components/mobile/MobilePage.tsx src/renderer/src/components/settings/MobileSettingsPane.tsx src/renderer/src/components/settings/MobilePane.tsx docs/decisions tests; grep -q "export const MOBILE_PAIRING_AVAILABLE: boolean = false" src/shared/mobile-pairing-availability.ts; test "$(grep -l "MOBILE_PAIRING_AVAILABLE" src/renderer/src/components/sidebar/SidebarNav.tsx src/renderer/src/hooks/settings-navigation-capability-sections.ts src/renderer/src/components/settings/AppearanceWindowSidebarSection.tsx src/renderer/src/components/settings/appearance-sidebar-search.ts src/renderer/src/store/slices/ui/ui-slice-hydration-sanitizers.ts src/main/menu/register-app-menu.ts src/shared/serve-option-validation.ts | wc -l)" -eq 7; grep -q "Mobile pairing is not available in this version of Axiom." src/shared/serve-option-validation.ts; ! grep -q -e "--mobile-pairing" src/cli/specs/serve.ts src/cli/root-help-text-secondary.ts; grep -q "'mobile-pairing'" src/cli/specs/serve.ts; ! grep -q "Create a mobile-scoped pairing offer" src/main/orcad/orcad-command-arguments.ts; ! grep -q "no-pairing or --mobile-pairing" src/main/orcad/orcad-command-arguments.ts; ! grep -q "name: 'Axiom Relay'" src/renderer/src/components/mobile/MobilePage.test.tsx; test "$(grep -c "name: 'Orca Relay'" src/renderer/src/components/mobile/MobilePage.test.tsx)" -eq 3; test "$(( $(grep -c '^```' docs/site/content/docs/remote-servers.mdx) % 2 ))" -eq 0; ! grep -q "Keep the phone on the same tailnet" docs/site/content/docs/remote-servers.mdx; grep -q "The mobile companion is not part of Axiom V1." docs/site/content/docs/remote-servers.mdx; grep -q "MOBILE_PAIRING_AVAILABLE" docs/reference/orca-mapping.md; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 226; test -f .axiom-work/reports/D75-HYG-1.md
