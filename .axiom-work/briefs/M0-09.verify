targets: src/main/startup src/main/agent-hooks src/main/codex src/main/preflight src/main/rate-limits src/main/ipc src/main/provider-activation src/main/global-fetch-call-site-audit src/shared tests/e2e/helpers/recording-proxy
extra: ORCA_BACKGROUND_LAUNCH=1 pnpm run test:e2e:egress-cold-start; git grep -q "'github.com'" -- tests/e2e/golden-egress-cold-start.spec.ts; git grep -q "Non-loopback requests" -- tests/e2e/golden-egress-cold-start.spec.ts; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; grep -q "Attribution" docs/review-evidence/axiom-m0/M0-08-egress-capture.md; test "$(git diff --numstat 811d04fcd -- docs/GLOSSARY.md docs/reference/orca-mapping.md | awk '{d+=$2} END {print d+0}')" -eq 0; test "$(git grep -c -E "\bfetch\(" -- src/main/rate-limits/service/service-state.ts | cut -d: -f2)" = ""
