targets: tests/e2e/helpers/fixture-plan-proposal.unit.test.ts
extra: git diff --quiet main -- src package.json pnpm-lock.yaml tests/e2e/helpers docs; test "$(git diff --name-only main | grep -v -E "^(\.axiom-work/reports/)" | wc -l)" -eq 0; test -f launchers/codex-app-server-probe.command; test -x launchers/codex-app-server-probe.command; grep -q "managed-daemon\|app-server-control" tests/e2e/mission-plan-real-codex.smoke.spec.ts; grep -q "AXIOM_SMOKE_STRUCTURED" tests/e2e/mission-plan-real-codex.smoke.spec.ts; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 214; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "mission-plan-real-codex.smoke.spec.ts")" -eq 0; test -f .axiom-work/reports/M3-00-1.md; grep -q "A′\|ACP" .axiom-work/reports/M3-00-1.md
