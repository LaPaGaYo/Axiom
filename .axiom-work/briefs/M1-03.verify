targets: src/main/runtime/orchestration/db/schema src/main/runtime/orchestration/orchestration-all-start-versions-migration.test.ts src/main/runtime/orchestration/orchestration-version-skew-migration.test.ts src/main/runtime/orchestration/db.test.ts src/main/runtime/orchestration/orchestration-orca-session-column-migration.test.ts src/main/axiom
extra: git diff --quiet main -- src/main/runtime/orchestration/db/schema/create-core-tables-sql.ts src/main/runtime/orchestration/db/schema/create-graph-tables-sql.ts src/main/runtime/orchestration/orchestration-schema-version-skew.ts; test -f src/main/runtime/orchestration/db/schema/create-axiom-tables-sql.ts; test -f src/main/runtime/orchestration/db/schema/migrate-v43.ts; git grep -qE "SCHEMA_VERSION = 4[4-9]" -- src/main/runtime/orchestration/db/contract-constants.ts; test "$(git grep -c -E "CREATE TABLE IF NOT EXISTS (missions|goal_revisions|plan_revisions|task_stages|mission_task_edges|agent_specs|attempt_bindings|context_packages|submissions|candidates|artifacts|decisions|verification_runs|integration_batches|approvals|mission_policies|audit_events) " -- src/main/runtime/orchestration/db/schema/create-axiom-tables-sql.ts | cut -d: -f2)" -eq 17; test "$(git grep -c -E "@ts-nocheck|test\.skip" -- src/main/runtime/orchestration/db/schema src/main/axiom | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
