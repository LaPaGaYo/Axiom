targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts$|src/main/runtime/rpc/methods/axiom/|src/cli/|docs/reference/control-plane\.md$|docs/reference/orca-mapping\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0; ! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)'; git diff --quiet main -- docs/decisions docs/plans docs/ARCHITECTURE.md; git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/codex-usage src/main/claude src/main/claude-accounts src/main/rate-limits src/main/startup src/main/daemon src/main/git src/shared/rate-limit-types.ts src/shared/agent-session-usage-limit.ts src/shared/agent-session-failure.ts; test "$(git diff --name-only main -- src/main/runtime | grep -v -E '^src/main/runtime/rpc/methods/axiom/' | wc -l)" -eq 0; git diff --quiet main -- src/main/axiom/scheduler src/main/axiom/agent-factory src/main/axiom/outbox src/main/axiom/mission-controller src/main/axiom/execution/interruption-policy.ts src/main/axiom/execution/attempt-settlement.ts src/main/axiom/db/effects-store.ts src/main/axiom/verification src/shared/axiom-contract; ! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts src/main/rate-limits; test "$(git grep -n -E "getAccountsSnapshot|rateLimitService|refreshRateLimits|providerActivations" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "plan_type|planType|creator_account_id|creator_user_id|has_credits" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; grep -q "account_cooldown" tests/e2e/mission-account-cooldown.spec.ts; grep -q "Fixture usage limit reached" tests/e2e/helpers/axiom-test-provider.ts; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; test "$(git grep -l "CodexUsageLimits" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -ge 1; grep -rq "adds the reset time that Codex recorded in its rollout" src/main/axiom; grep -rq "keeps the ladder when the rollout shows no spent window" src/main/axiom; grep -rq "never lets a rollout decide the failure class" src/main/axiom; grep -rq "lets nothing but the limit windows out of a rollout" src/main/axiom; grep -rq "never opens a session record for a Claude Worker" src/main/axiom; grep -rq "token_count" tests/e2e/helpers; grep -q "resetsAt" tests/e2e/mission-account-cooldown.spec.ts; grep -q "CodexUsageLimits" docs/reference/orca-mapping.md; grep -q "rollout" docs/reference/control-plane.md; grep -q "rollout" docs/GLOSSARY.md; ls .axiom-work/reports/M3-06-2a-3-*.md
