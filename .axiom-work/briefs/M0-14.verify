targets: config/scripts/ci-cache-warmup-workflow config/scripts/skill-update-roundtrip-workflow config/scripts/terminal-ime-e2e-workflow config/scripts/computer-e2e-workflow config/scripts/pr-workflow-lint-parity config/scripts/pr-workflow-parallelism config/scripts/workflow-ref-reachability config/scripts/workflow-ref-mirror-case-safety config/scripts/playwright-focused-workflow-selection src/main/global-fetch-call-site-audit
extra: test "$(git grep -n -E "^\s*(schedule|push):" -- .github/workflows/ci-cache-warmup.yml .github/workflows/mobile.yml .github/workflows/skill-update-roundtrip.yml .github/workflows/computer-e2e.yml .github/workflows/e2e.yml .github/workflows/node-next-compat.yml .github/workflows/packaged-browser-e2e.yml .github/workflows/performance-contracts.yml .github/workflows/terminal-ime-e2e.yml .github/workflows/terminal-perf.yml | wc -l)" -eq 0; test "$(git diff --name-only main -- .github/workflows | wc -l)" -le 10; git grep -q "workflow_dispatch" -- .github/workflows/ci-cache-warmup.yml; git grep -q "merge_group" -- .github/workflows/skill-update-roundtrip.yml; git grep -q -i "D41" -- docs/reference/ci-runner-efficiency.md; git diff --quiet main -- .github/workflows/pr.yml; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
