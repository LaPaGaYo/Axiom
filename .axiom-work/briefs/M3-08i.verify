targets: src/main/axiom src/shared/axiom-contract tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|docs/reference/control-plane\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/)';git diff --quiet main -- docs/decisions docs/plans;git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/runtime src/main/startup;grep -q candidate_unchanged src/main/axiom/execution/attempt-exit-submission.ts;grep -q "'unchanged'" src/main/axiom/execution/attempt-exit-submission.ts;grep -q unchanged_candidate src/main/axiom/execution/attempt-exit-submission.ts;grep -q unchangedAttempts src/main/axiom/execution/attempt-baseline.ts;grep -q unchangedAttempts src/main/axiom/context-builder/previous-attempt.ts;grep -q "exited without changing this Candidate" src/main/axiom/context-builder/previous-attempt.ts;! grep -q "'Test results'" src/main/axiom/context-builder/planner-render.ts;grep -qi "shell command" src/main/axiom/context-builder/planner-render.ts;grep -A3 "requiredEvidence" src/shared/axiom-contract/mission-objects.ts | grep -q describe;grep -q "unchanged-fix" tests/e2e/helpers/axiom-test-provider.ts;grep -rq "unchanged-fix" tests/e2e/mission-headless-worker.spec.ts tests/e2e/mission-fix-loop.spec.ts;grep -q "settlement.kind" docs/GLOSSARY.md;grep -q "unchangedAttempts" docs/reference/control-plane.md;! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts src/main/runtime src/main/startup;ls .axiom-work/reports/M3-08i-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
