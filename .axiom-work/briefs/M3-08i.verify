targets: src/main/axiom src/shared/axiom-contract src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/cli/|docs/reference/control-plane\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/)';git diff --quiet main -- docs/decisions docs/plans;git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/runtime src/main/startup;grep -q candidate_unchanged src/main/axiom/execution/attempt-exit-submission.ts;grep -q "'unchanged'" src/main/axiom/execution/attempt-exit-submission.ts;grep -q unchanged_candidate src/main/axiom/execution/attempt-exit-submission.ts;grep -q -E 'unchangedAttempts|skippedAttempts' src/main/axiom/execution/attempt-baseline.ts;grep -q -E 'unchangedAttempts|skippedAttempts' src/main/axiom/context-builder/previous-attempt.ts;grep -q "exited without changing this Candidate" src/main/axiom/context-builder/previous-attempt.ts;! grep -q "'Test results'" src/main/axiom/context-builder/planner-render.ts;grep -qi "shell command" src/main/axiom/context-builder/planner-render.ts;grep -A3 "requiredEvidence" src/shared/axiom-contract/mission-objects.ts | grep -q describe;test -f src/shared/axiom-contract/evidence-commands.ts;grep -q evidenceCommands src/shared/axiom-contract/verification-rules.ts;grep -q planInvalidPatterns src/shared/axiom-contract/verification-rules.ts;grep -q evidence_command_invalid src/shared/axiom-contract/plan-proposal.ts;grep -q evidence_command_invalid src/main/axiom/mission-controller/plan-materialization.ts;grep -q "'evidence'" src/main/axiom/messaging/subtask-checks.ts;grep -q plan_invalid src/main/axiom/verification/verification-plan-runner.ts;grep -q "'plan_invalid'" src/main/axiom/verification/verification-verdict.ts;grep -q "unchanged-fix" tests/e2e/helpers/axiom-test-provider.ts;grep -rq "unchanged-fix" tests/e2e/mission-headless-worker.spec.ts tests/e2e/mission-fix-loop.spec.ts tests/e2e/mission-verification.spec.ts;grep -q AXIOM_E2E_PLANNER_PROSE_EVIDENCE tests/e2e/fixtures/axiom-claude-planner-stub.cjs;grep -q evidence_command_invalid tests/e2e/mission-plan.spec.ts;grep -rq plan_invalid tests/e2e/mission-verification.spec.ts tests/e2e/mission-fix-loop.spec.ts tests/e2e/mission-headless-worker.spec.ts;grep -q "settlement.kind" docs/GLOSSARY.md;grep -q plan_invalid docs/GLOSSARY.md;grep -q -E 'unchangedAttempts|skippedAttempts' docs/reference/control-plane.md;grep -q planInvalidPatterns docs/reference/control-plane.md;grep -q evidenceCommands docs/reference/control-plane.md;! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;ls .axiom-work/reports/M3-08i-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
