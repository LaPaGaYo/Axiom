/reference/orca-mapping.md; test "$(git grep -l "@ts-nocheck" -- src/main/axiom | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c -E "error TS")" -le 226
