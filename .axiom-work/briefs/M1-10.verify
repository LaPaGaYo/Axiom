targets: tests/e2e/helpers/fixture-plan-proposal.unit.test.ts src/main/axiom src/shared/axiom-contract
extra: test "$(git diff --name-only main | grep -v -E "^(tests/e2e/mission-exit-m1\.spec\.ts|tests/e2e/helpers/fixture-plan-proposal(\.unit\.test)?\.ts|docs/review-evidence/axiom-m1/M1-exit-e2e\.md|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|docs/decisions/DEFERRED\.md|AGENTS\.md|\.gitignore|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f tests/e2e/mission-exit-m1.spec.ts; test -f tests/e2e/helpers/fixture-plan-proposal.ts; test -f tests/e2e/helpers/fixture-plan-proposal.unit.test.ts; test -f docs/reference/control-plane.md; test -f docs/review-evidence/axiom-m1/M1-exit-e2e.md; git grep -q "docs/reference/control-plane.md" -- .gitignore; git grep -q "docs/reference/control-plane.md" -- AGENTS.md; grep -qE "^\| DEF-1 \|.*\| (OPEN|RESOLVED \(D45\)[^|]*) \|" docs/decisions/DEFERRED.md; test "$(grep -o "test\.skip" tests/e2e/mission-exit-m1.spec.ts | wc -l)" -le 1; git diff --quiet main -- src; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(git grep -l "@ts-nocheck" -- tests/e2e/mission-exit-m1.spec.ts tests/e2e/helpers/fixture-plan-proposal.ts | wc -l)" -eq 0; grep -q "no_active_sender_terminal" tests/e2e/mission-exit-m1.spec.ts; grep -q "\[M1-exit\]" tests/e2e/mission-exit-m1.spec.ts
