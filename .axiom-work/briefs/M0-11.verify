targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc src/cli src/main/startup src/main/global-fetch-call-site-audit
extra: git grep -q "axiom.namespace.get" -- src/main/axiom; git grep -q -E "AXIOM_METHODS" -- src/main/runtime/rpc/methods/index.ts; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(git grep -c -E "^[[:space:]]*//[[:space:]]*@ts-nocheck" -- src/main/axiom src/shared/axiom-contract | wc -l)" -eq 0; test ! -e src/cli/specs/axiom.ts
