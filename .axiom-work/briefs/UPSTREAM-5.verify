targets: config/scripts/electron-runtime-floor.test.ts config/scripts/check-node-runtime-pin.test.mjs config/scripts/dependency-security-patches.test.mjs config/scripts/regenerate-xterm-patches.test.mjs
extra: test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; node -e "if (require('./package.json').devDependencies.electron.split('.').map(Number).reduce((n, v) => n * 1000 + v, 0) < 43008010) throw new Error('electron below 43.8.10')"; python3 -I -c "assert (lambda t, b: t.count('fontFamily}' + b + '.trim()') >= 3 and t.count('fontFamily}' + b + ',this._probe') == 0)(open(__import__('glob').glob('config/patches/@xterm__addon-webgl@*.patch')[0], encoding='utf-8', errors='replace').read(), chr(96))"; python3 -I -c "assert (lambda t, f: len(f('\n  picomatch@([0-9.]+): [0-9a-f]{64}(?=\n)', t)) > 0 and set(f('\n  picomatch@([0-9.]+):(?=\n)', t)) <= set(f('\n  picomatch@([0-9.]+): [0-9a-f]{64}(?=\n)', t)))(open('pnpm-lock.yaml', encoding='utf-8').read(), __import__('re').findall)"
