targets: src/shared/axiom-contract src/main/axiom src/cli/cli-command-name-parity.test.ts
extra: test "$(git diff --name-only main | grep -v -E "^(src/shared/axiom-contract/|docs/GLOSSARY.md|docs/reference/orca-mapping.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/shared/axiom-contract/lifecycle.ts; test -f src/shared/axiom-contract/plan-proposal.ts; test "$(ls src/shared/axiom-contract/*.test.ts | wc -l)" -ge 4; test "$(git grep -c -E "@ts-nocheck|test\.skip" -- src/shared/axiom-contract | wc -l)" -eq 0; git diff --quiet main -- src/shared/rpc-contract/rpc-params-catalog.generated.ts; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
