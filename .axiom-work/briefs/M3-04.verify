targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers config/scripts/orcad-entry-build
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|tests/e2e/helpers/|tests/e2e/mission-[A-Za-z0-9._-]+\.spec\.ts|docs/reference/control-plane\.md|docs/GLOSSARY\.md|\.axiom-work/reports/M3-04-[0-9]+\.md|\.axiom-work/briefs/M3-04\.(md|verify)|\.axiom-work/verifications/M3-04-[0-9]+\.md)' | wc -l)" -eq 0; git diff --quiet main -- src/main/runtime src/main/daemon src/main/git src/cli src/renderer config mobile package.json pnpm-lock.yaml pnpm-workspace.yaml docs/decisions; test -f src/main/axiom/execution/attempt-baseline.ts; grep -q "resolveAttemptBaseline" src/main/axiom/execution/attempt-baseline.ts; grep -q "secret_detected" src/main/axiom/execution/attempt-baseline.ts; test "$(git grep -l "resolveAttemptBaseline" -- src/main/axiom/execution | grep -v -E "\.test\.ts$|attempt-baseline\.ts$" | wc -l)" -ge 1; test "$(git grep -l "resolveAttemptBaseline" -- src/main/axiom/context-builder | grep -v -E "\.test\.ts$" | wc -l)" -ge 1; test "$(git grep -l "fix_base_mismatch" -- src/main/axiom/execution | grep -v -E "\.test\.ts$" | wc -l)" -ge 1; test "$(git grep -l "updateTaskStatus" -- src/main/axiom/execution | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l)" -ge 1; test "$(git grep -l "continues the previous Candidate" -- src/main/axiom/context-builder | grep -v -E "\.test\.ts$" | wc -l)" -ge 1; test "$(git grep -l "Do not weaken, skip or delete tests" -- src/main/axiom/context-builder | grep -v -E "\.test\.ts$" | wc -l)" -ge 1; test "$(git grep -l "none (first attempt)" -- src/main/axiom/context-builder | grep -v -E "\.test\.ts$" | wc -l)" -ge 1; test "$(git grep -n -E "reset --hard|checkout --|git clean|branch -D|update-ref -d" -- src/main/axiom/execution src/main/axiom/context-builder | grep -v "\.test\.ts" | wc -l)" -eq 0; ! grep -q "'--attempt', '1'" tests/e2e/helpers/axiom-test-provider.ts; test -f tests/e2e/mission-fix-loop.spec.ts; grep -q "maxAttempts: 2" tests/e2e/mission-fix-loop.spec.ts; grep -q "retry_budget_exhausted" tests/e2e/mission-fix-loop.spec.ts; grep -q "src/services/date-range.test.ts" tests/e2e/mission-fix-loop.spec.ts; grep -q "fix_base_mismatch" docs/reference/control-plane.md; grep -q "resolveAttemptBaseline" docs/reference/control-plane.md; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l)" -eq 0; ! git diff main -- src tests | grep -q "^+.*@ts-nocheck"; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 226; test "$(pnpm run typecheck:e2e 2>&1 | grep -c -E "mission-fix-loop\.spec\.ts|axiom-test-provider\.ts|axiom-fixture-inspection\.ts")" -eq 0; test -f .axiom-work/reports/M3-04-1.md; ! grep -q -i "work in progress" .axiom-work/reports/M3-04-1.md
