targets: src/shared/axiom-contract src/main/axiom src/main/runtime/rpc/methods/axiom src/renderer/src/components/missions
extra: test "$(git diff --name-only main | grep -v -E '^(src/shared/axiom-contract/secret-patterns(\.test)?\.ts|src/shared/axiom-contract/plan-proposal\.ts|src/shared/axiom-contract/[A-Za-z0-9_-]+\.test\.ts|src/main/axiom/context-builder/redaction\.ts|src/main/axiom/messaging/subtask-checks\.ts|src/main/axiom/[A-Za-z0-9/_-]+\.test\.ts|src/renderer/src/components/missions/TaskCriteriaSecret\.test\.tsx|docs/reference/control-plane\.md|\.axiom-work/reports/M3-09-4b-1-[0-9]+\.md)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=MD main | grep -v -E '^(src/shared/axiom-contract/plan-proposal\.ts|src/main/axiom/context-builder/redaction\.ts|src/main/axiom/messaging/subtask-checks\.ts|src/main/axiom/mission-controller/task-acceptance-adjustment\.test\.ts|docs/reference/control-plane\.md)$' | wc -l | tr -d ' ')" -eq 0; git diff --quiet main -- src/renderer/src ':(exclude)src/renderer/src/components/missions/TaskCriteriaSecret.test.tsx'; git diff --quiet main -- src/cli src/preload src/main/runtime tests package.json pnpm-lock.yaml pnpm-workspace.yaml config .github mobile; git diff --quiet main -- src/main/axiom/mission-controller/task-creation.ts src/main/axiom/mission-controller/task-adjustment.ts src/main/axiom/mission-controller/plan-materialization.ts src/main/axiom/mission-controller/plan-validation.ts src/main/axiom/messaging/subtask-resolution.ts; git diff --quiet main -- AGENTS.md docs/decisions docs/plans docs/ARCHITECTURE.md docs/GLOSSARY.md docs/PROJECT_CONSTITUTION.md docs/STYLEGUIDE.md .axiom-work/briefs .axiom-work/scripts .axiom-work/sidecar-union.list; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git diff main -- src | grep -c -E '^\+.*(useFakeTimers|setSystemTime)')" -eq 0; test "$(git grep -l 'AKIA\[0-9A-Z\]' -- src/main/axiom src/shared/axiom-contract ':(exclude)*.test.ts' | wc -l | tr -d ' ')" -eq 1; git grep -q "export function redactContext" -- src/main/axiom/context-builder/redaction.ts; git grep -q "export function detectSecretPatterns" -- src/main/axiom/context-builder/redaction.ts; git grep -q "function acceptanceForAudit" -- src/main/axiom/mission-controller/task-adjustment.ts; grep -q "redacts acceptance text and commands before writing adjustment audits" src/main/axiom/mission-controller/task-acceptance-adjustment.test.ts; test "$(grep -c . src/shared/axiom-contract/plan-proposal.ts)" -le 290; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; git grep -q "secret_in_criterion" -- src/shared/axiom-contract/plan-proposal.ts; git grep -q "secret_in_criterion" -- src/main/axiom/messaging/subtask-checks.ts; git grep -q "AKIA" -- src/shared/axiom-contract/secret-patterns.ts; test "$(git grep -l "secret-patterns" -- src/shared/axiom-contract/plan-proposal.ts src/main/axiom/context-builder/redaction.ts | wc -l | tr -d ' ')" -eq 2; grep -rq "flags a secret in the text and in the command of an acceptance criterion" src/shared/axiom-contract src/main/axiom; grep -rq "leaves criteria that only talk about secrets alone" src/shared/axiom-contract src/main/axiom; grep -rq "refuses a plan proposal whose criteria hold a secret and stores nothing" src/shared/axiom-contract src/main/axiom; grep -rq "refuses to create a Task whose criteria hold a secret and stores nothing" src/shared/axiom-contract src/main/axiom; grep -rq "refuses an adjustment whose new criteria hold a secret and stores nothing" src/shared/axiom-contract src/main/axiom; grep -rq "fails the checks of a subtask request whose criteria hold a secret" src/shared/axiom-contract src/main/axiom; grep -rq "answers a refused adjustment over RPC with the path of the issue and without the secret" src/shared/axiom-contract src/main/axiom; grep -rq "approves a stored plan whose criteria hold a secret" src/shared/axiom-contract src/main/axiom; grep -rq "uses one list of patterns to redact and to refuse" src/shared/axiom-contract src/main/axiom; grep -rq "refuses an adjustment whose rationale looks like a secret" src/shared/axiom-contract src/main/axiom; grep -q "says before sending that a criterion holds a secret" src/renderer/src/components/missions/TaskCriteriaSecret.test.tsx; grep -q "secret_in_criterion" docs/reference/control-plane.md; ! grep -q "标准与命令存储前也没有 secret 检查" docs/reference/control-plane.md; ls .axiom-work/reports/M3-09-4b-1-*.md
