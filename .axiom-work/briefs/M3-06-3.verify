targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|docs/reference/control-plane\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0; ! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)'; git diff --quiet main -- docs/decisions docs/plans docs/ARCHITECTURE.md docs/reference/orca-mapping.md; git diff --quiet main -- src/shared src/main/runtime src/cli src/main/git src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/rate-limits src/main/startup src/main/daemon src/main/orcad; git diff --quiet main -- src/main/axiom/scheduler src/main/axiom/outbox src/main/axiom/mission-controller src/main/axiom/verification src/main/axiom/db src/main/axiom/agent-factory src/main/axiom/context-builder src/main/axiom/execution/attempt-settlement.ts src/main/axiom/execution/attempt-interruption.ts src/main/axiom/execution/interruption-policy.ts src/main/axiom/execution/attempt-exit-submission.ts src/main/axiom/execution/attempt-exit-failure.ts src/main/axiom/execution/headless-attempt-watcher.ts src/main/axiom/execution/attempt-launcher.ts src/main/axiom/recovery/attempt-recovery-preservation.ts src/main/axiom/recovery/attempt-daemon-loss.ts src/main/axiom/recovery/planner-reconciliation.ts; git diff --quiet main -- src/main/axiom/recovery/daemon-loss.test.ts src/main/axiom/recovery/recovery-preservation-exclusions.test.ts src/main/axiom/recovery/recovery-preservation-races.test.ts src/main/axiom/recovery/recovery-exit-retry.test.ts src/main/axiom/recovery/planner-reconciliation.test.ts src/main/axiom/recovery/preservation-fixture.test-support.ts src/main/axiom/execution/interruption-fixture.test-support.ts src/main/axiom/execution/preserved-recovery-baseline.test.ts src/main/axiom/execution/attempt-interruption.test.ts src/main/axiom/execution/attempt-exit-submission.test.ts; test "$(git diff --numstat main -- src/main/axiom/recovery/attempt-reconciliation.test.ts src/main/axiom/recovery/recovery-preservation.test.ts | awk '{s+=$1+$2} END {print s+0}')" -le 16; ! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts src/main/rate-limits; test "$(git grep -n -E "getAccountsSnapshot|rateLimitService|refreshRateLimits|providerActivations" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "plan_type|planType|creator_account_id|creator_user_id|has_credits" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean|branch -D|update-ref -d" -- src/main/axiom/execution src/main/axiom/context-builder src/main/axiom/recovery | grep -v "\.test\.ts" | wc -l)" -eq 0; grep -q "planner" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "observeAgentExit" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "agentExit.evidence" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "kernel_failed" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "'declared'" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "launch_pending_orphan" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "reconcileAttempts" src/main/axiom/recovery/recovery-service.ts; grep -q "ATTEMPT_RECONCILE_INTERVAL_MS" src/main/axiom/recovery/recovery-service.ts; test "$(grep -c "no_attempts_in_m1" src/main/axiom/recovery/recovery-service.ts)" -eq 0; test "$(git diff --numstat main -- src/main/axiom/recovery/recovery-service.ts | awk '{s+=$1} END {print s+0}')" -le 10; test "$(git diff --numstat main -- src/main/axiom/recovery/attempt-reconciliation.ts | awk '{s+=$1} END {print s+0}')" -le 15; test "$(git diff --numstat main -- tests/e2e/helpers/axiom-fixture-mission.ts | awk '{s+=$1+$2} END {print s+0}')" -le 8; git diff --quiet main -- tests/e2e/helpers/axiom-test-provider.ts tests/e2e/helpers/axiom-partial-work.ts tests/e2e/helpers/axiom-codex-rollout.ts tests/e2e/helpers/axiom-codex-resume.ts tests/e2e/helpers/axiom-fixture-inspection.ts tests/e2e/helpers/axiom-fixture-restart.ts; git diff --quiet main -- tests/e2e/mission-interrupted-continuation.spec.ts tests/e2e/mission-preserved-continuation.spec.ts tests/e2e/mission-daemon-lost-continuation.spec.ts tests/e2e/mission-in-place-continuation.spec.ts tests/e2e/mission-account-cooldown.spec.ts tests/e2e/mission-headless-worker.spec.ts; test "$(git diff main -- src/main/axiom ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | grep -E '^\+' | grep -c -E 'setInterval|setTimeout')" -eq 0; grep -q "attempt.stopped" tests/e2e/mission-budget-stop-continuation.spec.ts; grep -q "attempt.preserved" tests/e2e/mission-budget-stop-continuation.spec.ts; grep -q -E "'(runtime_budget_exceeded|timeout)'" tests/e2e/mission-budget-stop-continuation.spec.ts; test "$(git grep -l "AXIOM_E2E_STALL_THRESHOLD_MS" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq "$(git grep -l --all-match -e "AXIOM_E2E_STALL_THRESHOLD_MS" -e "getMainE2EConfig" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)"; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; test "$(git grep -n "runtime_budget_exceeded" -- src/main/axiom/recovery ':(exclude)*.test.ts' ':(exclude)src/main/axiom/recovery/planner-reconciliation.ts' | wc -l)" -eq 0; git grep -q "attempt.supervised" -- src/main/axiom/recovery ':(exclude)*.test.ts'; git grep -q "attempt.cadence" -- src/main/axiom/recovery ':(exclude)*.test.ts'; test "$(git grep -l "AXIOM_E2E_STALL_THRESHOLD_MS" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -ge 1; grep -q "AXIOM_E2E_STALL_THRESHOLD_MS" tests/e2e/helpers/axiom-fixture-mission.ts; grep -q "stallThresholdMs" tests/e2e/mission-budget-stop-continuation.spec.ts; grep -q "attempt.supervised" tests/e2e/mission-budget-stop-continuation.spec.ts; grep -q "attempt.cadence" tests/e2e/mission-budget-stop-continuation.spec.ts; test "$(grep -c "runtime_budget_exceeded" tests/e2e/mission-budget-stop-continuation.spec.ts)" -eq 0; grep -rq "stops an Attempt over its runtime limit under the timeout rule" src/main/axiom; grep -rq "records the timeout rule with its threshold and source in the settlement" src/main/axiom; grep -rq "records the timeout rule once when the stop is unconfirmed" src/main/axiom; grep -rq "observes a silent headless Attempt once without changing its state" src/main/axiom; grep -rq "does not observe an Attempt whose events keep arriving" src/main/axiom; grep -rq "skips the stall rule while the events file is missing" src/main/axiom; grep -rq "writes the cadence of an Attempt once after it stops being current" src/main/axiom; grep -rq "marks the cadence partial when sampling began after a restart" src/main/axiom; grep -rq "derives the stall threshold from verified Attempts" src/main/axiom; grep -rq "ignores partial and unverified cadences for the threshold" src/main/axiom; grep -rq "uses the default threshold until five verified Attempts exist" src/main/axiom; grep -rq "takes the e2e stall threshold only under the e2e config" src/main/axiom; grep -rq "keeps TUI Attempts out of the stall rule" src/main/axiom; grep -q "attempt.supervised" docs/reference/control-plane.md; grep -q "attempt.cadence" docs/reference/control-plane.md; grep -q "attempt.supervised" docs/GLOSSARY.md; grep -q "attempt.cadence" docs/GLOSSARY.md; ls .axiom-work/reports/M3-06-3-*.md
