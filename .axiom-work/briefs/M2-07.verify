targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli/specs src/cli/handlers/axiom src/main/startup src/cli/handler-group-manifest.test.ts src/cli/cli-command-name-parity.test.ts src/main/runtime/rpc/errors.test.ts src/main/runtime/orchestration/db/dispatch-context
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/shared/axiom-contract/(submission-params|attempt-params|message-params|mutations|lifecycle)(\.test)?\.ts|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts|src/main/runtime/rpc/methods/axiom/attempt\.ts|src/main/runtime/rpc/methods/axiom\.ts|src/main/runtime/rpc/errors\.ts|src/cli/specs/axiom-attempt\.ts|src/cli/handlers/axiom/|src/cli/axiom-handler-groups\.ts|tests/e2e/helpers/axiom-test-provider\.ts|tests/e2e/mission-attempt-submit\.spec\.ts|tests/e2e/mission-attempt-launch\.spec\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/axiom/execution/attempt-submission.ts; test -f src/main/axiom/execution/candidate-snapshot.ts; test -f src/shared/axiom-contract/submission-params.ts; test -f src/main/axiom/db/candidates-store.ts; test -f src/main/axiom/db/submissions-store.ts; test -f src/main/axiom/db/verification-runs-store.ts; test -f tests/e2e/mission-attempt-submit.spec.ts; git diff --quiet main -- src/main/runtime/orchestration src/main/runtime/rpc/methods/orchestration src/renderer src/main/startup; grep -q "axiom.attempt.submit" src/shared/axiom-contract/mutations.ts; grep -q "attempt submit" src/cli/axiom-handler-groups.ts; grep -rq "settleWorkerReportInTransaction" src/main/axiom/execution; grep -rq "retainWorkerTerminalResource" src/main/axiom/execution; grep -rq "'artifact_git'" src/main/axiom/execution; test "$(git grep -n -E "reset --hard|checkout --|git clean" -- src/main/axiom/execution | grep -v "\.test\.ts" | wc -l)" -eq 0; test "$(git grep -n "'worker_done'" -- src/main/axiom/execution src/main/axiom/messaging | grep -v "\.test\.ts" | wc -l)" -eq 0; grep -q "QUEUED" src/main/axiom/db/verification-runs-store.ts; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c -E "mission-attempt-submit\.spec\.ts|axiom-test-provider\.ts|mission-attempt-launch\.spec\.ts")" -eq 0; test "$(git grep -l "@ts-nocheck" -- src/main/axiom src/shared/axiom-contract | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
