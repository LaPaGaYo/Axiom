targets: config/scripts src/shared src/renderer/src/components/feature-wall src/cli/bundled-skill-guides src/main/global-fetch-call-site-audit
extra: test "$(git grep -n -E "cloud/" -- config .github src ':!*.test.*' ':!config/vendor-egress-baseline.txt' | wc -l)" -eq 0; ! git grep -q -E "onorca\.dev" -- src/shared/feature-wall-tiles.ts src/shared/feature-wall-workflows.ts; test ! -d docs/relay-region-correction; test -f docs/review-evidence/axiom-m0/vendor-egress-baseline-notes.md; git ls-files --error-unmatch docs/review-evidence/axiom-m0/vendor-egress-baseline-notes.md; node -e "const p=require('./package.json'); if(p.license!=='MIT'||p.name!=='orca'||!/LaPaGaYo\/Axiom/.test(p.homepage)) process.exit(1)"; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(grep -c "" config/vendor-egress-baseline.txt)" -le 400
