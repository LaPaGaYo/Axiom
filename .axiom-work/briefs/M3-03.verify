targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers config/scripts/orcad-entry-build
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|tests/e2e/helpers/|tests/e2e/mission-[A-Za-z0-9._-]+\.spec\.ts|docs/reference/control-plane\.md|docs/GLOSSARY\.md|\.axiom-work/reports/M3-03-[0-9]+\.md|\.axiom-work/briefs/M3-03\.(md|verify)|\.axiom-work/verifications/M3-03-[0-9]+\.md)' | wc -l)" -eq 0; git diff --quiet main -- src/main/runtime src/main/daemon src/main/git src/main/project-groups src/cli src/renderer config mobile package.json pnpm-lock.yaml pnpm-workspace.yaml docs/decisions; test -f src/shared/axiom-contract/path-patterns.ts; grep -q "matchesPathPattern" src/shared/axiom-contract/path-patterns.ts; grep -q "isExplicitlyInScope" src/shared/axiom-contract/path-patterns.ts; grep -q "secretPatterns" src/shared/axiom-contract/verification-rules.ts; grep -q -F "**/AGENTS.md" src/shared/axiom-contract/verification-rules.ts; grep -q -F "**/.mcp.json" src/shared/axiom-contract/verification-rules.ts; grep -q -F ".github/actions/**" src/shared/axiom-contract/verification-rules.ts; grep -q -F "**/.oxlintrc*" src/shared/axiom-contract/verification-rules.ts; test -f src/main/axiom/verification/candidate-diff.ts; test -f src/main/axiom/verification/diff-gate.ts; grep -q -F -e "--no-renames" src/main/axiom/verification/candidate-diff.ts; grep -q -F -e "--submodule=short" src/main/axiom/verification/candidate-diff.ts; grep -q -F "merge-base" src/main/axiom/verification/candidate-diff.ts; grep -q "gitStreamStdout" src/main/axiom/verification/candidate-diff.ts; git grep -q "scope_violation" -- src/main/axiom/verification; git grep -q "secret_detected" -- src/main/axiom/verification; git grep -q "dangerous_change" -- src/main/axiom/verification; git grep -q "diff_too_large" -- src/main/axiom/verification; grep -q "detectSecretPatterns" src/main/axiom/context-builder/redaction.ts; grep -q "provider_token" src/main/axiom/context-builder/redaction.ts; grep -q -F "Every file left in this worktree becomes part of the Candidate." src/main/axiom/context-builder/render.ts; grep -q -F "an entry covers that path and everything below it" src/main/axiom/context-builder/planner-render.ts; grep -q "extraAllowedPaths" tests/e2e/helpers/axiom-fixture-mission.ts; grep -q "extraAllowedPaths" tests/e2e/mission-verification.spec.ts; test -f tests/e2e/mission-diff-gate.spec.ts; grep -q "scope-violation" tests/e2e/helpers/axiom-test-provider.ts; grep -q "secret-line" tests/e2e/helpers/axiom-test-provider.ts; ! grep -n -F "'REPORT.md'])]" tests/e2e/helpers/axiom-test-provider.ts; grep -q "scope_violation" docs/GLOSSARY.md; grep -q "secretPatterns" docs/reference/control-plane.md; grep -q "dangerous_change" docs/reference/control-plane.md; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! grep -n -E "\.connectionId" src/main/axiom/verification/candidate-diff.ts src/main/axiom/verification/diff-gate.ts src/main/axiom/verification/verification-checks.ts; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l)" -eq 0; ! git diff main | grep -q "^+.*@ts-nocheck"; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 226; test -f .axiom-work/reports/M3-03-1.md; ! grep -q -i "work in progress" .axiom-work/reports/M3-03-1.md
