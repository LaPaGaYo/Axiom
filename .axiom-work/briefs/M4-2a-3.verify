ntegration-scratch.ts; git grep -q "removeIntegrationLeftovers" -- src/main/axiom/integration/integration-scratch.ts; git grep -q "export async function readIntegrationGit" -- src/main/axiom/integration/integration-merge.ts; git grep -q "export async function writeIntegrationGit" -- src/main/axiom/integration/integration-merge.ts; git grep -q "mergeIntegrationCandidate" -- src/main/axiom/integration/integration-merge.ts; git grep -q "closeStaleIntegrationBatches" -- src/main/axiom/integration/integration-request.ts; git grep -q "abandonIntegration" -- src/main/axiom/integration/integration-request.ts; git grep -q "runIntegrationRegression" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; grep -q "### Integration regression" docs/reference/control-plane.md; grep -q "### Integration apply" docs/reference/control-plane.md; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -rq "advances the integration head only from the expected commit and never under a checkout" src/main/axiom/execution; grep -rq "promotes a passed batch by advancing the integration head and integrates the Task" src/main/axiom/integration; grep -rq "starts the next batch from the merge commit of the last promoted one" src/main/axiom/integration; grep -rq "starts no batch when the integration head is not the recorded one" src/main/axiom/integration; grep -rq "records a batch as promoted when the head already is its merge commit" src/main/axiom/integration; grep -rq "keeps a block or a cancellation of the Task when the head has already moved" src/main/axiom/integration; grep -rq "leaves a checked-out integration branch alone and promotes once it is free" src/main/axiom/integration; grep -rq "waits with the promotion while the Task is blocked or the Mission is paused" src/main/axiom/integration; grep -rq "keeps git inside the directory it was given" src/main/axiom/integration; git grep -q "export async functi