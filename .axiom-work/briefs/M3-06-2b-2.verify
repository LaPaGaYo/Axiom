targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|docs/reference/control-plane\.md$|docs/reference/orca-mapping\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0; ! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)'; git diff --quiet main -- docs/decisions docs/plans docs/ARCHITECTURE.md; git diff --quiet main -- src/shared src/main/runtime src/cli src/main/git src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/rate-limits src/main/startup src/main/daemon; git diff --quiet main -- src/main/axiom/scheduler src/main/axiom/agent-factory src/main/axiom/outbox src/main/axiom/mission-controller src/main/axiom/verification src/main/axiom/db src/main/axiom/execution/attempt-settlement.ts src/main/axiom/execution/attempt-interruption.ts src/main/axiom/execution/interruption-policy.ts src/main/axiom/execution/codex-rollout-limit.ts src/main/axiom/execution/attempt-failure-classification.ts src/main/axiom/execution/worktree-snapshot.ts src/main/axiom/execution/candidate-snapshot.ts src/main/axiom/execution/attempt-preservation.ts src/main/axiom/execution/attempt-exit-failure.ts; git diff --quiet main -- src/main/axiom/execution/candidate-snapshot.test.ts src/main/axiom/execution/candidate-headless-snapshot.test.ts src/main/axiom/execution/attempt-baseline.test.ts src/main/axiom/context-builder/previous-attempt.test.ts src/main/axiom/execution/attempt-exit-submission.test.ts src/main/axiom/execution/claude-exit-submission.test.ts src/main/axiom/execution/preserved-settlement.test.ts src/main/axiom/execution/preserved-launch.test.ts src/main/axiom/execution/attempt-fix-launch.test.ts; ! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts src/main/rate-limits; test "$(git grep -n -E "getAccountsSnapshot|rateLimitService|refreshRateLimits|providerActivations" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "plan_type|planType|creator_account_id|creator_user_id|has_credits" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean|branch -D|update-ref -d" -- src/main/axiom/execution src/main/axiom/context-builder src/main/axiom/recovery | grep -v "\.test\.ts" | wc -l)" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean" -- src/main/axiom | grep -v "\.test\.ts" | wc -l)" -eq 0; grep -q "planner" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "observeAgentExit" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "agentExit.evidence" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "kernel_failed" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "'declared'" src/main/axiom/recovery/attempt-reconciliation.ts; git grep -q "maxRuntimeMinutes" -- src/main/axiom/recovery ':(exclude)*.test.ts' ':(exclude)src/main/axiom/recovery/planner-reconciliation.ts'; grep -q "launch_pending_orphan" src/main/axiom/recovery/attempt-reconciliation.ts; grep -q "candidate_unchanged" src/main/axiom/execution/attempt-exit-submission.ts; grep -rq "preserves the worktree of an Attempt that ended without a Submission" src/main/axiom; grep -rq "settles a headless Attempt lost to a runtime restart as interrupted" src/main/axiom; grep -rq "\.partial-" tests/e2e/helpers; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; grep -rq "preserves a headless Attempt after its runtime budget stop is confirmed" src/main/axiom tests/e2e/helpers; grep -rq "captures the worktree only after the stop is confirmed" src/main/axiom tests/e2e/helpers; grep -rq "neither preserves nor settles while the stop is unconfirmed" src/main/axiom tests/e2e/helpers; grep -rq "preserves a headless Attempt the kernel reports stopped" src/main/axiom tests/e2e/helpers; grep -rq "preserves a headless Attempt whose process exit recovery found" src/main/axiom tests/e2e/helpers; grep -rq "settles as before when the launch record cannot be used" src/main/axiom tests/e2e/helpers; grep -rq "writes no preservation audit when another path settled the Attempt first" src/main/axiom tests/e2e/helpers; grep -rq "adopts the snapshot of an overlapping preservation of the same Attempt" src/main/axiom tests/e2e/helpers; grep -rq "continues the next Attempt from the snapshot of a stopped Attempt" src/main/axiom tests/e2e/helpers; grep -rq "tells the next Attempt that a stopped run is suspect and to review it first" src/main/axiom tests/e2e/helpers; grep -rq "does not blame a vanished process on its own error" src/main/axiom tests/e2e/helpers; grep -rq "keeps earlier records when the event stream ends mid-line" src/main/axiom tests/e2e/helpers; test -f tests/e2e/mission-budget-stop-continuation.spec.ts; grep -q "attempt.stopped" tests/e2e/mission-budget-stop-continuation.spec.ts; grep -q -E "'(runtime_budget_exceeded|timeout)'" tests/e2e/mission-budget-stop-continuation.spec.ts; grep -q "attempt.preserved" tests/e2e/mission-budget-stop-continuation.spec.ts; grep -rq "\.stall-" tests/e2e/helpers; test "$(git grep -l "kernel_stopped" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -ge 1; grep -q "kernel_stopped" docs/reference/control-plane.md; grep -q "kernel_stopped" docs/GLOSSARY.md; ls .axiom-work/reports/M3-06-2b-2-*.md
