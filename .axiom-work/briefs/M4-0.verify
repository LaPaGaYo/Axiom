targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/main/runtime/rpc/dispatcher-axiom-caller-authority.test.ts src/main/runtime/rpc/dispatcher-axiom-session-coverage.test.ts src/main/runtime/rpc/dispatcher-axiom-terminal-authority.test.ts
extra: test "$(git diff --name-only main | grep -v -E '^(src/shared/axiom-contract/lifecycle(\.test)?\.ts|src/main/axiom/mission-controller/(controller-context|mission-controller)\.ts|src/main/axiom/execution/integration-base\.ts|src/main/runtime/rpc/methods/axiom/mission\.ts|src/main/axiom/[A-Za-z0-9/_-]+\.test(-support)?\.ts|docs/reference/control-plane\.md|src/main/axiom/mission-controller/[a-z0-9-]+\.ts|\.axiom-work/reports/M4-0-[0-9]+\.md)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=MD main | grep -v -E '^(src/shared/axiom-contract/lifecycle(\.test)?\.ts|src/main/axiom/mission-controller/(controller-context|mission-controller)\.ts|src/main/axiom/execution/integration-base\.ts|src/main/runtime/rpc/methods/axiom/mission\.ts|src/main/axiom/[A-Za-z0-9/_-]+\.test(-support)?\.ts|docs/reference/control-plane\.md)$' | wc -l | tr -d ' ')" -eq 0; git diff --quiet main -- src/renderer src/cli src/preload tests package.json pnpm-lock.yaml pnpm-workspace.yaml config .github mobile; git diff --quiet main -- src/shared ':(exclude)src/shared/axiom-contract/lifecycle.ts' ':(exclude)src/shared/axiom-contract/lifecycle.test.ts'; git diff --quiet main -- src/main/runtime ':(exclude)src/main/runtime/rpc/methods/axiom/mission.ts'; git diff --quiet main -- AGENTS.md docs/decisions docs/plans docs/ARCHITECTURE.md docs/GLOSSARY.md docs/PROJECT_CONSTITUTION.md docs/STYLEGUIDE.md .oxlintrc.json .axiom-work/briefs .axiom-work/scripts .axiom-work/sidecar-union.list; test "$(git diff -w --numstat main -- src/shared/axiom-contract/lifecycle.ts | awk '{s+=$1+$2} END {print s+0}')" -le 4; test "$(git diff -w --numstat main -- src/main/axiom/mission-controller/controller-context.ts | awk '{s+=$1+$2} END {print s+0}')" -le 6; test "$(git diff -w --numstat main -- src/main/axiom/mission-controller/mission-controller.ts | awk '{s+=$1+$2} END {print s+0}')" -le 24; test "$(git diff -w --numstat main -- src/main/runtime/rpc/methods/axiom/mission.ts | awk '{s+=$1+$2} END {print s+0}')" -le 24; test "$(git diff -w --numstat main -- src/main/axiom/execution/integration-base.ts | awk '{s+=$1+$2} END {print s+0}')" -le 44; test "$(git diff main -- src/shared/axiom-contract/lifecycle.ts src/main/axiom/mission-controller/controller-context.ts src/main/axiom/mission-controller/mission-controller.ts src/main/axiom/execution/integration-base.ts src/main/runtime/rpc/methods/axiom/mission.ts | grep -c -E '^\+export ')" -eq 0; test "$(git diff main -- src/main/axiom/mission-controller/mission-controller.ts | grep -c -E '^\+import ')" -le 1; test "$(git diff main -- src/main/runtime/rpc/methods/axiom/mission.ts | grep -c -E '^\+import ')" -le 3; test "$(git diff --numstat --diff-filter=M main -- ':(glob)src/main/axiom/**/*.test.ts' ':(glob)src/main/axiom/**/*.test-support.ts' | awk '{s+=$1+$2} END {print s+0}')" -le 140; ! git diff main -- src | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git diff main -- src | grep -c -E '^\+.*(useFakeTimers|setSystemTime)')" -eq 0; ! git grep -q -E "from 'electron|import\('electron|require\('electron" -- src/main/axiom; grep -q "electron" .oxlintrc.json; git grep -q "export function isLocalVerificationRepository" -- src/main/axiom/verification/verification-checks.ts; git grep -q "export async function ensureIntegrationBase" -- src/main/axiom/execution/integration-base.ts; grep -q "ensures the integration base before starting" src/main/axiom/execution/integration-base-rpc.test.ts; grep -q "distinguishes a missing target from an unavailable integration ref" src/main/axiom/execution/integration-base.test.ts; grep -q "creates once at the target HEAD and reuses without moving the ref" src/main/axiom/execution/integration-base.test.ts; grep -q "admits exactly the Mission rows and non-terminal interruption/resume rules" src/shared/axiom-contract/lifecycle.test.ts; grep -q "starts only the three roots and rejects a second controller start as stale" src/main/axiom/mission-controller/mission-controller.test.ts; grep -q "preserves controller error codes and data" src/main/axiom/rpc-mission.test.ts; test "$(grep -c . src/main/runtime/rpc/methods/axiom/mission.ts)" -le 290; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -rq "checks that a Mission may start before it touches git or the audit" src/main/axiom src/shared/axiom-contract; grep -rq "refuses to start a Mission whose repository is not on this machine" src/main/axiom src/shared/axiom-contract; grep -rq "refuses a second Mission on a repository and target branch that another Mission occupies" src/main/axiom src/shared/axiom-contract; grep -rq "refuses to reuse an integration base that is not an ancestor of the target branch" src/main/axiom src/shared/axiom-contract; grep -rq "admits the two finalization back-edges and nothing else new" src/main/axiom src/shared/axiom-contract; grep -rq "starts a planned Mission on a local repository with a free target as before" src/main/axiom src/shared/axiom-contract; grep -rq "lets a second Mission start on another target branch or once the first has ended" src/main/axiom src/shared/axiom-contract; git grep -q "mission_target_busy" -- src/main/axiom/mission-controller/controller-context.ts; git grep -q "repository_not_local" -- src/main/axiom/mission-controller/controller-context.ts; git grep -q "is-ancestor" -- src/main/axiom/execution/integration-base.ts; git grep -q "not an ancestor" -- src/main/axiom/execution/integration-base.ts; git grep -q "isLocalVerificationRepository" -- src/main/runtime/rpc/methods/axiom/mission.ts; test "$(git grep -l "mission_target_busy" -- src/main/axiom ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | wc -l | tr -d ' ')" -ge 2; grep -q "M4-0" docs/reference/control-plane.md; grep -q "mission_target_busy" docs/reference/control-plane.md; grep -q "repository_not_local" docs/reference/control-plane.md; grep -q "is-ancestor" docs/reference/control-plane.md; ! grep -q "M2 只验证存在" docs/reference/control-plane.md; ls .axiom-work/reports/M4-0-*.md
