targets: src/main/axiom src/main/runtime/rpc/methods/orchestration src/main/runtime/orchestration src/main/runtime/rpc/methods/orchestration-structured-worker-start-failure.test.ts src/main/runtime/rpc/methods/orchestration-worker-start-mode-selection.test.ts
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/runtime/rpc/methods/orchestration/worker/(control-plane-worker-start|local-worker-start|worker-start-agent-placement|worker-worktree-creation|worker-start-readiness-settlement|deliver-worker-dispatch-preamble)\.ts|src/main/axiom/kernel-contract/control-plane-worker-start\.test\.ts|docs/reference/orca-mapping\.md|docs/reference/control-plane\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/runtime/rpc/methods/orchestration/worker/control-plane-worker-start.ts; test -f src/main/axiom/kernel-contract/control-plane-worker-start.test.ts; git diff --quiet main -- src/shared; git diff --quiet main -- src/main/runtime/rpc/methods/orchestration/worker/workers.ts; test "$(git diff --numstat main -- src/main/runtime/rpc/methods/orchestration/worker/local-worker-start.ts src/main/runtime/rpc/methods/orchestration/worker/worker-start-agent-placement.ts src/main/runtime/rpc/methods/orchestration/worker/worker-worktree-creation.ts src/main/runtime/rpc/methods/orchestration/worker/worker-start-readiness-settlement.ts src/main/runtime/rpc/methods/orchestration/worker/deliver-worker-dispatch-preamble.ts | awk "{t+=\$1+\$2} END {print t+0}")" -le 80; test "$(git grep -l "controlPlane" -- src/shared | wc -l)" -eq 0; test "$(git grep -l "@ts-nocheck" -- src/main/runtime/rpc/methods/orchestration/worker/control-plane-worker-start.ts src/main/axiom/kernel-contract/control-plane-worker-start.test.ts | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
