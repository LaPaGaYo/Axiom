targets: src/shared/product-build-identity src/shared/product-egress-policy tests/e2e/helpers/recording-proxy config/scripts/check-vendor-egress-ratchet
extra: pnpm run typecheck:e2e; test -f docs/review-evidence/axiom-m0/M0-08-egress-capture.md; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy)" | wc -l)" -eq 0; ORCA_BACKGROUND_LAUNCH=1 pnpm run test:e2e:egress-cold-start
