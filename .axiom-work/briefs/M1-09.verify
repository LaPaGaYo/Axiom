targets: src/renderer/src/components/missions src/renderer/src/lib/axiom-client.test.ts src/renderer/src/lib/missions-view.test.ts src/shared/axiom-contract src/main/ipc src/preload src/renderer/src/components/sidebar src/renderer/src/app-shell src/renderer/src/store src/main/axiom
