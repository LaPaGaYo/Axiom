targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli/specs src/cli/handlers/axiom src/main/startup src/cli/handler-group-manifest.test.ts src/cli/cli-command-name-parity.test.ts src/main/runtime/rpc/errors.test.ts src/main/runtime/rpc/methods/orchestration/messaging src/main/runtime/rpc/methods/orchestration/worker src/main/runtime/rpc/methods/orchestration/federation
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/shared/axiom-contract/(attempt-params|message-params|task-params|mutations)(\.test)?\.ts|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts|src/main/runtime/rpc/methods/axiom/(attempt|message|task)\.ts|src/main/runtime/rpc/methods/axiom\.ts|src/main/runtime/rpc/errors\.ts|src/cli/specs/(axiom-attempt|axiom-message|axiom-task|index)\.ts|src/cli/handlers/axiom/|src/cli/axiom-handler-groups\.ts|src/cli/cli-command-name-parity\.test\.ts|src/main/startup/cli-command-names\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|docs/plans/M2\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/axiom/execution/attempt-ask.ts; test -f src/main/axiom/messaging/subtask-checks.ts; test -f src/cli/specs/axiom-message.ts; git diff --quiet main -- src/main/runtime/orchestration src/main/runtime/rpc/methods/orchestration src/renderer; grep -q "axiom.attempt.ask" src/shared/axiom-contract/mutations.ts; grep -q "axiom.message.answer" src/shared/axiom-contract/mutations.ts; grep -q "axiom.message.resolve" src/shared/axiom-contract/mutations.ts; grep -q "axiom.task.create" src/shared/axiom-contract/mutations.ts; grep -q "'message'" src/main/startup/cli-command-names.ts; grep -q "message answer" src/cli/axiom-handler-groups.ts; grep -q "task create" src/cli/axiom-handler-groups.ts; grep -rq "subtaskAutoCreate" src/main/axiom/messaging; grep -rq "plan.minor_adjustment" src/main/axiom; test "$(git grep -n "createTask(" -- src/main/axiom | grep -v "\.test\.ts" | grep -v "mission-controller/" | grep -v "db\.createTask\|ctx\.db\.createTask" | wc -l)" -le 2; pnpm run verify:rpc-params-catalog; test "$(git grep -l -E "^[[:space:]]*//[[:space:]]*@ts-nocheck" -- src/main/axiom src/shared/axiom-contract | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
