targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|docs/reference/control-plane\.md$|docs/reference/orca-mapping\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0; ! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)'; git diff --quiet main -- docs/decisions docs/plans docs/ARCHITECTURE.md; git diff --quiet main -- src/shared src/main/runtime src/cli src/main/git src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/rate-limits src/main/startup src/main/daemon; git diff --quiet main -- src/main/axiom/scheduler src/main/axiom/agent-factory src/main/axiom/outbox src/main/axiom/mission-controller src/main/axiom/verification src/main/axiom/recovery src/main/axiom/db src/main/axiom/execution/attempt-settlement.ts src/main/axiom/execution/attempt-interruption.ts src/main/axiom/execution/interruption-policy.ts src/main/axiom/execution/codex-rollout-limit.ts src/main/axiom/execution/attempt-failure-classification.ts; git diff --quiet main -- src/main/axiom/execution/candidate-snapshot.test.ts src/main/axiom/execution/candidate-headless-snapshot.test.ts src/main/axiom/execution/attempt-baseline.test.ts src/main/axiom/context-builder/previous-attempt.test.ts; ! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts src/main/rate-limits; test "$(git grep -n -E "getAccountsSnapshot|rateLimitService|refreshRateLimits|providerActivations" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "plan_type|planType|creator_account_id|creator_user_id|has_credits" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean|branch -D|update-ref -d" -- src/main/axiom/execution src/main/axiom/context-builder | grep -v "\.test\.ts" | wc -l)" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean" -- src/main/axiom | grep -v "\.test\.ts" | wc -l)" -eq 0; grep -q "Fixture usage limit reached" tests/e2e/helpers/axiom-test-provider.ts; grep -q "Fixture Worker crashed" tests/e2e/helpers/axiom-test-provider.ts; grep -q "account_cooldown" tests/e2e/mission-account-cooldown.spec.ts; grep -rq "walks the baseline across an interrupted Attempt" src/main/axiom; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; test "$(git grep -l "attempt.preserved" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -ge 1; test "$(git grep -l "refs/axiom/preserved" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -ge 1; test "$(git grep -l "git-change-list" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -ge 1; grep -rq "preserves the worktree of an Attempt that ended without a Submission" src/main/axiom; grep -rq "leaves the Attempt branch and the worktree index untouched" src/main/axiom; grep -rq "records why a worktree could not be preserved and settles as before" src/main/axiom; grep -rq "continues the next Attempt from the preserved snapshot" src/main/axiom; grep -rq "does not continue a preserved snapshot that leaves the allowed paths" src/main/axiom; grep -rq "does not continue a preserved snapshot that contains a secret" src/main/axiom; grep -rq "keeps the failed Candidate evidence when a preserved fix Attempt is continued" src/main/axiom; grep -rq "takes messages and commands from the event stream of either harness" src/main/axiom; grep -rq "tells the next Attempt what it inherited and to review it first" src/main/axiom; test -f tests/e2e/mission-preserved-continuation.spec.ts; grep -q "attempt.preserved" tests/e2e/mission-preserved-continuation.spec.ts; grep -q "half-written" tests/e2e/mission-preserved-continuation.spec.ts; grep -rq "\.partial-" tests/e2e/helpers; grep -q "attempt.preserved" docs/reference/control-plane.md; grep -q "refs/axiom/preserved" docs/reference/control-plane.md; grep -q "保全快照" docs/GLOSSARY.md; grep -q "git-change-list" docs/reference/orca-mapping.md; ls .axiom-work/reports/M3-06-2b-*.md
