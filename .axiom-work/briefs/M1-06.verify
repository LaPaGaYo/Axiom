targets: src/main/axiom src/shared/axiom-contract src/shared/orchestration-rpc-contract.test.ts src/shared/protocol-version.test.ts src/main/runtime/rpc src/cli src/main/startup
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/main/runtime/rpc/methods/axiom/|src/main/runtime/rpc/methods/axiom\.ts|src/main/runtime/rpc/methods/index\.ts|src/main/runtime/rpc/errors\.ts|src/shared/axiom-contract/|src/shared/orchestration-rpc-contract(\.test)?\.ts|src/shared/protocol-version(\.test)?\.ts|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts|src/cli/|src/main/startup/cli-command-names\.ts|docs/GLOSSARY.md|docs/reference/orca-mapping.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/shared/axiom-contract/mutations.ts; git grep -q "axiom.control-plane.v1" -- src/shared/orchestration-runtime-capabilities.ts; git grep -q "axiom.mission.create" -- src/shared/rpc-contract/rpc-params-catalog.generated.ts; git grep -q -E "startsWith\(.axiom\.|axiom\." -- src/cli/runtime/client.ts; test "$(git grep -c -E "@ts-nocheck|test\.skip" -- src/main/axiom src/main/runtime/rpc/methods/axiom src/cli/handlers/axiom | wc -l)" -eq 0; test "$(git diff --name-only main | grep -F -x -f config/ts-nocheck-baseline.txt | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
