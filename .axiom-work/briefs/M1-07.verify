targets: src/main/axiom src/main/runtime/rpc src/main/runtime/orchestration/db.test.ts
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/main/runtime/rpc/methods/orchestration/(messaging/message-methods|runs/reset-methods|worker/workers|runs/dispatch-methods|messaging/send-methods|gates/gates|runs/runs)\.ts|src/main/runtime/rpc/errors\.ts|docs/reference/orca-mapping.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/axiom/admission/mission-managed-run-guard.ts; git grep -q "mission_managed" -- src/main/runtime/rpc/errors.ts; test "$(git grep -l "mission-managed-run-guard" -- src/main/runtime/rpc/methods/orchestration | wc -l)" -ge 7; test "$(git grep -c -E "^[[:space:]]*//[[:space:]]*@ts-nocheck|^[[:space:]]*(test|it|describe)\.skip\(" -- src/main/axiom | wc -l)" -eq 0; test "$(git diff --name-only main | grep -F -x -f config/ts-nocheck-baseline.txt | wc -l)" -eq 0; test "$(git diff --numstat main -- src/main/runtime/rpc/methods/orchestration | awk "{d+=\$2} END {print d+0}")" -le 20; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
