targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|docs/reference/control-plane\.md$|docs/reference/orca-mapping\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0; ! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)'; git diff --quiet main -- docs/decisions docs/plans docs/ARCHITECTURE.md; git diff --quiet main -- src/shared src/main/runtime src/cli src/main/git src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/rate-limits src/main/startup src/main/daemon src/main/orcad; git diff --quiet main -- src/main/axiom/scheduler src/main/axiom/outbox src/main/axiom/mission-controller src/main/axiom/verification src/main/axiom/recovery src/main/axiom/db src/main/axiom/context-builder/context-builder.ts src/main/axiom/context-builder/render.ts src/main/axiom/execution/attempt-baseline.ts src/main/axiom/execution/attempt-fix-launch.ts src/main/axiom/execution/preserved-snapshot.ts src/main/axiom/execution/preserved-snapshot-contract.ts src/main/axiom/execution/worktree-snapshot.ts src/main/axiom/execution/attempt-preservation.ts src/main/axiom/execution/attempt-settlement.ts src/main/axiom/execution/interruption-policy.ts src/main/axiom/execution/attempt-failure-classification.ts src/main/axiom/execution/attempt-submission.ts; test -z "$(git diff --name-only main -- src/main/axiom/agent-factory | grep -v -E '^src/main/axiom/agent-factory/certified-providers[.a-z-]*\.ts$')"; git diff --quiet main -- src/main/axiom/execution/attempt-baseline.test.ts src/main/axiom/execution/preserved-baseline.test.ts src/main/axiom/execution/preserved-recovery-baseline.test.ts src/main/axiom/execution/preserved-settlement.test.ts src/main/axiom/execution/preserved-launch.test.ts src/main/axiom/execution/attempt-fix-launch.test.ts src/main/axiom/execution/attempt-interruption.test.ts src/main/axiom/execution/codex-rollout-limit.test.ts src/main/axiom/execution/codex-rollout-settlement.test.ts src/main/axiom/execution/attempt-exit-submission.test.ts src/main/axiom/execution/claude-exit-submission.test.ts src/main/axiom/context-builder/previous-attempt.test.ts src/main/axiom/context-builder/previous-preserved-attempt.test.ts src/main/axiom/context-builder/previous-preserved-chain.test.ts src/main/axiom/context-builder/previous-preserved-recovery.test.ts; git diff --quiet main -- tests/e2e/mission-budget-stop-continuation.spec.ts tests/e2e/mission-interrupted-continuation.spec.ts tests/e2e/mission-preserved-continuation.spec.ts tests/e2e/mission-daemon-lost-continuation.spec.ts tests/e2e/mission-account-cooldown.spec.ts tests/e2e/mission-headless-worker.spec.ts tests/e2e/helpers/axiom-partial-work.ts tests/e2e/helpers/axiom-codex-rollout.ts tests/e2e/helpers/axiom-fixture-inspection.ts tests/e2e/helpers/axiom-fixture-restart.ts; test "$(git diff --numstat main -- tests/e2e/helpers/axiom-test-provider.ts | awk '{s+=$1+$2} END {print s+0}')" -le 16; test "$(git diff --numstat main -- src/main/axiom/context-builder/previous-preserved-attempt.ts src/main/axiom/execution/preserved-baseline.ts | awk '{s+=$1+$2} END {print s+0}')" -le 8; ! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts src/main/rate-limits; test "$(git grep -n -E "getAccountsSnapshot|rateLimitService|refreshRateLimits|providerActivations" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "plan_type|planType|creator_account_id|creator_user_id|has_credits" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean|branch -D|update-ref -d" -- src/main/axiom/execution src/main/axiom/context-builder src/main/axiom/recovery | grep -v "\.test\.ts" | wc -l)" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean" -- src/main/axiom | grep -v "\.test\.ts" | wc -l)" -eq 0; test "$(git grep -n -E "session_too_long|SESSION_RESUME_MAX" -- src/main/axiom | wc -l)" -eq 0; test "$(grep -c "provider: '" src/main/axiom/agent-factory/certified-providers.ts)" -eq 4; grep -A12 "provider: 'claude'" src/main/axiom/agent-factory/certified-providers.ts | grep -q "status: 'certified'"; grep -q "retryOf" src/main/axiom/execution/attempt-launcher.ts; grep -rq "settleAttemptWithoutSubmission" src/main/axiom/execution/attempt-launcher.ts; grep -q "workspace-write" src/main/axiom/execution/headless-worker-command.ts; test "$(grep -c -E 'dangerously-bypass|full-auto' src/main/axiom/execution/headless-worker-command.ts)" -eq 0; grep -q "Fixture usage limit reached" tests/e2e/helpers/axiom-test-provider.ts; grep -rq "\.partial-" tests/e2e/helpers; grep -rq "\.rollout-" tests/e2e/helpers; test "$(git grep -l "axiom-test-provider" -- src | wc -l)" -eq 0; grep -rq "codex-cli 0.0.0-e2e" tests/e2e/helpers; grep -rq "continues the next Attempt from the snapshot of an Attempt lost with its daemon" src/main/axiom tests/e2e/helpers; grep -rq "settles a headless Attempt lost to a runtime restart as interrupted" src/main/axiom; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; grep -rq "continues an interrupted Codex Attempt in its own worktree and resumes its session" src/main/axiom tests/e2e/helpers; grep -rq "continues in place when the interrupted Attempt changed nothing" src/main/axiom tests/e2e/helpers; grep -rq "continues in place after a restart in which the host saw the process exit" src/main/axiom tests/e2e/helpers; grep -rq "keeps continuing in place across Attempts that resumed the same session" src/main/axiom tests/e2e/helpers; grep -rq "starts a new worktree and session when the previous Attempt was stopped or failed" src/main/axiom tests/e2e/helpers; grep -rq "starts a new worktree and session when only the kernel reported the terminal missing" src/main/axiom tests/e2e/helpers; grep -rq "starts a new worktree and session when the snapshot cannot be continued" src/main/axiom tests/e2e/helpers; grep -rq "starts a new worktree and session when the agent or the account home changed" src/main/axiom tests/e2e/helpers; grep -rq "starts a new worktree and session when the harness version has no resume evidence" src/main/axiom tests/e2e/helpers; grep -rq "starts a new worktree and session when the Task contract changed" src/main/axiom tests/e2e/helpers; grep -rq "starts a new worktree and session when the session record is gone" src/main/axiom tests/e2e/helpers; grep -rq "starts a new worktree and session when the worktree no longer equals the snapshot" src/main/axiom tests/e2e/helpers; grep -rq "starts a new worktree and session after a refused resume" src/main/axiom tests/e2e/helpers; grep -rq "moves the reused worktree to the new Attempt branch without changing a file" src/main/axiom tests/e2e/helpers; grep -rq "builds the Codex resume command with the exec options before resume" src/main/axiom tests/e2e/helpers; grep -rq "delivers the continuation prompt and keeps the full contract in the worktree" src/main/axiom tests/e2e/helpers; grep -rq "settles a refused resume at once without counting it toward the interruption chain" src/main/axiom tests/e2e/helpers; grep -rq "marks the usage of a resumed Attempt as session totals" src/main/axiom tests/e2e/helpers; grep -rq "looks for the rollout of a resumed session from the day the session began" src/main/axiom tests/e2e/helpers; grep -rq "finds a session record that Codex archived as jsonl.zst" src/main/axiom tests/e2e/helpers; test -f tests/e2e/mission-in-place-continuation.spec.ts; grep -q "resumed_in_place" tests/e2e/mission-in-place-continuation.spec.ts; grep -q "resume_refused" tests/e2e/mission-in-place-continuation.spec.ts; grep -q "attempt.preserved" tests/e2e/mission-in-place-continuation.spec.ts; grep -rq "refuse-resume" tests/e2e/helpers; grep -rq "no rollout found for thread id" tests/e2e/helpers; test "$(git grep -l "resumed_in_place" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -ge 1; test "$(git grep -l "resume_refused" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -ge 1; grep -q "codex-cli 0.163.0" src/main/axiom/agent-factory/certified-providers.ts; grep -q "M3-06-2c-resume-refusal-probe" src/main/axiom/agent-factory/certified-providers.ts; grep -q "M3-06-2-resume-probe" src/main/axiom/agent-factory/certified-providers.ts; grep -q "resumed_in_place" docs/reference/control-plane.md; grep -q "resume_refused" docs/reference/control-plane.md; grep -q "resumed_in_place" docs/GLOSSARY.md; grep -q "原地续" docs/GLOSSARY.md; ls .axiom-work/reports/M3-06-2c-*.md
