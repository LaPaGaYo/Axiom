targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/main/runtime/rpc/methods/orchestration src/main/runtime/rpc/dispatcher-axiom-caller-authority.test.ts src/main/runtime/rpc/dispatcher-axiom-session-coverage.test.ts src/main/runtime/rpc/dispatcher-axiom-terminal-authority.test.ts src/main/runtime/orchestration src/cli/handlers/axiom src/cli/axiom-verification.test.ts
extra: test "$(git diff --no-renames --name-only main | grep -v -E '^(src/main/axiom/schema-support\.ts|src/main/axiom/schema-support\.test\.ts|tests/e2e/mission-schema-newer\.spec\.ts|\.axiom-work/reports/SCHEMA-2-[0-9]+\.md|src/main/axiom/control-plane\.ts|src/main/axiom/control-plane-boot\.ts|src/main/axiom/mission-controller/controller-context\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=A main | grep -v -E '^(src/main/axiom/schema-support\.ts|src/main/axiom/schema-support\.test\.ts|tests/e2e/mission-schema-newer\.spec\.ts|\.axiom-work/reports/SCHEMA-2-[0-9]+\.md)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=MRT main | grep -v -E '^(src/main/axiom/control-plane\.ts|src/main/axiom/control-plane-boot\.ts|src/main/axiom/mission-controller/controller-context\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=D main | wc -l | tr -d ' ')" -eq 0; git diff --quiet main -- src/renderer src/cli src/preload src/shared src/main/runtime src/main/git src/main/sqlite src/main/startup src/main/orcad package.json pnpm-lock.yaml pnpm-workspace.yaml config .github mobile; git diff --quiet main -- tests ':(exclude)tests/e2e/mission-schema-newer.spec.ts'; git diff --quiet main -- AGENTS.md docs/decisions docs/plans docs/ARCHITECTURE.md docs/GLOSSARY.md docs/PROJECT_CONSTITUTION.md docs/STYLEGUIDE.md .oxlintrc.json .axiom-work/briefs .axiom-work/scripts .axiom-work/sidecar-union.list .axiom-work/sidecar-union.retired; test "$(git diff --numstat main -- src/main/axiom/control-plane.ts | awk '{s+=$1+$2} END {print s+0}')" -le 2; test "$(git diff main -- src/main/axiom/control-plane.ts | grep -c -E '^-[^-]')" -eq 0; test "$(git diff --numstat main -- src/main/axiom/mission-controller/controller-context.ts | awk '{s+=$1+$2} END {print s+0}')" -le 3; test "$(git diff --numstat main -- src/main/axiom/control-plane-boot.ts | awk '{s+=$1+$2} END {print s+0}')" -le 45; test "$(git diff --name-only --diff-filter=MRT main -- src | grep -E '(\.test\.tsx?|test-support\.ts)$' | wc -l | tr -d ' ')" -eq 0; git grep -q "export function readAxiomSchemaVersion" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "export const AXIOM_SCHEMA_VERSION" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; grep -q "### Axiom schema version" docs/reference/control-plane.md; git grep -q "stopHeadlessAttemptWatchers(runtime)" -- src/main/axiom/control-plane-boot.ts; git grep -q "ATTEMPT_RECONCILE_INTERVAL_MS" -- src/main/axiom/control-plane-boot.ts; git grep -q "sweepExecutingMissions" -- src/main/axiom/control-plane-boot.ts; test "$(git diff main -- docs/reference/control-plane.md docs/reference/orca-mapping.md | grep -c -E '^-#')" -eq 0; test "$(git diff --numstat main -- docs/reference/orca-mapping.md | awk '{s+=$1+$2} END {print s+0}')" -le 6; grep -q "### 4b. " docs/reference/orca-mapping.md; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src tests | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -q "a database stamped by a newer Axiom gets no Control Plane" src/main/axiom/schema-support.test.ts; grep -q "a database at the Axiom schema version of this build gets its Control Plane as before" src/main/axiom/schema-support.test.ts; grep -q "an axiom request on a newer database answers the refusal with its reason and next step" src/main/axiom/schema-support.test.ts; grep -q "kernel verbs that must ask whether a Mission owns the Run are refused on a newer database" src/main/axiom/schema-support.test.ts; grep -q "start leaves a newer database alone and stop does not throw" src/main/axiom/schema-support.test.ts; grep -q "an error that is not the refusal is thrown on by start and stop" src/main/axiom/schema-support.test.ts; git grep -q "export function assertAxiomSchemaSupported" -- src/main/axiom/schema-support.ts; git grep -q "export function isAxiomSchemaNewer" -- src/main/axiom/schema-support.ts; git grep -q -F "'axiom_schema_newer'" -- src/main/axiom/schema-support.ts; git grep -q "readAxiomSchemaVersion" -- src/main/axiom/schema-support.ts; git grep -q "AXIOM_SCHEMA_VERSION" -- src/main/axiom/schema-support.ts; git grep -q "written by a newer Axiom" -- src/main/axiom/schema-support.ts; git grep -q "nextSteps" -- src/main/axiom/schema-support.ts; git grep -q "MissionControllerError" -- src/main/axiom/schema-support.ts; test "$(grep -c . src/main/axiom/schema-support.ts)" -le 30; git grep -q -F "'axiom_schema_newer'" -- src/main/axiom/mission-controller/controller-context.ts; git grep -q "assertAxiomSchemaSupported(db)" -- src/main/axiom/control-plane.ts; git grep -q "isAxiomSchemaNewer" -- src/main/axiom/control-plane-boot.ts; git grep -q -F "[axiom] Control Plane not started: database written by a newer Axiom" -- src/main/axiom/control-plane-boot.ts; test "$(git grep -l "assertAxiomSchemaSupported" -- src ':(exclude)*.test.ts' | wc -l | tr -d ' ')" -eq 2; grep -q -F "from '../runtime/orchestration/db'" src/main/axiom/schema-support.test.ts; grep -q "SCHEMA-2: a database a newer Axiom wrote is left alone and the app still works" tests/e2e/mission-schema-newer.spec.ts; grep -q "createRestartSession" tests/e2e/mission-schema-newer.spec.ts; grep -q "ORCA_BACKGROUND_LAUNCH" tests/e2e/mission-schema-newer.spec.ts; grep -q "axiom_schema_newer" tests/e2e/mission-schema-newer.spec.ts; grep -q "written by a newer Axiom" tests/e2e/mission-schema-newer.spec.ts; grep -q -F "orchestration.db" tests/e2e/mission-schema-newer.spec.ts; grep -q "repo.add" tests/e2e/mission-schema-newer.spec.ts; test "$(grep -c . tests/e2e/mission-schema-newer.spec.ts)" -le 120; grep -q "### Newer Axiom schema" docs/reference/control-plane.md; grep -q "axiom_schema_newer" docs/reference/control-plane.md; grep -q "assertAxiomSchemaSupported" docs/reference/control-plane.md; ! grep -q -F "尚无代码读取印记" docs/reference/control-plane.md; ! grep -q -F "留给 SCHEMA-2" docs/reference/control-plane.md; grep -q "axiom_schema_newer" docs/reference/orca-mapping.md; ls .axiom-work/reports/SCHEMA-2-*.md
