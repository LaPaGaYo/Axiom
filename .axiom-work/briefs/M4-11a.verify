penQuestions': 'No question or gate is pending on an unfinished Task and no approval blocks the Mission', 'gateGoalCriteriaCovered': 'Every acceptance criterion of the Goal is covered by an integrated Task', 'gateLimitationsRecorded': 'The submission of every integrated Task is on record', 'stopTargetBranchMoved': 'The target branch has commits the integration branch does not contain', 'stopTargetBranchNotFound': 'The local target branch was not found', 'stopIntegrationHeadUnexpected': 'The integration branch is not at the commit the Control Plane recorded', 'stopCompletionGateFailed': 'At least one completion gate item did not pass', 'stopFinalizationUnavailable': 'Finalization could not read the repository or store the report after three tries', 'riskBypassPosture': 'An Attempt ran as a terminal agent, not in the headless sandbox', 'riskHumanResolvedVerification': 'A person resolved the verification of this Task', 'finalization': 'Finalization', 'finalizationPassed': 'All completion gate items passed', 'finalizationRecorded': 'Recorded', 'finalizationTargetHead': 'Target head', 'finalizationIntegrationHead': 'Integration head', 'completionGate': 'Completion gate', 'gateItem': 'Item', 'gateEvidence': 'Evidence', 'gateDetail': 'Detail', 'gatePassed': 'Passed', 'gateNotPassed': 'Not passed', 'gateEvidenceCount': '{{total}} reference(s)', 'gateNotEvaluated': 'The completion gate was not evaluated.', 'reportArtifact': 'Report artifact', 'showReport': 'Show report', 'hideReport': 'Hide report', 'loadingReport': 'Loading the report…', 'reportReadFailed': 'The completion report could not be read.', 'reportHashMismatch': 'The stored report is not the one this finalization recorded.', 'noCompletionReport': 'This finalization recorded no completion report.', 'completionReport': 'Completion report', 'reportConstraints': 'Constraints', 'reportCriteria': 'Criteria and the Tasks that cover them', 'reportCriterion': 'Criterion', 'reportCoveredBy': 'Covered by', 'reportTasks': 'Tasks in the report', 'reportRegression': 'Regression', 'reportChecksPassed': '{{passed}} of {{total}} check(s) passed', 'reportResolvedByPerson': 'Resolved by a person: {{verdict}}', 'reportCanceled': 'Canceled: {{rationale}}', 'reportWorkerSummary': 'Worker summary', 'reportOpenQuestions': 'Open questions', 'reportRecordedRisks': 'Risks the Control Plane recorded', 'reportNoRecordedRisks': 'The Control Plane recorded no risk.', 'reportAttemptSeq': 'Attempt {{seq}}', 'reportPlans': 'Plans', 'reportPlanRevision': 'Plan revision {{revision}}', 'reportMitigation': 'Mitigation: {{text}}', 'reportCommits': 'Commits', 'reportPromoted': 'Promoted commits', 'reportDecisions': '{{total}} decision(s) recorded', 'showRawReport': 'Show raw JSON', 'hideRawReport': 'Hide raw JSON'}.items())))(__import__('json').load(open('src/renderer/src/i18n/locales/en.json', encoding='utf-8'))['missions'])"; python3 -I -c "assert (lambda d: all(map(lambda k: isinstance(d.get(k), str) and max(map(ord, d[k])) > 0x2e7f, 'gateTasksSettled gateCandidatesVerified gateBatchesPromoted gateIntegrationHeadRecorded gateTargetBranchContained gateNoOpenQuestions gateGoalCriteriaCovered gateLimitationsRecorded stopTargetBranchMoved stopTargetBranchNotFound stopIntegrationHeadUnexpected stopCompletionGateFailed stopFinalizationUnavailable riskBypassPosture riskHumanResolvedVerification finalization finalizationPassed finalizationRecorded finalizationTargetHead finalizationIntegrationHead completionGate gateItem gateEvidence gateDetail gatePassed gateNotPassed gateEvidenceCount gateNotEvaluated reportArtifact showReport hideReport loadingReport reportReadFailed reportHashMismatch noCompletionReport completionReport reportConstraints reportCriteria reportCriterion reportCoveredBy reportTasks reportRegression reportChecksPassed reportResolvedByPerson reportCanceled reportWorkerSummary reportOpenQuestions reportRecordedRisks reportNoRecordedRisks reportAttemptSeq reportPlans reportPlanRevision reportMitigation reportCommits reportPromoted reportDecisions showRawReport hideRawReport'.split())))(__import__('json').load(open('src/renderer/src/i18n/locales/zh.json', encoding='utf-8'))['missions'])"; git grep -q -F -e "completion-report-sha" -- tests/e2e/mission-integration.spec.ts; git grep -q -F -e "data-finalization-outcome" -- tests/e2e/mission-integration.spec.ts; git grep -q -F -e "data-gate-pass" -- tests/e2e/mission-integration.spec.ts; git grep -q -F -e "Show report" -- tests/e2e/mission-integration.spec.ts; git grep -q -F -e "data-report-task-id" -- tests/e2e/mission-integration.spec.ts; git grep -q -F -e "Completion gate" -- tests/e2e/mission-integration.spec.ts; git grep -q -F -e "data-finalization-outcome" -- tests/e2e/mission-finalization.spec.ts; git grep -q -F -e "Show report" -- tests/e2e/mission-finalization.spec.ts; git grep -q -F -e "The completion gate was not evaluated." -- tests/e2e/mission-finalization.spec.ts; grep -q -F "### Mission 页的收尾记录与完成报告（M4-11a）" docs/reference/control-plane.md; python3 -I -c "assert (lambda t: 0 < t.find('### Mission 页的集成块与 Task 页的合并树回归（M4-5b）') < t.find('### Mission 页的收尾记录与完成报告（M4-11a）') < t.find('### 人工验证处置与同候选重验'))(open('docs/reference/control-plane.md', encoding='utf-8').read())"; python3 -I -c "assert (lambda t: (lambda s: all(map(lambda w: w in s, ['MissionFinalization.tsx', 'MissionReport.tsx', 'finalizationGateLabel', 'completionReportText', 'axiom.artifact.read', 'axiom.mission.show', 'reportSha256', 'M4-11b', 'D94'])))(t[t.find('### Mission 页的收尾记录与完成报告（M4-11a）'):t.find('### 人工验证处置与同候选重验')]))(open('docs/reference/control-plane.md', encoding='utf-8').read())"; ! grep -q -F "渲染与查看入口在 M4-11" docs/reference/control-plane.md; ls .axiom-work/reports/M4-11a-*.md
