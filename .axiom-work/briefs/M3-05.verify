targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts$|src/main/runtime/rpc/methods/axiom/|src/cli/|docs/reference/control-plane\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)';git diff --quiet main -- docs/decisions docs/plans;git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/startup src/main/daemon src/main/git src/main/runtime/orchestration;test "$(git diff --name-only main -- src/main/runtime | grep -v '^src/main/runtime/rpc/methods/axiom/' | wc -l)" -eq 0;grep -q "HUMAN_REVIEW" src/main/axiom/verification/verification-settlement.ts;grep -q "verification.escalated" src/main/axiom/verification/verification-settlement.ts;! git diff main -- src/main/axiom | grep -E "^\+.*status: 'SPECIALIST_REVIEW'";test -f src/main/axiom/verification/verification-resolution.ts;grep -q secret_in_rationale src/main/axiom/verification/verification-resolution.ts;grep -q deterministic_verdict_final src/main/axiom/verification/verification-resolution.ts;grep -q "verification.resolved" src/main/axiom/verification/verification-resolution.ts;test -f src/main/axiom/verification/verification-rerun.ts;grep -q "verification.rerun_requested" src/main/axiom/verification/verification-rerun.ts;grep -q task_not_rerunnable src/main/axiom/verification/verification-rerun.ts;grep -q acceptanceCriteria src/main/axiom/mission-controller/task-adjustment.ts;grep -q acceptanceCriteria src/shared/axiom-contract/task-params.ts;grep -q "VerificationResolveParams" src/shared/axiom-contract/verification-params.ts;grep -q "VerificationRerunParams" src/shared/axiom-contract/verification-params.ts;grep -q "axiom.verification.resolve" src/main/runtime/rpc/methods/axiom/verification.ts;grep -q "axiom.verification.rerun" src/main/runtime/rpc/methods/axiom/verification.ts;grep -q "axiom.verification.resolve" src/main/axiom/authority/caller-authority.ts;grep -q "axiom.verification.rerun" src/main/axiom/authority/caller-authority.ts;grep -q "axiom.verification.resolve" src/shared/axiom-contract/mutations.ts;grep -q "axiom.verification.rerun" src/shared/axiom-contract/mutations.ts;grep -q "a human judged this failed" src/main/axiom/context-builder/previous-acceptance.ts;grep -q "resolution" src/main/axiom/context-builder/previous-acceptance.ts;grep -q "verification resolve" src/cli/specs/axiom-verification.ts;grep -q "verification rerun" src/cli/specs/axiom-verification.ts;grep -q "acceptance" src/cli/specs/axiom-task.ts;grep -rq --include='mission-*.spec.ts' "axiom.verification.resolve" tests/e2e;grep -rq --include='mission-*.spec.ts' "axiom.verification.rerun" tests/e2e;grep -rq --include='mission-*.spec.ts' "deterministic_verdict_final" tests/e2e;grep -rq --include='mission-*.spec.ts' "HUMAN_REVIEW" tests/e2e;grep -q "verification.resolved" docs/reference/control-plane.md;grep -q "HUMAN_REVIEW" docs/reference/control-plane.md;grep -q "verification.rerun" docs/reference/control-plane.md;grep -q "verification.resolved" docs/GLOSSARY.md;grep -q "HUMAN_REVIEW" docs/GLOSSARY.md;pnpm run verify:rpc-params-catalog;! git diff main -- src/main/axiom | grep -E '^\+.*(DecisionEngine|decision-engine)';! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;ls .axiom-work/reports/M3-05-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
