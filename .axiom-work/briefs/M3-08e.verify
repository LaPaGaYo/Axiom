targets: src/main/axiom src/main/codex src/main/codex-accounts src/main/codex-cli src/main/skills src/main/runtime/session-tabs/structured-session src/main/runtime/rpc/methods/orchestration/worker tests/e2e/helpers config/scripts/axiom-docs-terminology config/scripts/orcad-entry-build
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/main/codex/|src/main/codex-accounts/|src/main/codex-cli/|src/main/skills/|src/main/runtime/session-tabs/structured-session-account-home[A-Za-z0-9._-]*\.ts|src/main/runtime/rpc/methods/orchestration/worker/control-plane-worker-start[A-Za-z0-9._-]*\.ts|tests/e2e/mission-headless-worker\.spec\.ts|tests/e2e/helpers/axiom-test-provider[A-Za-z0-9._-]*\.ts|docs/reference/agent-account-homes\.md|docs/reference/control-plane\.md|\.axiom-work/reports/M3-08e-[0-9]+\.md|\.axiom-work/briefs/M3-08e\.(md|verify)|\.axiom-work/verifications/M3-08e-[0-9]+\.md)' | wc -l)" -eq 0; git diff --quiet main -- src/renderer src/main/orcad src/main/daemon src/main/git src/shared config/patches mobile package.json pnpm-lock.yaml pnpm-workspace.yaml docs/decisions; test "$(git diff main -- src/main/runtime ':(exclude)*.test.ts' | grep -c -E '^[-+][^-+]')" -le 40; test "$(git diff main -- src/main src/shared ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | grep -c -E '^[-+][^-+]')" -le 700; test -f src/main/codex/codex-worker-launch-home.ts; test -f src/main/codex/codex-worker-launch-home.test.ts; grep -q "withCodexHomeProcessLock" src/main/codex/codex-worker-launch-home.ts; grep -q "refreshToken: true" src/main/codex/codex-worker-launch-home.ts; grep -q "layoutCodexAccountHome" src/main/codex/codex-worker-launch-home.ts; ! grep -n -E "console\.(log|info|warn|error)" src/main/codex/codex-worker-launch-home.ts; grep -q -F "features.hooks=false" src/main/axiom/execution/headless-worker-command.ts; grep -q "exec" src/main/axiom/execution/headless-worker-command.ts; grep -q "workspace-write" src/main/axiom/execution/headless-worker-command.ts; ! grep -q -E "dangerously-bypass|full-auto" src/main/axiom/execution/headless-worker-command.ts; test "$(git grep -l "combination" -- src/main/axiom/execution | grep -v -E "\.test\.ts$" | wc -l)" -ge 1; test "$(git grep -l "attempt.launch_mismatch" -- src/main/axiom | grep -v -E "\.test\.ts$" | wc -l)" -ge 1; grep -q "selectWorkerProvider" src/main/axiom/agent-factory/agent-factory.ts; grep -q "releaseLocalWorker" src/main/axiom/execution/attempt-worker-release.ts; ! grep -n "stopLocalWorker" src/main/axiom/execution/attempt-worker-release.ts; grep -q "attempt_failed" src/main/axiom/execution/attempt-worker-release.ts; grep -q "resolveCodexHomeForWorkerLaunch" src/main/runtime/session-tabs/structured-session-account-home.ts; grep -q -F "features.hooks=false" tests/e2e/mission-headless-worker.spec.ts; grep -q "terminal_released" tests/e2e/mission-headless-worker.spec.ts; grep -q -e "--version" tests/e2e/helpers/axiom-test-provider.ts; grep -q -F "features.hooks=false" docs/reference/agent-account-homes.md; grep -q "launch_mismatch" docs/reference/control-plane.md; ! git diff main -- src tests | grep -q "^+.*@ts-nocheck"; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 226; test "$(pnpm run typecheck:e2e 2>&1 | grep -c -E "mission-headless-worker\.spec\.ts|axiom-test-provider\.ts")" -eq 0; test -f .axiom-work/reports/M3-08e-1.md; ! grep -q -i "work in progress" .axiom-work/reports/M3-08e-1.md
