targets: src/main/codex src/main/codex-accounts src/main/agent-hooks src/main/agent-trust-presets src/main/agent-workspace-trust src/main/execution-host-workspace-trust src/main/ipc/pty/spawn-options-assembly src/main/runtime/structured-agent src/main/session-tabs/structured-session src/main/startup/codex src/main/skills src/shared/global-settings config/scripts/orcad-entry-build config/scripts/axiom-docs-terminology
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/codex/|src/main/codex-accounts/|src/main/agent-hooks/|src/main/agent-trust-presets(\.test)?\.ts|src/main/agent-workspace-trust[A-Za-z0-9._-]*\.ts|src/main/execution-host-workspace-trust(\.test)?\.ts|src/main/ipc/pty/spawn-options-assembly[A-Za-z0-9._-]*\.ts|src/main/ipc/pty/host-env/|src/main/runtime/structured-agent-[A-Za-z0-9._-]*\.ts|src/main/session-tabs/structured-session-account-home[A-Za-z0-9._-]*\.ts|src/main/startup/codex-[A-Za-z0-9._-]*\.ts|src/main/skills/|src/shared/global-settings[A-Za-z0-9._-]*\.ts|src/shared/default-global-settings[A-Za-z0-9._-]*\.ts|docs/reference/agent-account-homes\.md|docs/reference/control-plane\.md|\.axiom-work/reports/M3-08c-[0-9]+\.md|\.axiom-work/briefs/M3-08c\.(md|verify)|\.axiom-work/verifications/M3-08c-[0-9]+\.md)' | wc -l)" -eq 0; git diff --quiet main -- src/renderer src/main/axiom src/main/orcad src/main/daemon src/main/git config/patches mobile package.json pnpm-lock.yaml pnpm-workspace.yaml docs/decisions; test "$(git diff main -- src/main src/shared ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | grep -c -E '^[-+][^-+]')" -le 900; test -f src/main/codex/codex-account-home-layout.ts; test -f src/main/codex/codex-account-home-layout.test.ts; test "$(git grep -l "layoutCodexAccountHome" -- src/main/codex-accounts | wc -l)" -ge 1; ! grep -q -F "syncSystemCodexResourcesIntoManagedHome(perAccountHome)" src/main/codex-accounts/runtime-home-service-managed-home.ts; grep -q "reconcileCodexAccountHomeHook" src/main/codex/codex-runtime-home-launch-preparation.ts; grep -q "codexAccountHomeAllowlist" src/shared/global-settings-types.ts; grep -q "codexAccountHomeAllowlist" src/shared/default-global-settings.ts; grep -q -F "skills.config" src/main/codex/codex-account-home-layout.ts; test -f docs/reference/agent-account-homes.md; grep -q "D83" docs/reference/agent-account-homes.md; ! git diff main -- src tests | grep -q "^+.*@ts-nocheck"; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 226; test -f .axiom-work/reports/M3-08c-1.md; ! grep -q -i "work in progress" .axiom-work/reports/M3-08c-1.md
