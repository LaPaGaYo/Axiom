ion assertRecordedIntegrationHead" -- src/main/axiom/integration/integration-head.ts; git grep -q "export async function integrationRepository" -- src/main/axiom/integration/integration-head.ts; git grep -q "integration_head_unexpected" -- src/main/axiom/integration/integration-head.ts; git grep -q -F "integration.batch_promoted" -- src/main/axiom/integration/integration-head.ts; git grep -q -F "integration.base_created" -- src/main/axiom/integration/integration-head.ts; git grep -q -F "integration.base_reused" -- src/main/axiom/integration/integration-head.ts; git grep -q "export function taskList" -- src/main/axiom/read-models/task-reads.ts; git grep -q "export function taskShow" -- src/main/axiom/read-models/task-reads.ts; git grep -q "taskWaitingOn(ctx, task)" -- src/main/axiom/read-models/task-reads.ts; git grep -q "M4-2b: a verified Task is integrated and its dependent Task runs from the new head" -- tests/e2e/mission-integration.spec.ts; git grep -q "runIntegration: true" -- tests/e2e/mission-integration.spec.ts; grep -q "### Integration requests" docs/reference/control-plane.md; grep -q "### Scheduler sweep" docs/reference/control-plane.md; test "$(git diff main -- docs/reference/control-plane.md docs/reference/orca-mapping.md | grep -c -E '^-#')" -eq 0; ! git grep -q -E "rev-parse|gitExecFileAsync|child_process|getAxiomControlPlane" -- src/main/axiom/read-models/integration-reads.ts; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src tests | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -q "a Task that no batch names has no integration" src/main/axiom/read-models/integration-reads.test.ts; grep -q "a Task carries its latest batch" src/main/axiom/read-models/integration-reads.test.ts; grep -q "a conflicted batch keeps its paths after its candidate was superseded" src/main/axiom/read-models/integration-reads.test.ts; grep -q "the mission carries its integration branch and recorded head" src/main/axiom/read-models/integration-reads.test.ts; grep -q "the head a reader shows is the head a batch start accepts" src/main/axiom/read-models/integration-reads.test.ts; grep -q "responses without the new fields still parse" src/main/axiom/read-models/integration-reads.test.ts; git grep -q "export const TaskIntegrationSchema" -- src/shared/axiom-contract/integration-batch.ts; git grep -q "export type TaskIntegration" -- src/shared/axiom-contract/integration-batch.ts; git grep -q "export const MissionIntegrationSchema" -- src/shared/axiom-contract/integration-batch.ts; git grep -q "export type MissionIntegration" -- src/shared/axiom-contract/integration-batch.ts; git grep -q "recordedHead" -- src/shared/axiom-contract/integration-batch.ts; git grep -q -F "TaskIntegrationSchema.optional()" -- src/shared/axiom-contract/task-params.ts; git grep -q -F "MissionIntegrationSchema.optional()" -- src/shared/axiom-contract/mission-params.ts; git grep -q "export function recordedIntegrationHead" -- src/main/axiom/integration/integration-head.ts; test "$(grep -c "recordedIntegrationHead(" src/main/axiom/integration/integration-head.ts)" -ge 2; git grep -q "export function taskIntegrations" -- src/main/axiom/read-models/integration-reads.ts; git grep -q "export function missionIntegration" -- src/main/axiom/read-models/integration-reads.ts; git grep -q "listIntegrationBatches" -- src/main/axiom/read-models/integration-reads.ts; git grep -q "listCandidates" -- src/main/axiom/read-models/integration-reads.ts; git grep -q "integrationHeadRef" -- src/main/axiom/read-models/integration-reads.ts; git grep -q "recordedIntegrationHead" -- src/main/axiom/read-models/integration-reads.ts; git grep -q "utcTimestamp" -- src/main/axiom/read-models/integration-reads.ts; test "$(grep -c . src/main/axiom/read-models/integration-reads.ts)" -le 60; git grep -q "taskIntegrations(" -- src/main/axiom/read-models/task-reads.ts; git grep -q "missionIntegration(" -- src/main/runtime/rpc/methods/axiom/mission.ts; git grep -q "desktopCall" -- tests/e2e/mission-integration.spec.ts; git grep -q -F "axiom.task.list" -- tests/e2e/mission-integration.spec.ts; git grep -q -F "axiom.mission.show" -- tests/e2e/mission-integration.spec.ts; git grep -q "PROMOTED" -- tests/e2e/mission-integration.spec.ts; git grep -q "recordedHead" -- tests/e2e/mission-integration.spec.ts; grep -q "### Integration read model" docs/reference/control-plane.md; grep -q "TaskIntegrationSchema" docs/reference/control-plane.md; grep -q "MissionIntegrationSchema" docs/reference/control-plane.md; grep -q "recordedIntegrationHead" docs/reference/control-plane.md; grep -q "taskIntegrations" docs/reference/control-plane.md; grep -q "missionIntegration" docs/reference/control-plane.md; ! grep -q -F "展示等 M4-5，" docs/reference/control-plane.md; grep -q "M4-5a" docs/reference/orca-mapping.md; ls .axiom-work/reports/M4-5a-*.md
