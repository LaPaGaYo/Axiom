targets: src/main/axiom src/main/runtime/orchestration/db/runs src/main/startup src/main/orcad/orcad-push-startup.test.ts
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/main/startup/main-process-runtime-service\.ts|src/main/orcad/orcad-entry\.ts|src/main/orcad/orcad-push-startup\.test\.ts|docs/ARCHITECTURE.md|docs/GLOSSARY.md|docs/reference/orca-mapping.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/axiom/recovery/recovery-service.ts; test -f src/main/axiom/control-plane-boot.ts; git grep -q "startAxiomControlPlane" -- src/main/startup/main-process-runtime-service.ts; git grep -q "startAxiomControlPlane" -- src/main/orcad/orcad-entry.ts; test "$(git diff --numstat main -- src/main/startup/main-process-runtime-service.ts src/main/orcad/orcad-entry.ts | awk "{t+=\$1+\$2} END {print t+0}")" -le 24; test "$(git grep -c -E "@ts-nocheck|test\.skip" -- src/main/axiom | wc -l)" -eq 0; test "$(git diff --name-only main | grep -F -x -f config/ts-nocheck-baseline.txt | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
