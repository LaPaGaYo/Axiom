targets: src/main/codex src/main/agent-hooks src/main/startup src/main/ipc src/main/agent-trust-presets.test.ts src/cli/handlers/agent-hooks.test.ts config/scripts/vitest-real-agent-home-write-guard.test.ts src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/codex/|src/main/agent-hooks/|src/main/agent-trust-presets(\.test)?\.ts|src/main/startup/(codex-launch-preparation|codex-session-resume-launch|main-process-ready-runtime)[a-z-]*(\.test)?\.ts|src/main/ipc/agent-trust(\.test)?\.ts|config/tsconfig\.cli\.json|docs/decisions/UPSTREAM_SYNC\.md|docs/reference/orca-mapping\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/codex/codex-hook-retired-commands.ts; test -f src/main/codex/codex-hook-retired-commands.test.ts; grep -q "isRetiredCodexHookCommand" src/main/codex/codex-hook-legacy-cleanup.ts; test "$(grep -c "createManagedCommandMatcher" src/main/codex/codex-hook-legacy-cleanup.ts)" -eq 0; test "$(grep -c "removeSystemManagedHookTrustEntries" src/main/codex/codex-hook-legacy-cleanup.ts)" -eq 0; test "$(grep -c "resolveCodexProjectTrustRoot" src/main/agent-trust-presets.ts)" -eq 0; grep -q "canonicalize(workspacePath)" src/main/agent-trust-presets.ts; grep -q "UPSTREAM-2" docs/decisions/UPSTREAM_SYNC.md; grep -q "cfa43e7eab" docs/decisions/UPSTREAM_SYNC.md; grep -q "9f4311598f" docs/decisions/UPSTREAM_SYNC.md; git diff --quiet main -- package.json pnpm-lock.yaml src/main/axiom src/shared/axiom-contract src/main/runtime src/renderer src/cli/specs src/shared/tui-agent-config.ts config/scripts/vitest-real-agent-home-write-guard.ts config/vitest.config.ts; grep -q "'.axiom'" config/scripts/vitest-real-agent-home-write-guard.ts; pnpm run verify:rpc-params-catalog; test "$(git grep -l "@ts-nocheck" -- src/main/codex src/main/agent-hooks src/main/agent-trust-presets.ts | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; pnpm run check:vendor-egress-ratchet
