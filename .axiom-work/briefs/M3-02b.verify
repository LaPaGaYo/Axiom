targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers config/scripts/orcad-entry-build
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/cli/handlers/axiom/|tests/e2e/helpers/|tests/e2e/mission-[A-Za-z0-9._-]+\.spec\.ts|docs/reference/control-plane\.md|docs/GLOSSARY\.md|\.axiom-work/reports/M3-02b-[0-9]+\.md|\.axiom-work/briefs/M3-02b\.(md|verify)|\.axiom-work/verifications/M3-02b-[0-9]+\.md)' | wc -l)" -eq 0; git diff --quiet main -- src/main/runtime src/main/daemon src/main/git src/renderer config mobile package.json pnpm-lock.yaml pnpm-workspace.yaml docs/decisions; test -f src/main/axiom/execution/attempt-transcript.ts; test -f src/main/axiom/execution/attempt-worker-release.ts; grep -q "captureWorkerOutputArchive" src/main/axiom/execution/attempt-transcript.ts; grep -q "redactContext" src/main/axiom/execution/attempt-transcript.ts; grep -q "attempt_transcript" src/main/axiom/execution/attempt-transcript.ts; grep -q "releaseLocalWorker" src/main/axiom/execution/attempt-worker-release.ts; ! grep -n "stopLocalWorker" src/main/axiom/execution/attempt-worker-release.ts; test "$(git grep -l "retainWorkerTerminalResource" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l)" -eq 0; git grep -q "AXIOM_E2E_HOLD_WORKER_RELEASE" -- src/main/axiom tests/e2e/helpers; grep -q "transcriptArtifactId" src/shared/axiom-contract/attempt-params.ts; test -f tests/e2e/mission-worker-release.spec.ts; grep -q "releaseTerminals" tests/e2e/helpers/axiom-fixture-mission.ts; grep -q "transcript-secret" tests/e2e/helpers/axiom-test-provider.ts; grep -q "attempt.transcript_archived" docs/reference/control-plane.md; grep -q "attempt.terminal_released" docs/reference/control-plane.md; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l)" -eq 0; ! git diff main -- src tests | grep -q "^+.*@ts-nocheck"; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 226; test -f .axiom-work/reports/M3-02b-1.md; ! grep -q -i "work in progress" .axiom-work/reports/M3-02b-1.md; ! grep -n -E "'20(2[6-9]|[3-9][0-9])-[01][0-9]-[0-3][0-9] [0-2][0-9]:" src/main/axiom/execution/attempt-projection.test.ts
