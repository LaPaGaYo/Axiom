targets: src/cli/bundled-skill-guides config/scripts/generate-bundled-skill-guides config/scripts/generate-skill-bundle-manifest config/scripts/skill-stub-composition
extra: ! git grep -n -E "onorca\.dev|github\.com/stablyai|discord\.gg|x\.com/orca|app\.orca\.dev" -- docs/site/content skills skill-guides resources/skills skill-stubs; ! git grep -n -w Orca -- "skills/*/SKILL.md" skill-guides resources/skills src/cli/bundled-skill-guides.ts; test "$(git grep -w Orca -- skill-stubs | wc -l)" -le 3; test ! -e docs/site/content/docs/mobile.mdx; test ! -e docs/site/content/docs/android-apk.mdx; test ! -e docs/site/content/docs/telemetry.mdx; node --test docs/site/tests/*.test.mjs; pnpm run verify:bundled-skill-guides; node config/scripts/generate-skill-bundle-manifest.mjs
