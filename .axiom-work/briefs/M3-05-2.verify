targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts$|src/main/runtime/rpc/methods/axiom/|src/cli/|docs/reference/control-plane\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)';git diff --quiet main -- docs/decisions docs/plans;git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/startup src/main/daemon src/main/git src/main/runtime/orchestration;test "$(git diff --name-only main -- src/main/runtime | grep -v '^src/main/runtime/rpc/methods/axiom/' | wc -l)" -eq 0;git diff --quiet main -- src/main/axiom/verification src/main/axiom/messaging/message-router.ts;grep -q acceptance_uncheckable src/shared/axiom-contract/plan-proposal.ts;grep -q coverage_index_out_of_range src/shared/axiom-contract/plan-proposal.ts;grep -q coversGoalCriteria src/shared/axiom-contract/mission-objects.ts;test -f src/shared/axiom-contract/plan-coverage.ts;test -f src/shared/axiom-contract/plan-overlap.ts;grep -q matchesPathPattern src/shared/axiom-contract/plan-overlap.ts;grep -q incomplete_coverage src/shared/axiom-contract/plan-coverage.ts;grep -q scope_overlap src/shared/axiom-contract/plan-overlap.ts;grep -q "warnings" src/shared/axiom-contract/plan-proposal.ts;grep -q "warnings" src/main/axiom/mission-controller/plan-materialization.ts;grep -q "warnings" src/main/axiom/db/revisions-store.ts;grep -q "warnings" src/main/axiom/db/axiom-rows.ts;grep -q acceptance_uncheckable src/main/axiom/messaging/subtask-checks.ts;grep -q coversGoalCriteria src/main/axiom/context-builder/planner-render.ts;grep -q acceptance_uncheckable src/main/axiom/context-builder/planner-render.ts;grep -q "coverage" src/main/runtime/rpc/methods/axiom/plan.ts;grep -q "coverage" src/shared/axiom-contract/plan-params.ts;grep -q "WARNINGS" src/cli/axiom-format.ts;grep -q "COVERAGE" src/cli/axiom-format.ts;grep -q "warnings" src/cli/handlers/axiom/attempt-mcp.ts;grep -rq --include='mission-plan.spec.ts' "scope_overlap" tests/e2e;grep -rq --include='mission-plan.spec.ts' "acceptance_uncheckable" tests/e2e;grep -rq --include='mission-plan.spec.ts' "incomplete_coverage" tests/e2e;grep -q AXIOM_E2E_PLANNER_UNCHECKABLE tests/e2e/fixtures/axiom-claude-planner-stub.cjs;grep -q "expectHarnessEgress" tests/e2e/mission-plan.spec.ts;grep -q acceptance_uncheckable docs/reference/control-plane.md;grep -q scope_overlap docs/reference/control-plane.md;grep -q incomplete_coverage docs/reference/control-plane.md;grep -q coversGoalCriteria docs/reference/control-plane.md;grep -q acceptance_uncheckable docs/GLOSSARY.md;grep -q scope_overlap docs/GLOSSARY.md;pnpm run verify:rpc-params-catalog;! git diff main -- src/main/axiom src/shared/axiom-contract | grep -E '^\+.*(DecisionEngine|decision-engine)';! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;ls .axiom-work/reports/M3-05-2-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
