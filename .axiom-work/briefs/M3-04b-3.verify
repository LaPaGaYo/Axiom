targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts$|src/main/runtime/rpc/methods/axiom/|src/cli/|docs/reference/control-plane\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)';git diff --quiet main -- docs/decisions docs/plans;git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/startup src/main/daemon src/main/git src/main/runtime/orchestration;test "$(git diff --name-only main -- src/main/runtime | grep -v '^src/main/runtime/rpc/methods/axiom/' | wc -l)" -eq 0;grep -q "followUp" src/shared/axiom-contract/message-params.ts;grep -q "question:" src/shared/axiom-contract/message-params.ts;grep -q "max(20)" src/shared/axiom-contract/submission-params.ts;test -f src/main/axiom/execution/submission-items.ts;grep -q submission.items_truncated src/main/axiom/execution/submission-items.ts;grep -q "question.answered" src/main/axiom/db/messages-store.ts;grep -q "followup.resolved" src/main/axiom/db/messages-store.ts;grep -q secret_in_answer src/main/axiom/messaging/question-answer.ts;grep -rq "followup.resolved" src/main/axiom/messaging;grep -rq hasPendingTypedQuestionForTask src/main/axiom/db;grep -q hasPendingTypedQuestionForTask src/main/axiom/scheduler/admission-blockers.ts;test -f src/main/axiom/context-builder/answered-questions.ts;grep -q "Answered questions" src/main/axiom/context-builder/render.ts;grep -q "follow-up" src/cli/handlers/axiom/message.ts;grep -q "report-items" tests/e2e/helpers/axiom-test-provider.ts;! grep -q "VerificationService dequeues QUEUED" tests/e2e/helpers/axiom-test-provider.ts;grep -rq --include='mission-*.spec.ts' "secret_in_answer" tests/e2e;grep -rq --include='mission-*.spec.ts' "Answered questions" tests/e2e;grep -rq --include='mission-*.spec.ts' "followup.resolved" tests/e2e;grep -q secret_in_answer docs/reference/control-plane.md;grep -q "followup.resolved" docs/reference/control-plane.md;grep -q "Answered questions" docs/reference/control-plane.md;grep -q secret_in_answer docs/GLOSSARY.md;grep -q "followup.resolved" docs/GLOSSARY.md;pnpm run verify:rpc-params-catalog;! git diff main -- src/main/axiom | grep -E '^\+.*(DecisionEngine|decision-engine)';! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;ls .axiom-work/reports/M3-04b-3-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
