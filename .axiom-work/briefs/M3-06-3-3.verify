vice\.ts$' | wc -l)" -eq 0; test "$(git diff --numstat main -- src/main/axiom/recovery/recovery-service.ts | awk '{s+=$1+$2} END {print s+0}')" -le 4; test "$(git diff --name-only --diff-filter=MD main -- src/main/axiom/db | grep -v -E '^src/main/axiom/db/axiom-store\.ts$' | wc -l)" -eq 0; test "$(git diff --name-only --diff-filter=MD main | grep -E '(\.test\.ts|\.test-support\.ts|\.spec\.ts)$' | grep -v -E '^(src/main/axiom/namespace-rpc\.test\.ts|src/main/runtime/orchestration/db/schema/axiom-tables-migration\.test\.ts|src/main/axiom/recovery/attempt-supervision\.test\.ts|src/main/axiom/recovery/stall-tiers\.test\.ts|tests/e2e/helpers/(axiom-test-provider|axiom-test-claude-provider|axiom-codex-rollout)\.unit\.test\.ts)$' | wc -l)" -eq 0; test "$(git grep -n "SELECT \*" -- src/main/axiom/db | wc -l)" -eq 0; ! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts src/main/rate-limits; test "$(git grep -n -E "getAccountsSnapshot|rateLimitService|refreshRateLimits|providerActivations" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "plan_type|planType|creator_account_id|creator_user_id|has_credits" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "codex-usage/(scanner|store|codex-usage-provider|codex-session-file-discovery)|claude-usage/(scanner|store)" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean|branch -D|update-ref -d" -- src/main/axiom/execution src/main/axiom/context-builder src/main/axiom/recovery | grep -v "\.test\.ts" | wc -l)" -eq 0; grep -q "reconcileAttempts" src/main/axiom/recovery/recovery-service.ts; grep -q "ATTEMPT_RECONCILE_INTERVAL_MS" src/main/axiom/recovery/recovery-service.ts; test "$(grep -c "no_attempts_in_m1" src/main/axiom/recovery/recovery-service.ts)" -eq 0; grep -q "flushAttemptCadences" src/main/axiom/recovery/recovery-service.ts; grep -q "reconcileStallObservations" src/main/axiom/recovery/recovery-service.ts; grep -q "recovery_runtime_budget" src/main/axiom/recovery/attempt-recovery-endings.ts; grep -q "SCHEMA_VERSION = 46" src/main/runtime/orchestration/db/contract-constants.ts; test "$(git grep -n -i -E "update supervision_settings|replace into supervision_settings|delete from supervision_settings" -- src/main ':(exclude)*.test.ts' ':(exclude)src/main/runtime/orchestration/db/schema/create-axiom-supervision-sql.ts' | wc -l)" -eq 0; test "$(git grep -n -i "delete from attempt_token_usage" -- src/main ':(exclude)*.test.ts' ':(exclude)src/main/runtime/orchestration/db/schema/create-axiom-supervision-sql.ts' | wc -l)" -eq 0; test "$(git diff main -- src/main/axiom ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | grep -E '^\+' | grep -c -E 'setInterval|setTimeout')" -eq 0; test "$(git grep -n -E "DecisionEngine|decision-engine" -- src/main/axiom/recovery src/main/axiom/supervision src/main/axiom/execution ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | wc -l)" -eq 0; ! grep -q "axiom.mission.usage" src/shared/axiom-contract/mutations.ts; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; grep -q "attempt_token_usage" src/main/runtime/orchestration/db/schema/create-axiom-supervision-sql.ts; grep -q "trg_missions_delete_attempt_token_usage" src/main/runtime/orchestration/db/schema/create-axiom-supervision-sql.ts; grep -q "attempt_token_usage" src/main/runtime/orchestration/db/schema/axiom-tables-migration.test.ts; grep -q "adds the attempt token usage table to an existing v46 database" src/main/runtime/orchestration/db/schema/axiom-tables-migration.test.ts; grep -q "'attempt_token_usage'" src/shared/wsl-move/wsl-move-storage-dispositions.ts; grep -q