targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts$|src/main/runtime/rpc/methods/axiom/|src/cli/|docs/reference/control-plane\.md$|docs/reference/orca-mapping\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0; ! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)'; git diff --quiet main -- docs/decisions docs/plans docs/ARCHITECTURE.md; git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/codex-usage src/main/claude src/main/claude-accounts src/main/rate-limits src/main/startup src/main/daemon src/main/git src/shared/rate-limit-types.ts src/shared/agent-session-usage-limit.ts src/shared/agent-session-failure.ts; test "$(git diff --name-only main -- src/main/runtime | grep -v -E '^src/main/runtime/rpc/methods/axiom/' | wc -l)" -eq 0; git diff --quiet main -- src/main/axiom/scheduler/scheduler.ts src/main/axiom/scheduler/admission-blockers.ts src/main/axiom/execution/interruption-policy.ts src/main/axiom/execution/attempt-settlement.ts src/main/axiom/outbox/effect-outbox.ts src/main/axiom/outbox/effect-execution.ts src/main/axiom/db/effects-store.ts src/main/axiom/verification; ! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts src/main/rate-limits; test "$(git grep -n -E "getAccountsSnapshot|rateLimitService|refreshRateLimits|providerActivations" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -eq 0; test "$(git grep -n -E "setInterval|setTimeout" -- src/main/axiom/agent-factory src/main/axiom/mission-controller ':(exclude)*.test.ts' | wc -l)" -eq 0; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226; test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0; grep -q "account_cooldown" src/shared/axiom-contract/agent-spec.ts; grep -rq "account_cooldown" src/main/axiom/agent-factory; grep -rq "filters a provider whose selected account is cooling" src/main/axiom; grep -rq "routes new work to another eligible provider while an account cools" src/main/axiom; grep -rq "reports when the cooldown ends in the admission refusal" src/main/axiom; grep -rq "ignores a cooldown recorded for a different account" src/main/axiom; grep -rq "does not apply the cooldown to the planner role" src/main/axiom; grep -rq "keeps one cooldown view for both selections of an admission" src/main/axiom; grep -rq "keeps the cooldown across a restart" src/main/axiom; grep -rq "records the account of a usage-limited Attempt on its continuation" src/main/axiom; grep -rq "wakes every executing Mission when a usage-limit continuation comes due" src/main/axiom; grep -rq "wakes the other Missions when a person lifts a usage-limit wait" src/main/axiom; grep -rq "falls back to the text patterns when the structured pass throws" src/main/axiom; test "$(git grep -n "headlessFailureKind" -- src tests/e2e | wc -l)" -eq 0; test -f tests/e2e/mission-account-cooldown.spec.ts; grep -q "account_cooldown" tests/e2e/mission-account-cooldown.spec.ts; grep -q "task.admission_refused" tests/e2e/mission-account-cooldown.spec.ts; grep -q "attempt.admitted" tests/e2e/mission-account-cooldown.spec.ts; grep -q "account_cooldown" docs/reference/control-plane.md; grep -q "account_cooldown" docs/GLOSSARY.md; ls .axiom-work/reports/M3-06-2a-2-*.md
