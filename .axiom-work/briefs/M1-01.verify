targets: src/main/axiom/kernel-contract src/main/axiom src/main/runtime/orchestration/db/runs
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/kernel-contract/|docs/review-evidence/axiom-m1/|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f docs/review-evidence/axiom-m1/D14-session-party-spike.md; test "$(ls src/main/axiom/kernel-contract/*.test.ts | wc -l)" -ge 4; test "$(git grep -c -E "^[[:space:]]*//[[:space:]]*@ts-nocheck|^[[:space:]]*(test|it|describe)\.skip\(" -- src/main/axiom | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
