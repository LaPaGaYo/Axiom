n stop mode after an earlier observation" src/main/axiom; grep -rq "does not stop an Attempt in stop mode whose events keep arriving" src/main/axiom; grep -rq "applies the stall stop before the timeout rule in the same pass" src/main/axiom; grep -rq "keeps TUI Attempts out of the stall tiers" src/main/axiom; grep -q "axiom.supervision.update" docs/reference/control-plane.md; grep -q "axiom.supervision" docs/GLOSSARY.md; grep -q "supervision_settings" docs/reference/orca-mapping.md; ls .axiom-work/reports/M3-06-3-2-*.md
