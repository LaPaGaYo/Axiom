invocation pins' docs/reference/control-plane.md;grep -q 'Keychain items' docs/reference/agent-account-homes.md;grep -q 'attempt.launch_observed' docs/GLOSSARY.md;ls .axiom-work/reports/M3-08b-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0;! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;grep -rq 'Edit(//' src/main/axiom/execution;! grep -n 'home!' src/main/axiom/execution/headless-worker-launch.ts;! test -f tests/e2e/helpers/claude-planner-terminal-fallback.ts;grep -q 'attempt.permission_denied' tests/e2e/mission-plan.spec.ts;ls .axiom-work/reports/M3-08b-2.md
