tables-sql.ts; grep -q "worktree_id" src/main/runtime/orchestration/db/schema/migrate-v46.ts; test -f src/shared/axiom-contract/verification-params.ts; grep -q "axiom.verification.show" src/main/runtime/rpc/methods/axiom/verification.ts; grep -q "axiom.verification.list" src/main/runtime/rpc/methods/axiom/verification.ts; grep -q "axiom.verification.show" src/main/axiom/namespace-rpc.test.ts; test "$(grep -c "axiom.verification" src/shared/axiom-contract/mutations.ts)" -eq 0; grep -q "axiom.verification.list" src/shared/rpc-contract/rpc-params-catalog.generated.ts; pnpm run verify:rpc-params-catalog; grep -q "'verification'" src/shared/axiom-contract/namespace.ts; grep -q "'verification'" src/main/startup/cli-command-names.ts; grep -q "verification show" src/cli/axiom-handler-groups.ts; test -f src/cli/specs/axiom-verification.ts; test -f src/cli/handlers/axiom/verification.ts; grep -rq -- "--detach" src/main/axiom/verification; grep -rq "verification.requeued" src/main/axiom/verification; grep -rq "verification.claimed" src/main/axiom/verification; grep -rq "prepared" src/main/axiom/verification; grep -rq "candidate_mismatch" src/main/axiom/verification; grep -rq "removeManagedWorktree" src/main/axiom/verification; grep -rq "createManagedWorktree" src/main/axiom/verification; test "$(git grep -n "setInterval" -- src/main/axiom/verification | wc -l)" -eq 0; test "$(git grep -n -E "reset --hard|git clean|checkout -- " -- src/main/axiom | grep -v "\.test\.ts" | wc -l)" -eq 0; grep -q "verification" src/main/axiom/control-plane-boot.ts; grep -q "kick" src/main/axiom/execution/attempt-submission.ts; grep -q "VERIFYING" tests/e2e/mission-exit-m2.spec.ts; grep -q "VERIFYING" tests/e2e/mission-task-detail.spec.ts; grep -q "verification.requeued" tests/e2e/mission-attempt-submit.spec.ts; grep -q "claimCount" tests/e2e/mission-attempt-submit.spec.ts; grep -q "axiom.verification.show" docs/reference/orca-mapping.md; grep -q "prepared" docs/reference/control-plane.md; grep -q 