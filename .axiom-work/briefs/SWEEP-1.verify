lane-boot.ts | awk '{s+=$1+$2} END {print s+0}')" -le 12; git grep -q "export class Scheduler" -- src/main/axiom/scheduler/scheduler.ts; git grep -q "this.missions.recomputeReadiness(missionId)" -- src/main/axiom/scheduler/scheduler.ts; git grep -q "requestIntegrations(this.store" -- src/main/axiom/scheduler/scheduler.ts; test "$(grep -c "requestIntegrations" src/main/axiom/scheduler/scheduler.ts)" -eq 2; git grep -q "kind: .attempt.dispatch." -- src/main/axiom/scheduler/scheduler.ts; git grep -q -F "'task.admission_refused'" -- src/main/axiom/scheduler/scheduler.ts; git grep -q -F "'scheduler.round'" -- src/main/axiom/scheduler/scheduler.ts; ! grep -q "await launch(" src/main/axiom/scheduler/scheduler.ts; grep -q "reconcileAttempts" src/main/axiom/control-plane-boot.ts; grep -q "ATTEMPT_RECONCILE_INTERVAL_MS" src/main/axiom/control-plane-boot.ts; git grep -q -F "'resume'" -- src/main/axiom/control-plane-boot.ts; test "$(grep -c "setInterval" src/main/axiom/control-plane-boot.ts)" -eq 1; test "$(grep -c "unref()" src/main/axiom/control-plane-boot.ts)" -eq 1; test "$(grep -c "plane.started = false" src/main/axiom/control-plane-boot.ts)" -le 1; test "$(git grep -n -E "setInterval|setTimeout" -- src/main/axiom/scheduler | grep -v "\.test\.ts" | wc -l | tr -d ' ')" -eq 0; ! git grep -q "DecisionEngine" -- src/main/axiom/scheduler; ! git grep -q "getAxiomControlPlane" -- src/main/axiom/scheduler ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; ! git grep -q "appendAuditEvent" -- src/main/axiom/scheduler/admission-refusal.ts src/main/axiom/scheduler/mission-sweep.ts; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l | tr -d ' ')" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean|branch -D|update-ref -d" -- src/main/axiom/scheduler | grep -v "\.test\.ts" | wc -l | tr -d ' ')" -eq 0; test "$(git diff main -- docs/reference/control-plane.md | grep -c -E '^-#')" -eq 0; ! git diff main -- src | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git diff main -- src ':(exclude)src/main/axiom/control-plane-boot-sweep*' | grep -c -E '^\+.*(useFakeTimers|setSystemTime)')" -eq 0; grep -q "### Integration requests" docs/reference/control-plane.md; grep -q "### Scheduler admission" docs/reference/control-plane.md; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -rq "a sweep round does not repeat a refusal that has not changed" src/main/axiom/scheduler; grep -rq "a sweep round writes a refusal whose data changed" src/main/axiom/scheduler; grep -rq "a sweep round writes the first refusal after the Task changed stage" src/main/axiom/scheduler; grep -rq "a sweep round that admits nothing writes nothing" src/main/axiom/scheduler; grep -rq "a sweep admits what a lost round left" src/main/axiom/scheduler; grep -rq "a sweep does not rename a trigger that is already waiting" src/main/axiom/scheduler; grep -q "every tick asks one sweep round of each executing Mission and boot asks none" src/main/axiom/control-plane-boot-sweep.test.ts; grep -q "a tick that cannot sweep leaves only a warning" src/main/axiom/control-plane-boot-sweep.test.ts; grep -q "the sweep is held under e2e unless a spec asks" src/main/axiom/control-plane-boot-sweep.test.ts; git grep -q "export type ScheduleTrigger" -- src/main/axiom/scheduler/scheduler-contract.ts; git grep -q "export type AdmittedAttempt" -- src/main/axiom/scheduler/scheduler-contract.ts; git grep -q "export type AttemptLaunch" -- src/main/axiom/scheduler/scheduler-contract.ts; git grep -q "export type ScheduleRoundResult" -- src/main/axiom/scheduler/scheduler-contract.ts; git grep -q -F "'sweep'" -- src/main/axiom/scheduler/scheduler-contract.ts; git grep -q -F "'policy'" -- src/main/axiom/scheduler/scheduler-contract.ts; git grep -q "scheduler-contract" -- src/main/axiom/scheduler/scheduler.ts; ! git grep -q "export type ScheduleTrigger =" -- src/main/axiom/scheduler/scheduler.ts; test "$(grep -c . src/main/axiom/scheduler/scheduler.ts)" -le 294; git grep -q -F "active.pending ?? trigger" -- src/main/axiom/scheduler/scheduler.ts; git grep -q "admissionRefusalRecorded" -- src/main/axiom/scheduler/scheduler.ts; git grep -q "export function admissionRefusalRecorded" -- src/main/axiom/scheduler/admission-refusal.ts; git grep -q "getLatestReadModelAudit" -- src/main/axiom/scheduler/admission-refusal.ts; git grep -q -F "'task.stage'" -- src/main/axiom/scheduler/admission-refusal.ts; git grep -q -F "'task.admission_refused'" -- src/main/axiom/scheduler/admission-refusal.ts; git grep -q "export function sweepExecutingMissions" -- src/main/axiom/scheduler/mission-sweep.ts; git grep -q "export function shouldHoldSweep" -- src/main/axiom/scheduler/mission-sweep.ts; git grep -q "AXIOM_E2E_RUN_SWEEP" -- src/main/axiom/scheduler/mission-sweep.ts; git grep -q "getMainE2EConfig" -- src/main/axiom/scheduler/mission-sweep.ts; git grep -q -F "status: 'EXECUTING'" -- src/main/axiom/scheduler/mission-sweep.ts; git grep -q -F "'[axiom] Scheduler sweep failed'" -- src/main/axiom/scheduler/mission-sweep.ts; git grep -q -F "'[axiom] Scheduler round failed'" -- src/main/axiom/scheduler/mission-sweep.ts; git grep -q "sweepExecutingMissions(plane.store, plane.scheduler)" -- src/main/axiom/control-plane-boot.ts; test "$(grep -c "sweepExecutingMissions" src/main/axiom/control-plane-boot.ts)" -eq 2; git grep -q "AXIOM_E2E_RUN_SWEEP" -- 'src/main/axiom/control-plane-boot-sweep*'; grep -q "### Scheduler sweep" docs/reference/control-plane.md; grep -q "AXIOM_E2E_RUN_SWEEP" docs/reference/control-plane.md; grep -q "sweepExecutingMissions" docs/reference/control-plane.md; grep -q "admissionRefusalRecorded" docs/reference/control-plane.md; ! grep -q "没有周期性 round" docs/reference/control-plane.md; ! grep -q "每轮各追加一条 task.admission_refused，不去重" docs/reference/control-plane.md; ! grep -q "也没有新增定时 round" docs/reference/control-plane.md; ! grep -q "scheduler.ts 已到 300 counted lines 上限" docs/reference/control-plane.md; ! grep -q "无 polling/timer" docs/reference/control-plane.md; ls .axiom-work/reports/SWEEP-1-*.md
