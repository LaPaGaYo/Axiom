targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli/specs src/cli/handlers/axiom src/main/startup src/cli/handler-group-manifest.test.ts src/cli/cli-command-name-parity.test.ts src/main/runtime/rpc/errors.test.ts src/main/runtime/rpc/methods/orchestration/worker
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/shared/axiom-contract/(attempt-params|lifecycle)(\.test)?\.ts|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts|src/main/runtime/rpc/methods/axiom/(attempt|mission)\.ts|src/main/runtime/rpc/methods/axiom\.ts|src/main/runtime/rpc/errors\.ts|src/cli/specs/axiom-attempt\.ts|src/cli/specs/index\.ts|src/cli/cli-command-name-parity\.test\.ts|src/cli/handlers/axiom/|src/cli/handler-group-manifest\.ts|src/main/startup/cli-command-names\.ts|tests/e2e/mission-attempt-launch\.spec\.ts|tests/e2e/mission-exit-m1\.spec\.ts|tests/e2e/helpers/axiom-test-provider\.ts|docs/GLOSSARY\.md|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/axiom/execution/attempt-launcher.ts; test -f src/main/axiom/execution/integration-base.ts; test -f src/main/axiom/execution/mission-caller.ts; test -f src/shared/axiom-contract/attempt-params.ts; test -f tests/e2e/mission-attempt-launch.spec.ts; test -f tests/e2e/helpers/axiom-test-provider.ts; git diff --quiet main -- src/main/runtime/rpc/methods/orchestration src/main/runtime/orchestration src/renderer; test "$(git diff --name-only main -- src/main/runtime | grep -v -E "^src/main/runtime/rpc/(errors\.ts|methods/axiom\.ts|methods/axiom/)" | wc -l)" -eq 0; test "$(grep -c "launch: null" src/main/axiom/control-plane.ts)" -eq 0; grep -q "LAUNCH_PENDING" src/shared/axiom-contract/lifecycle.ts; grep -q "LAUNCH_PENDING" docs/GLOSSARY.md; grep -q "'attempt_not_found'" src/main/runtime/rpc/errors.ts; grep -q "'integration_base_unavailable'" src/main/runtime/rpc/errors.ts; grep -q "axiom/integration/" src/main/axiom/execution/integration-base.ts; grep -rq "kind: 'system'" src/main/axiom/execution; grep -q "attempt-launcher\|createAttemptLauncher" src/main/axiom/control-plane.ts; grep -q "'attempt'" src/main/startup/cli-command-names.ts; grep -q "attempt show" src/cli/handler-group-manifest.ts; test "$(git diff --numstat main -- src/cli/specs/index.ts | awk "{t+=\$1+\$2} END {print t+0}")" -le 4; test "$(git diff --numstat main -- src/cli/cli-command-name-parity.test.ts | awk "{t+=\$1+\$2} END {print t+0}")" -le 2; grep -q "policy" tests/e2e/mission-exit-m1.spec.ts; test "$(git grep -l "axiom-test-provider" -- src | wc -l)" -eq 0; pnpm run verify:rpc-params-catalog; test "$(pnpm run typecheck:e2e 2>&1 | grep -c -E "mission-attempt-launch\.spec\.ts|axiom-test-provider\.ts|mission-exit-m1\.spec\.ts")" -eq 0; test "$(git grep -l "@ts-nocheck" -- src/main/axiom src/shared/axiom-contract | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
