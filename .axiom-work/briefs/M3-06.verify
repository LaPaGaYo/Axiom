targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli src/main/runtime/orchestration/db/schema tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts$|src/main/runtime/rpc/methods/axiom/|src/main/runtime/orchestration/db/schema/(create-axiom-tables-sql|axiom-tables-migration\.test)\.ts$|src/cli/|docs/reference/control-plane\.md$|docs/reference/orca-mapping\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/|\.axiom-work/briefs/M3-06\.(md|verify)$)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/|src/renderer/)';git diff --quiet main -- docs/decisions docs/plans docs/ARCHITECTURE.md;git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/startup src/main/daemon src/main/git;test "$(git diff --name-only main -- src/main/runtime | grep -v -E '^src/main/runtime/(rpc/methods/axiom/|orchestration/db/schema/(create-axiom-tables-sql|axiom-tables-migration\.test)\.ts$)' | wc -l)" -eq 0;git diff --quiet main -- src/main/runtime/orchestration/db/contract-constants.ts src/main/runtime/orchestration/db/schema/migrate.ts;git diff --quiet main -- src/main/axiom/messaging/message-router.ts src/main/axiom/execution/attempt-settlement.ts src/main/axiom/execution/attempt-baseline.ts src/main/axiom/execution/planner-launcher.ts src/main/axiom/verification/verification-claim.ts src/main/axiom/verification/verification-settlement.ts src/main/axiom/verification/verification-recovery.ts;grep -q axiom_effects src/main/runtime/orchestration/db/schema/create-axiom-tables-sql.ts;grep -q axiom_effects src/main/runtime/orchestration/db/schema/axiom-tables-migration.test.ts;test -f src/shared/axiom-contract/effects.ts;grep -q "attempt.dispatch" src/shared/axiom-contract/effects.ts;grep -q "verification.enqueue" src/shared/axiom-contract/effects.ts;test -d src/main/axiom/outbox;grep -rq "attempt.dispatch" src/main/axiom/outbox src/main/axiom/control-plane.ts;grep -rq "verification.enqueue" src/main/axiom/outbox src/main/axiom/control-plane.ts;grep -rq "effect.failed" src/main/axiom/outbox;grep -rq "effect.retired" src/main/axiom/outbox;grep -rq "dispatch_outcome_unknown" src/main/axiom;test "$(git grep -n "setInterval" -- src/main/axiom/outbox ':(exclude)*.test.ts' | wc -l)" -eq 0;! grep -q "await launch(" src/main/axiom/scheduler/scheduler.ts;! grep -q "\.kick(" src/main/axiom/execution/attempt-submission.ts;! grep -q "\.kick(" src/main/runtime/rpc/methods/axiom/verification.ts;grep -q "launch_pending_orphan" src/main/axiom/recovery/attempt-reconciliation.ts;test "$(git grep -l "launch_rejected" -- src/main/axiom ':(exclude)*.test.ts' | wc -l)" -ge 1;grep -rq "axiom.effect.list" src/main/runtime/rpc/methods/axiom;grep -q "axiom.effect.list" src/main/axiom/authority/caller-authority.ts;! grep -q "axiom.effect.list" src/shared/axiom-contract/mutations.ts;grep -rq "mission effect list" src/cli;grep -rq AXIOM_E2E_HOLD_ATTEMPT_DISPATCH src/main/axiom;grep -rq AXIOM_E2E_HOLD_ATTEMPT_DISPATCH tests/e2e/helpers;grep -q "holdAttemptDispatch" tests/e2e/helpers/axiom-fixture-mission.ts;test -f tests/e2e/mission-effect-outbox.spec.ts;grep -q "launch_pending_orphan" tests/e2e/mission-effect-outbox.spec.ts;grep -q "restart" tests/e2e/mission-effect-outbox.spec.ts;grep -q "verification.enqueue" tests/e2e/mission-effect-outbox.spec.ts;grep -q "expectHarnessEgress" tests/e2e/mission-plan.spec.ts;grep -q "preserves identity without relaunch on restart" tests/e2e/mission-attempt-launch.spec.ts;grep -q "axiom_effects" docs/reference/control-plane.md;grep -q "attempt.dispatch" docs/reference/control-plane.md;grep -q "effect.retired" docs/reference/control-plane.md;grep -q "axiom_effects" docs/reference/orca-mapping.md;grep -q "attempt.dispatch" docs/GLOSSARY.md;pnpm run verify:rpc-params-catalog;! git diff main -- src/main/axiom src/shared/axiom-contract | grep -E '^\+.*(DecisionEngine|decision-engine)';! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;ls .axiom-work/reports/M3-06-*.md;test -f .axiom-work/reports/M3-06-2.md;grep -rq "continues startup when effect recovery fails" src/main/axiom;grep -rq "recovers the remaining orphans when one recovery fails" src/main/axiom;grep -rq "retries unrecovered orphans on the reconcile tick" src/main/axiom;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
