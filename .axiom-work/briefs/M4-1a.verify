wk '{s+=$1+$2} END {print s+0}')" -le 16; test "$(git diff -w --numstat main -- src/shared/axiom-contract/lifecycle.test.ts | awk '{s+=$1+$2} END {print s+0}')" -le 12; test "$(git diff -w --numstat main -- tests/e2e/mission-exit-m2.spec.ts | awk '{s+=$1+$2} END {print s+0}')" -le 12; test "$(git diff main -- tests/e2e/mission-exit-m2.spec.ts | grep -c -E '^-[^-]')" -eq 0; test "$(git diff main -- src/main/axiom/db/axiom-store.ts src/main/axiom/execution/attempt-submission.ts | grep -c -E '^\+export ')" -eq 0; test "$(git diff main -- src/main/axiom/execution/attempt-submission.ts | grep -c -E '^\+import ')" -le 1; test "$(git diff main -- src/main/axiom/db/axiom-store.ts | grep -c -E '^\+import ')" -le 1; test "$(git diff --numstat --diff-filter=M main -- ':(glob)src/main/axiom/**/*.test.ts' ':(glob)src/main/axiom/**/*.test-support.ts' | awk '{s+=$1+$2} END {print s+0}')" -le 80; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src tests | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git diff main -- src tests | grep -c -E '^\+.*(useFakeTimers|setSystemTime)')" -eq 0; ! git grep -q "refs/axiom/candidates" -- src/main/axiom/execution/attempt-submission.ts; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l | tr -d ' ')" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean|branch -D|update-ref -d" -- src/main/axiom/execution src/main/axiom/context-builder src/main/axiom/recovery | grep -v "\.test\.ts" | wc -l | tr -d ' ')" -eq 0; git grep -q "export async function snapshotCandidate" -- src/main/axiom/execution/candidate-snapshot.ts; git grep -q "CREATE TABLE IF NOT EXISTS integration_batches" -- src/main/runtime/orchestration/db/schema/create-axiom-tables-sql.ts; grep -q "adopts clean HEAD without modifying the worktree" src/main/axiom/execution/candidate-snapshot.test.ts; grep -q "writes one immutable Candidate/report, both facets, queued verification and a truthful message" src/main/axiom/execution/attempt-submission.test.ts; grep -q "supersedes the previous ACTIVE Candidate when a later Attempt submits" src/main/axiom/execution/attempt-submission.test.ts; grep -q "M2 exit: Planner, parallel Workers, crash retry and immutable submission fences" tests/e2e/mission-exit-m2.spec.ts; test "$(grep -c . src/main/axiom/execution/attempt-submission.ts)" -le 310; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -rq "matches IntegrationBatch " src/main/axiom src/shared/axiom-contract; grep -rq "admits exactly the IntegrationBatch transitions and nothing out of a terminal status" src/main/axiom src/shared/axiom-contract; grep -rq "accepts a batch of exactly one candidate and refuses unknown fields and malformed commits" src/main/axiom src/shared/axiom-contract; grep -rq "stores a batch and reads it back by id, by Mission, by status and by candidate" src/main/axiom src/shared/axiom-contract; grep -rq "moves a batch only along a legal transition and only from the expected status" src/main/axiom src/shared/axiom-contract; grep -rq "sets what a status carries and clears the merge commit when a batch is queued again" src/main/axiom src/shared/axiom-contract; grep -rq "reports a stored batch that does not decode without quoting the cell" src/main/axiom src/shared/axiom-contract; grep -rq "exposes the batch store through AxiomStore" src/main/axiom src/shared/axiom-contract; grep -rq "pins a candidate commit under refs/axiom/candidates without running repository hooks" src/main/axiom src/shared/axiom-contract; grep -rq "accepts an existing pin of the same commit and reports another commit as a conflict" src/main/axiom src/shared/axiom-contract; grep -rq "answers unavailable when the id is unsafe or the worktree is gone" src/main/axiom src/shared/axiom-contract; grep -rq "pins the candidate before the submission is committed and not again on a replay" src/main/axiom src/shared/axiom-contract; grep -rq "records a failed pin in the audit and still accepts the submission" src/main/axiom src/shared/axiom-contract; grep -rq "leaves the audits of a submission unchanged when the pin succeeds" src/main/axiom src/shared/axiom-contract; git grep -q "INTEGRATION_BATCH_STATUSES" -- src/shared/axiom-contract/integration-batch.ts; git grep -q "AWAITING_APPROVAL" -- src/shared/axiom-contract/integration-batch.ts; git grep -q "IntegrationBatchSchema" -- src/shared/axiom-contract/integration-batch.ts; git grep -q "INTEGRATION_BATCH_STATUSES" -- src/shared/axiom-contract/lifecycle.test.ts; git grep -q "integration_batches" -- src/main/axiom/db ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q "refs/axiom/candidates/" -- src/main/axiom/execution ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q "candidate.pin_failed" -- src/main/axiom/execution ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; test "$(git grep -l "refs/axiom/candidates/" -- src/main/axiom/execution ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | xargs grep -l "hooksPath" | xargs grep -l "for-each-ref" | wc -l | tr -d ' ')" -ge 1; git grep -q "refs/axiom/candidates/" -- tests/e2e/mission-exit-m2.spec.ts; grep -q "M4-1a" docs/reference/control-plane.md; grep -q "refs/axiom/candidates/" docs/reference/control-plane.md; grep -q "candidate.pin_failed" docs/reference/control-plane.md; ls .axiom-work/reports/M4-1a-*.md
