targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli/specs src/cli/handlers/axiom src/main/startup src/cli/handler-group-manifest.test.ts src/cli/cli-command-name-parity.test.ts src/main/runtime/rpc/errors.test.ts
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/(artifacts|context-builder|db)/|src/main/axiom/control-plane\.ts|src/main/axiom/namespace-rpc\.test\.ts|src/shared/axiom-contract/(artifact-params|context-package|mutations)(\.test)?\.ts|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts|src/main/runtime/rpc/methods/axiom/artifact\.ts|src/main/runtime/rpc/methods/axiom\.ts|src/main/runtime/rpc/errors\.ts|src/cli/specs/axiom-mission\.ts|src/cli/handlers/axiom/|src/cli/handler-group-manifest\.ts|src/main/startup/cli-command-names\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/axiom/artifacts/artifact-store.ts; test -f src/main/axiom/context-builder/context-builder.ts; test -f src/shared/axiom-contract/context-package.ts; test -f src/shared/axiom-contract/artifact-params.ts; git diff --quiet main -- src/main/runtime/orchestration src/main/runtime/rpc/methods/orchestration; grep -q "axiom.artifact.put" src/shared/axiom-contract/mutations.ts; grep -q "'artifact_corrupt'" src/main/runtime/rpc/errors.ts; grep -q "'artifact_not_found'" src/main/runtime/rpc/errors.ts; test "$(git diff --numstat main -- src/main/runtime/rpc/errors.ts src/cli/handler-group-manifest.ts src/main/axiom/namespace-rpc.test.ts | awk "{t+=\$1+\$2} END {print t+0}")" -le 16; pnpm run verify:rpc-params-catalog; grep -rq "{{attemptId}}" src/main/axiom/context-builder; grep -rq "{{dispatchCapability}}" src/main/axiom/context-builder; test "$(git grep -l "getAppEnvironment" -- src/main/axiom/artifacts src/main/axiom/context-builder | grep -v -E "\.test\.ts$" | wc -l)" -eq 0; test "$(git grep -l "@ts-nocheck" -- src/main/axiom src/shared/axiom-contract | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
