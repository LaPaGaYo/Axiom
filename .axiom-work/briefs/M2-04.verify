targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli/specs src/cli/handlers/axiom src/main/startup
extra: test "$(git diff --name-only main | grep -v -E "^(src/main/axiom/|src/shared/axiom-contract/(mission-objects|lifecycle|contract-fixtures\.test-support)(\.test)?\.ts|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f src/main/axiom/scheduler/scheduler.ts; test -f src/main/axiom/scheduler/admission-blockers.ts; test -f src/main/axiom/db/attempt-bindings-store.ts; git diff --quiet main -- src/main/runtime src/cli src/renderer src/shared/rpc-contract; test "$(grep -c "function blockingQuestionOrApproval(): 'none'" src/main/axiom/mission-controller/task-readiness.ts)" -eq 0; grep -q "maxWallClockMinutes" src/shared/axiom-contract/mission-objects.ts; grep -q "providerConcurrency" src/shared/axiom-contract/mission-objects.ts; grep -q "BLOCKING_APPROVAL_ACTION_KINDS" src/shared/axiom-contract/lifecycle.ts; grep -rq "attempt.admitted" src/main/axiom/scheduler; grep -rq "budget.exhausted" src/main/axiom/scheduler; grep -q "onScheduleTrigger" src/main/axiom/mission-controller/mission-controller.ts; grep -q "launch: null" src/main/axiom/control-plane.ts; test "$(git grep -n -E "setInterval|setTimeout" -- src/main/axiom/scheduler | grep -v "\.test\.ts" | wc -l)" -eq 0; test "$(git grep -l "@ts-nocheck" -- src/main/axiom src/shared/axiom-contract | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
