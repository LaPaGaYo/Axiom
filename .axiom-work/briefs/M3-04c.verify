extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts|src/main/runtime/rpc/dispatcher\.ts|src/main/runtime/rpc/dispatcher-axiom-[A-Za-z0-9._-]+\.test\.ts|src/main/runtime/rpc/methods/axiom/|src/cli/handlers/axiom/|src/cli/specs/axiom-attempt(\.test)?\.ts|src/cli/specs/axiom-mission(\.test)?\.ts|src/main/runtime/rpc/errors(\.test)?\.ts|src/main/runtime/rpc/orchestration-session-caller(\.test)?\.ts|src/cli/runtime/orchestration-compatibility-envelope(\.test)?\.ts|src/cli/runtime/axiom-envelope\.test\.ts|config/scripts/axiom-docs-terminology\.test\.mjs|tests/e2e/helpers/|tests/e2e/mission-[A-Za-z0-9._-]+\.spec\.ts|docs/reference/control-plane\.md|docs/GLOSSARY\.md|\.axiom-work/reports/M3-04c-[0-9]+\.md|\.axiom-work/briefs/M3-04c\.(md|verify)|\.axiom-work/verifications/M3-04c-[0-9]+\.md)' | wc -l)" -eq 0; git diff --quiet main -- src/main/daemon src/main/git src/main/runtime/orchestration src/renderer config/patches mobile package.json pnpm-lock.yaml pnpm-workspace.yaml docs/decisions; test -f src/main/axiom/authority/caller-authority.ts; grep -q "caller_not_desktop" src/main/axiom/authority/caller-authority.ts; grep -q "caller_not_permitted_for_agent" src/main/axiom/authority/caller-authority.ts; grep -q "authority.refused" src/main/axiom/authority/caller-authority.ts; grep -q "desktop_only" src/main/axiom/authority/caller-authority.ts; grep -q "assertAxiomCallerAuthority" src/main/runtime/rpc/dispatcher.ts; test "$(git diff main -- src/main/runtime/rpc/dispatcher.ts | grep -c -E '^[-+][^-+]')" -le 10; test "$(grep -c "VERIFIED" src/main/axiom/mission-controller/task-readiness.ts)" -eq 0; grep -q "threshold_not_supported" src/shared/axiom-contract/plan-proposal.ts; test "$(git grep -l "threshold_not_supported" -- src/main src/shared | grep -v -E "\.test\.ts$" | wc -l)" -ge 2; grep -q "V1 rejects VERIFIED edges" src/main/axiom/context-builder/planner-render.ts; grep -q "allowedPaths when a Task must delete it" src/main/axiom/context-builder/planner-render.ts; grep -q -F "an entry covers that path and everything below it" src/main/axiom/context-builder/planner-render.ts; grep -q -E "(required|optional)\(ctx.flags, 'attempt'\)" src/cli/handlers/axiom/artifact.ts; grep -q "artifact put --attempt" src/cli/specs/axiom-attempt.ts; test -f config/scripts/axiom-docs-terminology.test.mjs; grep -q "orchestrationCapability" config/scripts/axiom-docs-terminology.test.mjs; test -f tests/e2e/helpers/axiom-desktop-call.ts; ! grep -q -E "'plan', 'approve'" tests/e2e/helpers/axiom-fixture-mission.ts; grep -q "extraAllowedPaths" tests/e2e/helpers/axiom-fixture-mission.ts; grep -q "releaseTerminals" tests/e2e/helpers/axiom-fixture-mission.ts; grep -q "self-approve" tests/e2e/helpers/axiom-test-provider.ts; test -f tests/e2e/mission-caller-authority.spec.ts; grep -q "caller_not_desktop" tests/e2e/mission-caller-authority.spec.ts; grep -q "authority.refused" tests/e2e/mission-caller-authority.spec.ts; grep -q "caller_not_desktop" docs/reference/control-plane.md; grep -q "authority.refused" docs/reference/control-plane.md; grep -q "caller_not_permitted_for_agent" docs/GLOSSARY.md; ! git diff main -- src tests | grep -q "^+.*@ts-nocheck"; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 226; test "$(pnpm run typecheck:e2e 2>&1 | grep -c -E "mission-caller-authority\.spec\.ts|axiom-desktop-call\.ts|axiom-fixture-mission\.ts|axiom-test-provider\.ts")" -eq 0; test -f .axiom-work/reports/M3-04c-2.md; ! grep -q -i "work in progress" .axiom-work/reports/M3-04c-2.md; grep -q "caller_not_desktop" src/main/runtime/rpc/errors.ts; grep -q "caller_not_permitted_for_agent" src/main/runtime/rpc/errors.ts; test "$(git diff main -- src/main/runtime/rpc/errors.ts | grep -c -E '^[-+][^-+]')" -le 24; test "$(git diff main -- src/main/runtime/rpc/orchestration-session-caller.ts | grep -c -E '^[-+][^-+]')" -le 24; test "$(git diff main -- src/cli/specs/axiom-mission.ts | grep -c -E '^[-+][^-+]')" -le 8
