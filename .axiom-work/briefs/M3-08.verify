targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/orchestration/worker src/main/runtime/orchestration/setup-completion-signal src/main/runtime/runtime-agent-terminal-startup src/main/codex-cli src/main/agent-launch src/shared/tui-agent-launch-command tests/e2e/helpers config/scripts/axiom-docs-terminology config/scripts/orcad-entry-build
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts|src/main/runtime/rpc/methods/orchestration/worker/|src/main/runtime/orchestration/setup-completion-signal(\.test)?\.ts|src/main/runtime/terminal/wait/|src/main/runtime/runtime-agent-terminal-startup(\.test)?\.ts|src/main/codex-cli/|src/shared/agent-headless-command(\.test)?\.ts|src/shared/codex-headless-command(\.test)?\.ts|tests/e2e/helpers/|tests/e2e/mission-[A-Za-z0-9._-]+\.spec\.ts|docs/reference/control-plane\.md|docs/GLOSSARY\.md|\.axiom-work/reports/M3-08-[0-9]+\.md|\.axiom-work/briefs/M3-08\.(md|verify)|\.axiom-work/verifications/M3-08-[0-9]+\.md)' | wc -l)" -eq 0; git diff --quiet main -- src/main/daemon src/main/git src/renderer config/patches mobile package.json pnpm-lock.yaml pnpm-workspace.yaml docs/decisions; test -z "$(git diff --name-only main -- src/main/runtime/orchestration | grep -v -E 'setup-completion-signal(\.test)?\.ts$')"; test "$(git diff main -- src/main/runtime/rpc/methods/orchestration/worker ':(exclude)*.test.ts' | grep -c -E '^[-+][^-+]')" -le 200; test "$(git diff main -- src/main/runtime/orchestration src/main/runtime/terminal src/main/runtime/runtime-agent-terminal-startup.ts ':(exclude)*.test.ts' | grep -c -E '^[-+][^-+]')" -le 60; test -f src/main/axiom/execution/headless-worker-command.ts; test -f src/main/axiom/execution/attempt-exit-submission.ts; grep -q "exec" src/main/axiom/execution/headless-worker-command.ts; grep -q "workspace-write" src/main/axiom/execution/headless-worker-command.ts; grep -q -e "--json" src/main/axiom/execution/headless-worker-command.ts; ! grep -q -E "dangerously-bypass|full-auto" src/main/axiom/execution/headless-worker-command.ts; grep -q -F ".axiom/artifacts/" src/main/axiom/context-builder/render.ts; grep -q "exit-nonzero" tests/e2e/helpers/axiom-test-provider.ts; grep -q "bad-report" tests/e2e/helpers/axiom-test-provider.ts; test -f tests/e2e/mission-headless-worker.spec.ts; grep -q -i "headless" docs/reference/control-plane.md; ! git diff main -- src tests | grep -q "^+.*@ts-nocheck"; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l)" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 226; test "$(pnpm run typecheck:e2e 2>&1 | grep -c -E "mission-headless-worker\.spec\.ts|axiom-test-provider\.ts|axiom-fixture-mission\.ts")" -eq 0; test -f .axiom-work/reports/M3-08-1.md; ! grep -q -i "work in progress" .axiom-work/reports/M3-08-1.md
