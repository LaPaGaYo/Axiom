targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom src/cli tests/e2e/helpers
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/|src/shared/axiom-contract/|src/shared/rpc-contract/rpc-params-catalog\.generated\.ts$|src/main/runtime/rpc/methods/axiom/|src/cli/|docs/reference/control-plane\.md$|docs/GLOSSARY\.md$|tests/e2e/|\.axiom-work/reports/)' | wc -l)" -eq 0;! git diff --name-only main | grep -E '^(package\.json|pnpm-lock\.yaml|pnpm-workspace\.yaml|config/patches/|mobile/)';git diff --quiet main -- docs/decisions docs/plans;git diff --quiet main -- src/main/codex src/main/codex-accounts src/main/claude src/main/claude-accounts src/main/startup src/main/daemon src/main/git src/main/runtime/orchestration src/renderer;test "$(git diff --name-only main -- src/main/runtime | grep -v '^src/main/runtime/rpc/methods/axiom/' | wc -l)" -eq 0;grep -q "'no_change'" src/shared/axiom-contract/submission-params.ts;grep -q blocked_by_scope src/shared/axiom-contract/submission-params.ts;grep -q candidate_already_correct src/shared/axiom-contract/submission-params.ts;grep -q cannot_reproduce src/shared/axiom-contract/submission-params.ts;grep -q blocked_by_scope src/shared/axiom-contract/message-params.ts;grep -rq blocked_by_scope src/cli;grep -rq "'declared'" src/main/axiom/execution;grep -q "'declared'" src/main/axiom/recovery/attempt-reconciliation.ts;grep -q candidate_disputed src/main/axiom/execution/attempt-settlement.ts;grep -q "'scope'" src/main/axiom/execution/attempt-settlement.ts;grep -q attempt.blocked_reported src/main/axiom/mission-controller/run-mailbox-consumer.ts;grep -q "blocked.resolved" src/main/axiom/db/messages-store.ts;grep -rq "blocked.resolved" src/main/axiom/mission-controller;grep -rq "task.adjusted" src/main/axiom/mission-controller;grep -rq "plan.minor_adjustment" src/main/axiom/mission-controller;grep -q updateTaskSpec src/main/axiom/db/task-graph-store.ts;grep -q retry_budget_exhausted src/main/axiom/mission-controller/controller-context.ts;grep -q "axiom.task.adjust" src/main/runtime/rpc/methods/axiom/task.ts;grep -q "'axiom.task.adjust': 'desktop_only'" src/main/axiom/authority/caller-authority.ts;grep -q "axiom.task.adjust" src/shared/axiom-contract/mutations.ts;grep -q TaskAdjustParams src/shared/axiom-contract/task-params.ts;grep -q TaskAdjustParams src/shared/rpc-contract/rpc-params-catalog.generated.ts;pnpm run verify:rpc-params-catalog;grep -q "'adjust'" src/cli/specs/axiom-task.ts;grep -q "'task adjust'" src/cli/handlers/axiom/task.ts;grep -q "axiom.task.adjust" src/cli/axiom-command-cases.test-support.ts;grep -q skippedAttempts src/main/axiom/execution/attempt-baseline.ts;grep -q skippedAttempts src/main/axiom/context-builder/previous-attempt.ts;grep -q blocked_by_scope src/main/axiom/context-builder/previous-attempt.ts;grep -q "task.adjusted" src/main/axiom/context-builder/previous-attempt.ts;grep -q candidate_already_correct src/main/axiom/context-builder/render.ts;grep -qi "node_modules" src/main/axiom/context-builder/render.ts;grep -q "REVIEW.md" src/main/axiom/context-builder/render.ts;grep -q "blocked-scope" tests/e2e/helpers/axiom-test-provider.ts;grep -q "no-change-declared" tests/e2e/helpers/axiom-test-provider.ts;grep -rq --include='mission-*.spec.ts' "axiom.task.adjust" tests/e2e;grep -q "axiom.task.adjust" docs/reference/control-plane.md;grep -q candidate_disputed docs/reference/control-plane.md;grep -q skippedAttempts docs/reference/control-plane.md;grep -q blocked_by_scope docs/GLOSSARY.md;grep -q candidate_disputed docs/GLOSSARY.md;grep -q "task.adjusted" docs/GLOSSARY.md;! git diff main -- src/main/axiom | grep -E '^\+.*(DecisionEngine|decision-engine)';! grep -rn -E "from '(\.\./)+axiom/" src/main/claude src/main/claude-accounts src/main/codex src/main/codex-accounts;ls .axiom-work/reports/M3-04b-*.md;test "$(pnpm run typecheck:e2e 2>&1 | grep -c 'error TS')" -le 226;test -z "$(git diff --name-only main -- tests/e2e)" || test "$(pnpm run typecheck:e2e 2>&1 | grep -E "$(git diff --name-only main -- tests/e2e | tr '\n' '|' | sed 's/|$//')" | grep -c 'error TS')" -eq 0
