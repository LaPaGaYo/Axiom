targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom
extra: test "$(git diff --name-only main | grep -v -E '^(src/main/axiom/context-builder/[a-z0-9-]+\.ts|src/main/axiom/mission-controller/mission-controller\.ts|src/main/axiom/[A-Za-z0-9/_-]+\.test(-support)?\.ts|docs/reference/control-plane\.md|\.axiom-work/reports/M3-09-4b-2-[0-9]+\.md)$' | wc -l | tr -d ' ')" -eq 0; test "$(git diff --no-renames --name-only --diff-filter=MD main | grep -v -E '^(src/main/axiom/context-builder/planner-render\.ts|src/main/axiom/mission-controller/mission-controller\.ts|docs/reference/control-plane\.md)$' | wc -l | tr -d ' ')" -eq 0; git diff --quiet main -- src/renderer src/shared src/cli src/preload src/main/runtime tests package.json pnpm-lock.yaml pnpm-workspace.yaml config .github mobile; git diff --quiet main -- AGENTS.md docs/decisions docs/plans docs/ARCHITECTURE.md docs/GLOSSARY.md docs/PROJECT_CONSTITUTION.md docs/STYLEGUIDE.md .axiom-work/briefs .axiom-work/scripts .axiom-work/sidecar-union.list; test "$(git diff -w --numstat main -- src/main/axiom/context-builder/planner-render.ts | awk '{s+=$1+$2} END {print s+0}')" -le 24; test "$(git diff -w --numstat main -- src/main/axiom/mission-controller/mission-controller.ts | awk '{s+=$1+$2} END {print s+0}')" -le 8; test "$(git diff main -- src/main/axiom/context-builder/planner-render.ts src/main/axiom/mission-controller/mission-controller.ts | grep -c -E '^\+export ')" -eq 0; ! git diff main -- src tests | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git diff main -- src | grep -c -E '^\+.*(useFakeTimers|setSystemTime)')" -eq 0; git grep -q "export async function buildPlannerContext" -- src/main/axiom/context-builder/planner-render.ts; git grep -q "export function plannerProposalCommandPrefix" -- src/main/axiom/context-builder/planner-render.ts; git grep -q "export function quote(" -- src/main/axiom/context-builder/previous-attempt-text.ts; git grep -q "export function quoteLine(" -- src/main/axiom/context-builder/previous-attempt-text.ts; test "$(git grep -c "slice(0, 500)" -- src/main/axiom/context-builder ':(exclude)*.test.ts' | wc -l | tr -d ' ')" -eq 1; grep -q "persists ordered reproducible planner sections as two artifacts without a context row" src/main/axiom/execution/planner-launcher.test.ts; grep -q "refuses a cancellation whose rationale looks like a secret" src/main/axiom/rpc-task-cancel-rationale.test.ts; test "$(grep -c . src/main/axiom/context-builder/planner-render.ts)" -le 290; test "$(grep -c . src/main/axiom/mission-controller/mission-controller.ts)" -le 290; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -rq "tells the next Planner why a person rejected the previous plan" src/main/axiom; grep -rq "lists rejections newest first and marks a plan of an earlier Goal" src/main/axiom; grep -rq "quotes a stored rejection reason as data and redacts a secret in it" src/main/axiom; grep -rq "keeps the rejections within 4 KiB and never drops the newest one" src/main/axiom; grep -rq "starts a Planner after a rejection with the reason in its context package" src/main/axiom; grep -rq "refuses a rejection whose reason looks like a secret and writes nothing" src/main/axiom; grep -rq "leaves the Planner context unchanged while no plan revision is rejected" src/main/axiom; grep -rq "bounds the Task list of a rejected plan revision" src/main/axiom; git grep -q "Rejected plan revisions" -- src/main/axiom/context-builder ':(exclude)*.test.ts'; git grep -q "none recorded" -- src/main/axiom/context-builder ':(exclude)*.test.ts'; git grep -q "more Tasks omitted" -- src/main/axiom/context-builder ':(exclude)*.test.ts'; git grep -q "Earlier rejections omitted" -- src/main/axiom/context-builder ':(exclude)*.test.ts'; test "$(grep -c "secret_in_rationale" src/main/axiom/mission-controller/mission-controller.ts)" -eq 2; grep -q "Rejected plan revisions" docs/reference/control-plane.md; grep -q "axiom.plan.reject.*secret_in_rationale" docs/reference/control-plane.md; ! grep -q "下一次 Planner 尚不接收退回理由" docs/reference/control-plane.md; ls .axiom-work/reports/M3-09-4b-2-*.md
