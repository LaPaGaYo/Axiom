briefs .axiom-work/scripts .axiom-work/sidecar-union.list; test "$(git diff -w --numstat main -- src/shared/axiom-contract/effects.ts | awk '{s+=$1+$2} END {print s+0}')" -le 24; test "$(git diff -w --numstat main -- src/main/axiom/db/effect-rows.ts | awk '{s+=$1+$2} END {print s+0}')" -le 16; test "$(git diff -w --numstat main -- src/main/axiom/db/candidates-store.ts | awk '{s+=$1+$2} END {print s+0}')" -le 24; test "$(git diff -w --numstat main -- src/main/axiom/db/axiom-store.ts | awk '{s+=$1+$2} END {print s+0}')" -le 6; test "$(git diff -w --numstat main -- src/main/axiom/control-plane.ts | awk '{s+=$1+$2} END {print s+0}')" -le 8; test "$(git diff -w --numstat main -- src/shared/axiom-contract/effects.test.ts | awk '{s+=$1+$2} END {print s+0}')" -le 60; test "$(git diff -w main -- src/shared/axiom-contract/effects.ts | grep -c -E '^-[^-]')" -le 4; test "$(git diff -w main -- src/main/axiom/db/effect-rows.ts | grep -c -E '^-[^-]')" -le 6; test "$(git diff -w main -- src/main/axiom/db/candidates-store.ts | grep -c -E '^-[^-]')" -le 2; test "$(git diff -w main -- src/main/axiom/db/axiom-store.ts | grep -c -E '^-[^-]')" -le 0; test "$(git diff -w main -- src/main/axiom/control-plane.ts | grep -c -E '^-[^-]')" -le 0; test "$(git diff -w main -- src/main/axiom/db/effect-rows.test.ts | grep -c -E '^-[^-]')" -le 2; test "$(git diff -w main -- src/main/axiom/db/submission-stores.test.ts | grep -c -E '^-[^-]')" -le 2; test "$(git diff -w main -- src/shared/axiom-contract/effects.test.ts | grep -c -E '^-[^-]')" -le 8; test "$(git diff main -- src/main/axiom/control-plane.ts src/main/axiom/db/axiom-store.ts src/main/axiom/db/effect-rows.ts | grep -c -E '^\+export ')" -eq 0; test "$(git diff main -- src/main/axiom/control-plane.ts | grep -c -E '^\+import ')" -le 1; test "$(grep -c . src/main/axiom/control-plane.ts)" -le 299; ! git diff main -- src | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; test "$(git diff main -- src | grep -c -E '^\+.*(useFakeTimers|setSystemTime)')" -le 3; test "$(git grep -l -E "node:child_process|'child_process'" -- src/main/axiom | grep -v -E "\.test\.ts$|\.test-support\.ts$" | wc -l | tr -d ' ')" -eq 0; test "$(git grep -n -E "reset --hard|checkout --|git clean|branch -D|update-ref -d" -- src/main/axiom/integration src/main/axiom/execution src/main/axiom/context-builder src/main/axiom/recovery | grep -v "\.test\.ts" | wc -l | tr -d ' ')" -eq 0; ! git grep -q "update-ref" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; ! git grep -q -E "worktree., *.(add|remove|prune)" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; ! git grep -q "DecisionEngine" -- src/main/axiom/integration; ! git grep -q "setInterval" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; grep -q "validates each strict payload according to kind" src/shared/axiom-contract/effects.test.ts; grep -q "rejects invalid continuation sequence, chain, failure class and reset" src/shared/axiom-contract/effects.test.ts; grep -q "keeps enqueue and list requests strict and validates response rows" src/shared/axiom-contract/effects.test.ts; grep -q "decodes persisted fields and validates the selected payload kind" src/main/axiom/db/effect-rows.test.ts; grep -q "reports corrupt JSON without exposing its contents" src/main/axiom/db/effect-rows.test.ts; grep -q "retains superseded identities and refuses the same Task/commit in another Attempt" src/main/axiom/db/submission-stores.test.ts; git grep -q "supersedeActiveCandidates" -- src/main/axiom/db/candidates-store.ts src/main/axiom/db/axiom-store.ts; git grep -q "registerAttemptContinuation" -- src/main/axiom/control-plane.ts; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -rq "pins the four kinds and five lifecycle states" src/main/axiom src/shared/axiom-contract; grep -rq "validates the strict integration.apply payload" src/main/axiom src/shared/axiom-contract; grep -rq "decodes a stored integration.apply effect" src/main/axiom src/shared/axiom-contract; grep -rq "merges a clean candidate without fast-forward and pins the merge commit" src/main/axiom src/shared/axiom-contract; grep -rq "records a conflict with its paths, aborts the merge and sends the Task back" src/main/axiom src/shared/axiom-contract; grep -rq "takes the head itself as the merge commit when it already contains the candidate" src/main/axiom src/shared/axiom-contract; grep -rq "ends a stale request and defers one that is not due" src/main/axiom src/shared/axiom-contract; grep -rq "applies again after an interrupted run without a second batch or a leftover worktree" src/main/axiom src/shared/axiom-contract; grep -rq "gives up after three failed tries, supersedes its batch and blocks the Task" src/main/axiom src/shared/axiom-contract; grep -rq "registers the integration executor in the Control Plane" src/main/axiom src/shared/axiom-contract; grep -rq "supersedes one active candidate without naming a successor" src/main/axiom src/shared/axiom-contract; git grep -q "integration.apply" -- src/shared/axiom-contract/effects.ts; git grep -q "integration.apply" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q -F "./integration/" -- src/main/axiom/control-plane.ts; git grep -q "refs/axiom/batches/" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q "axiom/integrating/" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'; git grep -q "IntegrationController" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test