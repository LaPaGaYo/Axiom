extra: test "$(git diff --name-only main | grep -v -E '^(src/shared/cloud-account-availability(\.test)?\.ts|src/renderer/(index|web-index)\.html|src/renderer/document-title\.test\.ts|src/renderer/src/hooks/(settings-navigation-capability-sections\.ts|[A-Za-z0-9.-]+\.test\.tsx?)|src/renderer/src/components/settings/(settings-setup-workflow-section-renderers\.tsx|[A-Za-z0-9.-]+\.test\.tsx?)|src/renderer/src/components/artifacts/(ArtifactsPageStates\.tsx|[A-Za-z0-9.-]+\.test\.tsx?)|docs/reference/orca-mapping\.md|\.axiom-work/reports/UI-HYG-[0-9]+\.md)$' | wc -l)" -eq 0; git diff --quiet main -- src/shared/product-egress-policy.ts src/renderer/src/components/settings/OrcaAccountSettingsPane.tsx src/renderer/src/components/settings/orca-account-settings-search.ts src/renderer/src/lib/settings-navigation-types.ts src/renderer/src/components/artifacts/ArtifactsPage.tsx src/renderer/src/components/OrcaSignInProgress.tsx src/renderer/src/i18n src/main src/cli mobile config package.json pnpm-lock.yaml pnpm-workspace.yaml docs/decisions tests; grep -q "export const CLOUD_ACCOUNT_AVAILABLE: boolean = PRODUCT_EGRESS_POLICY.cloudAuth !== null" src/shared/cloud-account-availability.ts; test "$(grep -l "CLOUD_ACCOUNT_AVAILABLE" src/renderer/src/hooks/settings-navigation-capability-sections.ts src/renderer/src/components/settings/settings-setup-workflow-section-renderers.tsx src/renderer/src/components/artifacts/ArtifactsPageStates.tsx | wc -l)" -eq 3; grep -q "<title>Axiom</title>" src/renderer/index.html; grep -q "<title>Axiom Web</title>" src/renderer/web-index.html; ! grep -q "<title>Orca" src/renderer/index.html src/renderer/web-index.html; test -f src/renderer/document-title.test.ts; grep -q "CLOUD_ACCOUNT_AVAILABLE" docs/reference/orca-mapping.md; ! git diff main | grep -q "^+.*@ts-nocheck"; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 226; test -f .axiom-work/reports/UI-HYG-1.md
