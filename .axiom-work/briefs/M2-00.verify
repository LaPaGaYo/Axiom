targets: config/scripts src/main/axiom src/shared/axiom-contract
extra: test "$(git diff --name-only main | grep -v -E "^(\.github/workflows/axiom-ci\.yml|config/scripts/axiom-ci-workflow-contract\.test\.mjs|docs/reference/ci-runner-efficiency\.md|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f .github/workflows/axiom-ci.yml; test -f config/scripts/axiom-ci-workflow-contract.test.mjs; test "$(git diff --name-only main -- .github | grep -v "^.github/workflows/axiom-ci.yml$" | wc -l)" -eq 0; git diff --quiet main -- src; grep -q "workflow_dispatch" .github/workflows/axiom-ci.yml; grep -q "install-node-dependencies" .github/workflows/axiom-ci.yml; grep -q "src/main/axiom" .github/workflows/axiom-ci.yml; grep -q "ORCA_BACKGROUND_LAUNCH" .github/workflows/axiom-ci.yml; grep -q "cancel-in-progress" .github/workflows/axiom-ci.yml; test "$(grep -c "pull_request" .github/workflows/axiom-ci.yml)" -eq 0; grep -q "D45" docs/reference/ci-runner-efficiency.md; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests .github | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0
