targets: src/renderer/src/components/missions src/renderer/src/lib/axiom-client.test.ts src/renderer/src/store src/shared/axiom-contract src/main/axiom src/main/runtime/rpc/methods/axiom src/renderer/src/components/settings src/renderer/src/web tests/e2e/helpers/fixture-plan-proposal.unit.test.ts
