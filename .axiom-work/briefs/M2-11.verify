targets: src/main/axiom src/shared/axiom-contract src/main/runtime/rpc/methods/axiom tests/e2e/helpers/fixture-plan-proposal.unit.test.ts src/main/ipc/pty-runtime-hidden-at-spawn-mark.test.ts
extra: test "$(git diff --name-only main | grep -v -E "^(tests/e2e/mission-exit-m2\.spec\.ts|tests/e2e/helpers/axiom-test-provider\.ts|tests/e2e/helpers/axiom-fixture-mission\.ts|tests/e2e/helpers/fixture-plan-proposal(\.unit\.test)?\.ts|tests/e2e/[a-z0-9./-]*\.ts|docs/review-evidence/axiom-m2/|docs/reference/control-plane\.md|docs/reference/orca-mapping\.md|docs/GLOSSARY\.md|src/main/ipc/pty-runtime-hidden-at-spawn-mark\.test\.ts|\.gitignore|\.axiom-work/reports/)" | wc -l)" -eq 0; test -f tests/e2e/mission-exit-m2.spec.ts; test -f docs/review-evidence/axiom-m2/M2-exit-e2e.md; grep -q "crash" tests/e2e/helpers/axiom-test-provider.ts; grep -q "stale_dispatch\|inactive_dispatch" tests/e2e/mission-exit-m2.spec.ts; grep -q "dispatch_capability_invalid" tests/e2e/mission-exit-m2.spec.ts; grep -q "duplicate" tests/e2e/mission-exit-m2.spec.ts; grep -q "retry_of_dispatch_id" tests/e2e/mission-exit-m2.spec.ts; grep -q "D58" docs/review-evidence/axiom-m2/M2-exit-e2e.md; grep -q "mission-attempt-launch.spec.ts" docs/review-evidence/axiom-m2/M2-exit-e2e.md; grep -q "M2-09-smoke-codex" docs/review-evidence/axiom-m2/M2-exit-e2e.md; grep -q "axiom.mission.plan" docs/reference/orca-mapping.md; grep -q "M2 之后" docs/reference/control-plane.md; git diff --quiet main -- src/main/axiom src/shared src/main/runtime src/cli src/renderer package.json pnpm-lock.yaml; test "$(pnpm run typecheck:e2e 2>&1 | grep -c "error TS")" -le 215; test "$(pnpm run typecheck:e2e 2>&1 | grep -c -E "mission-exit-m2\.spec\.ts|axiom-fixture-mission\.ts|axiom-test-provider\.ts")" -eq 0; test "$(git grep -l "vendor-egress-ratchet: allow" -- src tests | grep -v -E "^(tests/e2e/golden-egress-cold-start.spec.ts|tests/e2e/helpers/recording-proxy|src/shared/product-build-identity.test.ts)" | wc -l)" -eq 0; git ls-files --error-unmatch docs/review-evidence/axiom-m2/M2-exit-e2e.md; test ! -f tests/e2e/helpers/mission-exit-m2-recovery.unit.test.ts; grep -q "JOIN dispatch_contexts" tests/e2e/helpers/axiom-fixture-inspection.ts; grep -q "shell_foreground" tests/e2e/mission-exit-m2.spec.ts; grep -q "toBeNull()" tests/e2e/mission-exit-m2.spec.ts; grep -q "D59" docs/review-evidence/axiom-m2/M2-exit-e2e.md
