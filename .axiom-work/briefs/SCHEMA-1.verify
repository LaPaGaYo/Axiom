ipts .axiom-work/sidecar-union.list .axiom-work/sidecar-union.retired; git diff --quiet main -- src/main/runtime/orchestration/db/contract-constants.ts src/main/runtime/orchestration/db/schema/migrate.ts src/main/runtime/orchestration/orchestration-schema-version-skew.ts src/main/runtime/orchestration/db/schema/create-axiom-tables-sql.ts src/main/runtime/orchestration/db/schema/create-axiom-supervision-sql.ts src/main/runtime/orchestration/db/schema/axiom-tables-migration.test.ts src/main/runtime/orchestration/db/schema/schema-column-probes.ts; test "$(git diff --name-only main -- 'src/main/runtime/orchestration/db/schema/migrate*' | wc -l | tr -d ' ')" -eq 0; git grep -q "SCHEMA_VERSION = 46" -- src/main/runtime/orchestration/db/contract-constants.ts; ! test -e src/main/runtime/orchestration/db/schema/migrate-v47.ts; test "$(git diff --numstat main -- src/main/runtime/orchestration/db/orchestration-db.ts | awk '{s+=$1+$2} END {print s+0}')" -le 2; test "$(git diff main -- src/main/runtime/orchestration/db/orchestration-db.ts | grep -c -E '^-[^-]')" -eq 0; test "$(git diff --numstat main -- src/main/runtime/orchestration/db/schema/create-tables.ts | awk '{s+=$1+$2} END {print s+0}')" -le 2; test "$(git diff main -- src/main/runtime/orchestration/db/schema/create-tables.ts | grep -c -E '^\+[^+]')" -eq 0; test "$(git diff --numstat main -- src/main/runtime/orchestration/db/schema/ensure-axiom-columns.test.ts | awk '{s+=$1+$2} END {print s+0}')" -le 3; test "$(git diff --numstat main -- src/shared/wsl-move/wsl-move-storage-dispositions.ts | awk '{s+=$1+$2} END {print s+0}')" -le 8; test "$(git diff main -- src/shared/wsl-move/wsl-move-storage-dispositions.ts | grep -c -E '^-[^-]')" -eq 0; git diff --quiet main -- src/shared/wsl-move/wsl-move-dispositions.test.ts src/shared/wsl-move/wsl-move-dispositions.ts; test "$(git diff main -- src/main/runtime/orchestration/db/schema/ensure-axiom-columns.test.ts | grep -c -E '^-[^-]')" -eq 0; grep -q "adds batch_id to an existing verification_runs table at open and keeps the schema version" src/main/runtime/orchestration/db/schema/ensure-axiom-columns.test.ts; git grep -q "batch_id" -- src/main/runtime/orchestration/db/schema/create-axiom-tables-sql.ts; git grep -q "createTables.call(this" -- src/main/runtime/orchestration/db/orchestration-db.ts; git grep -q "migrate.call(this" -- src/main/runtime/orchestration/db/orchestration-db.ts; test "$(git grep -n -E "from '(\.\./)+axiom/" -- src/main/runtime/orchestration/db | wc -l | tr -d ' ')" -eq 0; test "$(git diff main -- docs/reference/control-plane.md docs/reference/orca-mapping.md | grep -c -E '^-#')" -eq 0; ! git diff main -- src | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; ! git diff main -- docs .axiom-work/reports | grep -n -E "^\+.*((ghp|gho|github_pat|xox[abp])_[A-Za-z0-9_-]{16,}|AKIA[0-9A-Z]{16})"; test "$(git diff main -- src | grep -c -E '^\+.*(@ts-nocheck|\.skip\(|[^A-Za-z]as any[^A-Za-z]|[^A-Za-z]as unknown[^A-Za-z])')" -eq 0; grep -q "## 3. 持久数据" docs/reference/control-plane.md; grep -q "## 6. 已落地迁移" docs/reference/orca-mapping.md; test "$(git branch --show-current)" = main || python3 -I .axiom-work/scripts/union-sidecar-check.py "$PWD"; grep -q "a fresh database is stamped with the Axiom schema version" src/main/runtime/orchestration/db/schema/axiom-schema-steps.test.ts; grep -q "a database written before the stamp existed is stamped without any other change" src/main/runtime/orchestration/db/schema/axiom-schema-steps.test.ts; grep -q "the baseline alone supplies every column Axiom added to existing tables" src/main/runtime/orchestration/db/schema/axiom-schema-steps.test.ts; grep -q "opening a stamped database again changes neither the row nor the schema" src/main/runtime/orchestration/db/schema/axiom-schema-steps.test.ts; grep -q "a stamp from a newer Axiom is left as it is" src/main/runtime/orchestration/db/schema/axiom-schema-steps.test.ts; grep -q "a missing stamp is repaired by running the steps again" src/main/runtime/orchestration/db/schema/axiom-schema-steps.test.ts; grep -q "a step that fails leaves no partial change and the next run succeeds" src/main/runtime/orchestration/db/schema/axiom-schema-steps.test.ts; grep -q "the stamp records the app version it is given" src/main/runtime/orchestration/db/schema/axiom-schema-steps.test.ts; git grep -q "export const AXIOM_SCHEMA_VERSION" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "export const AXIOM_UPSTREAM_SCHEMA_VERSION = 43" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "export function migrateAxiomSchema" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "export function readAxiomSchemaVersion" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "CREATE TABLE IF NOT EXISTS axiom_schema" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q -F "CHECK(id = 1)" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "upstream_version INTEGER NOT NULL" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "app_version TEXT" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "BEGIN IMMEDIATE" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "ROLLBACK" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "ADD COLUMN" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "batch_id" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "runtime_epoch" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "routing" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; git grep -q "hasAppEnvironment" -- src/main/runtime/orchestration/db/schema/axiom-schema-steps.ts; test "$(grep -c . src/main/runtime/orchestration/db/schema/axiom-schema