# Pins of earlier Tasks that a later, approved Task replaced (planner-owned; read by
# .axiom-work/scripts/union-sidecar-check.py). One line per pin, three tab-separated fields: the Task that retires
# it, the Task whose sidecar holds it first, and the assertion exactly as that sidecar has it. A retired assertion is
# not run. A line that names the wrong Task or retires nothing counts as a failed assertion, so this file never
# holds a stale entry. Lines starting with # say why and what replaced the pins that follow.

# STRUCT-1 (D93 item 1a): the hooks-off git write moved into src/main/axiom/execution/hookless-git.ts, so the
# spellings below no longer stand in the files these pins name. Replaced in STRUCT-1's sidecar by: core.hooksPath= and
# GIT_CEILING_DIRECTORIES in exactly one product file; withHooklessGit in each of the six files; "confine: true" and
# confinedGitEnv in integration-merge.ts and verification-worktree.ts; the candidate-pin triple with withHooklessGit.
STRUCT-1	M4-1a	test "$(git grep -l "refs/axiom/candidates/" -- src/main/axiom/execution ':(exclude)*.test.ts' ':(exclude)*.test-support.ts' | xargs grep -l "hooksPath" | xargs grep -l "for-each-ref" | wc -l | tr -d ' ')" -ge 1
STRUCT-1	M4-1b	git grep -q "hooksPath" -- src/main/axiom/integration ':(exclude)*.test.ts' ':(exclude)*.test-support.ts'
STRUCT-1	M4-2a-3	git grep -q "hooksPath" -- src/main/axiom/execution/integration-base.ts
STRUCT-1	M4-2a-3	git grep -q "GIT_CEILING_DIRECTORIES" -- src/main/axiom/integration/integration-merge.ts
STRUCT-1	M4-1c	git grep -q "GIT_CEILING_DIRECTORIES" -- src/main/axiom/verification/verification-worktree.ts

# STRUCT-1 (D93 item 1b): redactContext and detectSecretPatterns moved from context-builder/redaction.ts to
# src/main/axiom/redaction/redaction.ts. Replaced in STRUCT-1's sidecar by the same greps at the new path, the
# secret-patterns count at the new path, and "no file under src imports context-builder/redaction".
STRUCT-1	M3-03	grep -q "detectSecretPatterns" src/main/axiom/context-builder/redaction.ts
STRUCT-1	M3-09-4b-1	git grep -q "export function redactContext" -- src/main/axiom/context-builder/redaction.ts
STRUCT-1	M3-09-4b-1	git grep -q "export function detectSecretPatterns" -- src/main/axiom/context-builder/redaction.ts
STRUCT-1	M3-09-4b-1	test "$(git grep -l "secret-patterns" -- src/shared/axiom-contract/plan-proposal.ts src/main/axiom/context-builder/redaction.ts | wc -l | tr -d ' ')" -eq 2

# SWEEP-1 (the 调度兜底巡检 row): scheduler.ts is at the line limit, so its four exported types, ScheduleTrigger among
# them, move into src/main/axiom/scheduler/scheduler-contract.ts and are re-exported. Replaced in SWEEP-1's sidecar
# by: 'policy' and 'sweep' in scheduler-contract.ts, and scheduler.ts naming scheduler-contract.
SWEEP-1	M3-09-4c-1	git grep -q "'policy'" -- src/main/axiom/scheduler/scheduler.ts

# M4-6a (docs/plans/M4.md, the M4-6a row): the outbox gains a fifth effect kind, mission.finalize, so the test
# that pins the list of kinds lists five and its title says so. Replaced in M4-6a's sidecar by the new title in
# src/shared/axiom-contract/effects.test.ts, by mission.finalize in the contract and by the title of the
# codec's new test.
M4-6a	M4-1b	grep -rq "pins the four kinds and five lifecycle states" src/main/axiom src/shared/axiom-contract

# M4-6a (2026-11-18): twelve pins of its own sidecar say "this file differs from main". They held on the attempt
# branch - the launcher verified attempt 1 with all 123 assertions passing - and cannot hold on main once that branch
# is merged: verify-main ran them there and the push guard refused the push (19:43 MST). Such a pin describes the
# attempt, not the tree; the union script skips every diff against main for that reason. Nothing replaces them:
# which files the attempt changed is in its verification record and in the merge itself. Later sidecars do not use
# this form of pin.
M4-6a	M4-6a	! git diff --quiet main -- src/shared/axiom-contract/effects.ts
M4-6a	M4-6a	! git diff --quiet main -- src/shared/axiom-contract/mission-params.ts
M4-6a	M4-6a	! git diff --quiet main -- src/shared/axiom-contract/effects.test.ts
M4-6a	M4-6a	! git diff --quiet main -- src/main/axiom/db/effect-rows.ts
M4-6a	M4-6a	! git diff --quiet main -- src/main/axiom/read-models/mission-pending.ts
M4-6a	M4-6a	! git diff --quiet main -- src/main/axiom/scheduler/scheduler.ts
M4-6a	M4-6a	! git diff --quiet main -- src/main/axiom/scheduler/mission-sweep.ts
M4-6a	M4-6a	! git diff --quiet main -- src/main/axiom/control-plane.ts
M4-6a	M4-6a	! git diff --quiet main -- src/main/axiom/mission-controller/mission-controller.ts
M4-6a	M4-6a	! git diff --quiet main -- src/main/runtime/rpc/methods/axiom/mission.ts
M4-6a	M4-6a	! git diff --quiet main -- tests/e2e/mission-integration.spec.ts
M4-6a	M4-6a	! git diff --quiet main -- docs/reference/control-plane.md

# M4-10 (docs/plans/M4.md, the M4-10 row): the question item of the completion gate counts a question only while
# its Task is in a stage where a question blocks, as the rest of the code does, so the test with this title - a
# kernel gate on an INTEGRATED Task fails the item - goes away with what it asserted. Replaced in M4-10's sidecar by
# the titles "no_open_questions passes with an unanswered question on a settled Task" and "no_open_questions fails
# while the Mission has a blocking Approval".
M4-10	M4-6a	git grep -q -F "fails no_open_questions while a Task has a pending question" -- src/main/axiom src/shared/axiom-contract
# M4-7b registers the two methods a person decides a delivery Approval with, axiom.approval.grant and
# axiom.approval.deny. M4-7a pinned that no method name with that prefix exists yet; the pin goes away with the
# fact. Replaced in M4-7b's sidecar by pins on the two names in the handler file, the caller-class map, the
# mutation list and the generated catalog.
M4-7b	M4-7a	! git grep -q -E "axiom\.approval\.[a-z]" -- src tests

# M4-11a: the Mission page becomes the first reader of the completion report and checks the kind of the Artifact
# by name, so M4-10's pin that the text stands nowhere under src/renderer no longer holds. Replaced in M4-11a's
# sidecar by the same search over src/cli, src/preload and src/main/runtime.
M4-11a	M4-10	! git grep -q "completion_report" -- src/renderer src/cli src/preload src/main/runtime

# M3-09-4c-2a moves the policy write out of the RPC handler into the MissionController (the new module
# src/main/axiom/mission-controller/policy-update.ts), so the refusal code and the name of the audit event no
# longer stand in the handler file. Replaced in M3-09-4c-2a's sidecar by pins on the two words in the new module
# and by a pin that the handler names neither.
M3-09-4c-2a	M3-09-4c-1	git grep -q "approval_required" -- src/main/runtime/rpc/methods/axiom/policy.ts
M3-09-4c-2a	M3-09-4c-1	git grep -q "policy.updated" -- src/main/runtime/rpc/methods/axiom/policy.ts
